---
import Layout from "../layouts/Layout.astro";
import CutmapLidarViewer from "../components/CutmapLidarViewer.jsx";

// Verified Key Performance Indicators (Section 3 of WEBSITE_UPDATE_GUIDE_20261109.md)
const kpis = [
  {
    value: "~$4,439",
    label: "Low-SWaP-C Sensor & Compute BOM",
    detail: "Phase I list price (Livox Mid-360 + 2× FLIR Blackfly + Jetson AGX Orin)",
    color: "text-accent"
  },
  {
    value: "0.010–0.037 m",
    label: "Loop Closure / 100 m (No GPS)",
    detail: "17.8 mm over 178 m & 80 mm over 425 m on surveyed arboretum grates",
    color: "text-emerald-400"
  },
  {
    value: "+2.84 ± 1.46 cm",
    label: "Full-Ring DBH (n=42)",
    detail: "RMSE 3.18 cm, R² = 0.984 on ≥340° eastern white pine rings",
    color: "text-cyan-400"
  },
  {
    value: "+3.26 ± 2.53 cm",
    label: "All-View DBH (n=65)",
    detail: "RMSE 4.12 cm, R² = 0.951; +2.79 cm / 100° missing trunk arc",
    color: "text-amber-300"
  },
  {
    value: "+1.92 ± 3.44 cm",
    label: "Lidar-Gated Camera DBH",
    detail: "Single-view SAM ViT-B optical silhouette + lidar range (n=52, pooled)",
    color: "text-emerald-300"
  },
  {
    value: "87.0% / 93.1%",
    label: "ForestGEO (≥ 10 cm DBH)",
    detail: "Recall / Precision on sealed 12-cell Harvard Forest benchmark (3.26 km)",
    color: "text-accent-light"
  }
];

// Broad Capabilities Across Forestry & Beyond
const sectorCapabilities = [
  {
    title: "Commercial & Precommercial Silviculture",
    desc: "Single-tree stem mapping, two-phase basal-area double sampling, and automated thinning prescriptions for sawtimber yield and ladder-fuel removal."
  },
  {
    title: "Wildfire Fuel & Utility Corridors",
    desc: "Sub-canopy ladder-fuel density mapping and right-of-way vegetation encroachment inspection under dense cover without GNSS."
  },
  {
    title: "Urban Forestry, Orchards & Arboretums",
    desc: "Walk-speed municipal tree inventories, curated botanical collection audits, and high-value orchard or agricultural phenotyping."
  },
  {
    title: "Off-Road & Sub-Canopy Autonomy",
    desc: "A modular low-SWaP-C perception payload engineered for quick-swap deployment across backpacks, ATVs, harvesters, and unmanned rovers."
  }
];

// Measured Phase I Limitations Driving Phase II
const phase1Limitations = [
  {
    label: "Small-Stem (1–10 cm) Sapling Noise",
    detail: "+14.9 cm diameter inflation and under-detection (354 mapped/ha vs. 1,194 census/ha in HF253); driving optical silhouette fusion in Phase II."
  },
  {
    label: "Single-Sided Partial-Arc Bias",
    detail: "+2.79 cm wider diameter per 100° of missing trunk arc (−2.791 cm / 100° coverage, R² = 0.273, p = 8.2 × 10⁻⁶); requires online correction for single-pass traverses."
  },
  {
    label: "Inter-Camera Alignment & Scale Gate",
    detail: "13 mm RMS (up to 34.5 mm) camera-to-camera plane disagreement and 3-station stereo scale gate require multi-station expansion and <1 ms PTP hardware sync."
  },
  {
    label: "Residual Map-Frame Tilt",
    detail: "0.6–1.3° residual tilt on 8 of 9 Mount Auburn runs (1.9° on one) motivates continuous gravity-constrained trajectory optimization."
  }
];

// Presentations & Manuscripts
const publications = [
  {
    authors: "Garms, C.G. & Strimbu, B.M. (2026)",
    title: "CUTMAP: A Low-SWaP-C Mobile Mapping Platform for Forest Mensuration",
    venue: "2026 Joint Meeting of the Northeastern Mensurationists Organization (NEMO) & Southern Mensurationists (SOMENS)",
    status: "Presented Nov 10, 2026"
  },
  {
    authors: "Garms, C.G., Strimbu, B.M., et al. (2026)",
    title: "Calibrating a Low-SWaP-C Lidar–Stereo Platform: Staged Procedures, Failure Coupling, and Operational Validation",
    venue: "Target: Journal of Field Robotics",
    status: "In Preparation"
  },
  {
    authors: "Garms, C.G. & Strimbu, B.M. (2021)",
    title: "Impact of stem lean on estimation of Douglas-fir diameter and volume using mobile lidar scans",
    venue: "Canadian Journal of Forest Research, 51(8), 1117–1130",
    status: "Published",
    doi: "https://doi.org/10.1139/cjfr-2020-0082"
  }
];
---

<Layout 
  title="CUTMAP | Low-SWaP-C Mobile Lidar–Stereo Mapping Platform"
  description="CUTMAP: A low-SWaP-C (~$4,439 Phase I BOM) mobile lidar-stereo platform for GPS-denied forest mensuration, thinning prescriptions, and outdoor mapping. USDA-NIFA STTR Phase I (#2025-70436-44908)."
  image="/images/cutmap_cover_photo.jpg"
>

  <!-- 1. HERO & KPI STRIP -->
  <section class="relative pt-12 pb-16 overflow-hidden border-b border-border">
    <div class="absolute inset-0 bg-gradient-to-b from-forest-950 via-background to-background pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-6 relative z-10 space-y-10">

      <!-- Sponsor, Company & Award Bar -->
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-3">
          <a 
            href="https://www.spectral.com" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-white hover:bg-slate-100 px-4 py-2 rounded-xl shadow-md border border-border/40 transition-all"
            title="Visit Spectral Sciences, Inc."
          >
            <img 
              src="/images/SSI_LOGO-transparent.png" 
              alt="Spectral Sciences, Inc. Logo" 
              class="h-6 sm:h-7 w-auto object-contain" 
            />
            <span class="text-xs font-mono text-slate-800 font-bold tracking-tight border-l border-slate-300 pl-3 hidden sm:inline">
              Spectral Sciences, Inc.
            </span>
          </a>

          <a 
            href="https://forestry.oregonstate.edu" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 bg-surface hover:bg-forest-900 px-3.5 py-2 rounded-xl shadow-md border border-border/60 hover:border-[#D73F09]/60 transition-all group"
            title="Academic Partner: Dr. Bogdan M. Strimbu, Oregon State University College of Forestry"
          >
            <span class="w-6 h-6 rounded-lg bg-[#D73F09]/15 border border-[#D73F09]/40 flex items-center justify-center text-[#D73F09] font-black text-xs font-mono">
              OSU
            </span>
            <div class="flex flex-col text-left">
              <span class="text-xs font-bold text-white group-hover:text-orange-400 transition-colors leading-tight">
                College of Forestry
              </span>
              <span class="text-[10px] font-mono text-text-dim leading-tight">
                Oregon State University &bull; Dr. Bogdan M. Strimbu
              </span>
            </div>
          </a>
        </div>

        <a 
          href="https://www.nifa.usda.gov/about-nifa/award-announcements/nifa-invests-20m-spur-small-business-led-innovation"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-500/50 text-xs font-mono text-emerald-300 transition-all shadow-sm"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>USDA-NIFA STTR Phase I (#2025-70436-44908)</span>
        </a>
      </div>

      <!-- Main Headline & Core Thesis -->
      <div class="space-y-5 max-w-4xl">
        <div class="text-xs font-mono text-accent uppercase tracking-widest">
          CUTMAP &bull; Comprehensive Utility for Thinning Mechanically via Automated Prescription
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-[1.1]">
          Low-SWaP-C Mobile Lidar–Stereo Mapping for Forestry &amp; Beyond
        </h1>

        <p class="text-base sm:text-xl text-emerald-300 font-medium leading-relaxed">
          Pairing solid-state 3D lidar, 200 Hz inertial odometry, and calibrated stereo vision on embedded edge compute (~$4,439 Phase I BOM) to map GPS-denied environments at walking speed.
        </p>

        <p class="text-sm sm:text-base text-text-muted leading-relaxed">
          Developed by <strong class="text-white">Spectral Sciences, Inc.</strong> and the <strong class="text-white">Oregon State University College of Forestry</strong>, CUTMAP solves single-tree forest mensuration and automated thinning prescriptions—where decisions happen one stem at a time and commercial laser scanners carry hardware costs comparable to terrestrial laser scanners (Mattamala <em>et al.</em> 2025). Beyond timberland management, the same modular perception stack generalizes across urban forestry, orchard phenotyping, wildfire fuel mapping, and off-road autonomy.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a 
            href="#visual-showcase" 
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-accent hover:bg-accent-light text-forest-950 font-bold text-xs sm:text-sm font-mono transition-all shadow-lg cursor-pointer"
          >
            <span class="w-2 h-2 rounded-full bg-forest-950 animate-pulse"></span>
            <span>Interactive 3D Scans &amp; Video</span>
          </a>
          <a 
            href="#field-campaigns" 
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-surface hover:bg-forest-850 text-white border border-border hover:border-accent/40 font-semibold text-xs sm:text-sm font-mono transition-all"
          >
            <span>Field Benchmarks</span>
          </a>
          <a 
            href="#teaming" 
            class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-forest-900/80 hover:bg-forest-800 text-text-muted hover:text-white border border-border text-xs sm:text-sm font-mono transition-all"
          >
            <span>Phase II Teaming</span>
          </a>
        </div>
      </div>

      <!-- Verified 6-Card KPI Strip -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {kpis.map(kpi => (
          <div class="p-5 rounded-2xl bg-surface/90 border border-border hover:border-accent/40 transition-all flex flex-col justify-between">
            <div>
              <div class={`text-2xl sm:text-3xl font-black font-mono ${kpi.color} mb-1.5 tracking-tight`}>
                {kpi.value}
              </div>
              <div class="text-xs sm:text-sm font-bold text-white">
                {kpi.label}
              </div>
            </div>
            <div class="text-[11px] sm:text-xs text-text-muted mt-2 pt-2 border-t border-border/60 leading-snug">
              {kpi.detail}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 2. VISUAL SHOWCASE: INTERACTIVE 3D SCANS + PHASE I VIDEO -->
  <section id="visual-showcase" class="py-16 bg-surface/30 border-b border-border">
    <div class="max-w-5xl mx-auto px-6 space-y-12">

      <div>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
          <div>
            <div class="text-xs font-mono text-emerald-300 uppercase tracking-widest mb-1">Live WebGL Point Cloud</div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Interactive Understory Scans (Groves 1–3)</h2>
          </div>
          <p class="text-xs sm:text-sm text-text-muted max-w-md">
            Drag to orbit the eastern white pine stands mapped with Livox Mid-360 lidar-inertial odometry in Burlington, MA.
          </p>
        </div>

        <CutmapLidarViewer client:load />
      </div>

      <div>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
          <div>
            <div class="text-xs font-mono text-emerald-400 uppercase tracking-widest mb-1">Phase I Overview Video</div>
            <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">From Calibration Bench to Harvard Forest</h3>
          </div>
          <p class="text-xs sm:text-sm text-text-muted max-w-md">
            Overview of the mobile cart hardware, multi-sensor calibration, and GPS-denied understory traverses.
          </p>
        </div>

        <div class="rounded-3xl border border-border bg-black overflow-hidden shadow-2xl">
          <div class="relative aspect-[16/9] bg-black">
            <video 
              playsinline 
              controls
              preload="metadata"
              poster="/images/cutmap/cutmap_promo_poster.jpg"
              class="w-full h-full object-cover"
            >
              <source src="/videos/cutmap/cutmap_phase1_promo.mp4" type="video/mp4" />
              <p class="text-xs text-text-dim p-4">Your browser does not support HTML5 video.</p>
            </video>
          </div>

          <div class="p-4 bg-forest-950 flex flex-wrap items-center justify-between gap-3 text-xs font-mono text-text-muted">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-accent"></span>
              <span>Livox Mid-360 + Dual FLIR Blackfly &bull; Jetson AGX Orin &bull; Under-canopy traverse</span>
            </div>
            <span class="text-emerald-400 font-semibold text-[11px] uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20">Audio Enabled</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. PLATFORM ARCHITECTURE & CALIBRATION INTEGRITY -->
  <section id="architecture" class="py-16 bg-background border-b border-border">
    <div class="max-w-5xl mx-auto px-6">
      
      <div class="mb-10 max-w-3xl">
        <div class="text-xs font-mono text-accent uppercase tracking-widest mb-1">System Architecture</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Low-SWaP-C Hardware, Lidar–Inertial Odometry &amp; Scale Integrity
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-surface border border-border flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono text-accent font-bold uppercase tracking-wider mb-2">01 &bull; Edge Payload</div>
            <h3 class="text-lg font-bold text-white mb-3">~$4,439 Phase I Prototype</h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
              Integrates a <strong class="text-white">Livox Mid-360</strong> solid-state 3D lidar (200k pts/s) with 200 Hz IMU, two <strong class="text-white">FLIR Blackfly (<code>BFLY-U3-13S2C</code>)</strong> global-shutter cameras on a 457.2 mm baseline, Garmin GLO 2 GNSS logger, and an <strong class="text-white">NVIDIA Jetson AGX Orin</strong> (12 cores, 32 GB RAM, 275 TOPS, ROS 2 Humble in MAXN mode), logging 63 field bags at <strong class="text-white">28.96 MB/s (104 GB/h)</strong>.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-border/60 text-[11px] font-mono text-text-dim">
            $2,440 sensors/battery + $1,999 Jetson Dev Kit ($6,297 at Nov 2026 replacement prices)
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-surface border border-border flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono text-amber-300 font-bold uppercase tracking-wider mb-2">02 &bull; Odometry Pivot</div>
            <h3 class="text-lg font-bold text-white mb-3">FAST-LIO2 + Gravity Levelling</h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
              Spring 2026 trials proved passive VO inadequate under foliage (stereo VO collapsed at <strong class="text-white">0.00 m tracked</strong>; monocular VO drifted <strong class="text-white">23–98%</strong>; 15-state EKF unstable). Pivoting to <strong class="text-white"><code>FAST-LIO2</code></strong> with stationary accelerometer gravity levelling flattened Grove A ground spread (<strong class="text-white">0.52 m &rarr; 0.05 m</strong>), reduced a 7.23 m loop tilt swing to 2.6 m, and achieved <strong class="text-white">0.010–0.037 m/100 m</strong> marked-loop closure.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-border/60 text-[11px] font-mono text-text-dim">
            Cameras retained for semantic segmentation &amp; SAM ViT-B silhouette mensuration
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-surface border border-accent/40 flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono text-emerald-400 font-bold uppercase tracking-wider mb-2">03 &bull; Calibration Gate</div>
            <h3 class="text-lg font-bold text-white mb-3">Unmasking Failure Coupling</h3>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
              A <strong class="text-white">2.50 mm target curl over 320 mm</strong> biased focal length 4.6% low and induced a <strong class="text-white">133 mm lateral / ~140 mm fore-aft</strong> extrinsic shift despite &lt;1 px camera residuals. A rigid flat backing restored baseline concordance (<strong class="text-white">454.20 mm vs. 457.2 mm, 0.66%</strong>), while an external laser scale gate (<strong class="text-white">0.9964</strong> lidar slope; <strong class="text-white">0.9836</strong> stereo slope) and <code>count^2.0</code> plane weighting cut centering error from <strong class="text-white">40.9 mm to 6.6 mm</strong>.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-border/60 text-[11px] font-mono text-text-dim">
            0.309 px stereo RMS &bull; 5-station lidar gate (2–6 m) &amp; 3-station stereo gate (2–4 m)
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 4. THREE FIELD CAMPAIGNS ACROSS DISTINCT ENVIRONMENTS -->
  <section id="field-campaigns" class="py-16 bg-surface/30 border-b border-border">
    <div class="max-w-5xl mx-auto px-6 space-y-10">
      
      <div class="max-w-3xl">
        <div class="text-xs font-mono text-accent uppercase tracking-widest mb-1">Operational Validation</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Three Field Campaigns Across Managed, Urban &amp; Natural Forests
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-surface border border-border space-y-3">
          <div class="text-xs font-mono text-cyan-400 font-bold uppercase tracking-wider">Campaign 1 &bull; Burlington, MA</div>
          <h3 class="text-lg font-bold text-white">65 Taped White Pine Stems</h3>
          <ul class="space-y-2 text-xs sm:text-sm text-text-muted leading-relaxed">
            <li><strong class="text-white">Full rings (&ge;340&deg;, n=42):</strong> <code>+2.84 &plusmn; 1.46 cm</code> (RMSE 3.18 cm, <code>R&sup2; = 0.9836</code>) due to outer-bark/lichen returns.</li>
            <li><strong class="text-white">All 65 stems:</strong> <code>+3.26 &plusmn; 2.53 cm</code> (RMSE 4.12 cm, <code>R&sup2; = 0.951</code>), with a partial-arc slope of <strong class="text-white">+2.79 cm per 100&deg;</strong> of missing trunk arc.</li>
            <li><strong class="text-white">Lidar-gated camera DBH (n=52):</strong> <code>+1.92 &plusmn; 3.44 cm</code> pooled across both cameras via <code>SAM ViT-B</code>, bypassing single-view arc inflation.</li>
          </ul>
        </div>

        <div class="p-6 rounded-2xl bg-surface border border-border space-y-3">
          <div class="text-xs font-mono text-emerald-400 font-bold uppercase tracking-wider">Campaign 2 &bull; Cambridge, MA</div>
          <h3 class="text-lg font-bold text-white">Mount Auburn Arboretum</h3>
          <ul class="space-y-2 text-xs sm:text-sm text-text-muted leading-relaxed">
            <li><strong class="text-white">Scale:</strong> 9 mobile scans totaling <strong class="text-white">2,638 m walked (44.6 min)</strong>, mapping <strong class="text-white">12.0 ha (29.7 acres)</strong> and observing 62% (308/493) of curated living tree records within 15 m.</li>
            <li><strong class="text-white">Grate loop closures:</strong> <strong class="text-white">17.8 mm over 178 m</strong> (0.010 m/100m, Hazel Dell) and <strong class="text-white">80.0 mm over 425 m</strong> (0.019 m/100m, Halcyon Lake).</li>
            <li><strong class="text-white">60 held-out stems:</strong> <strong class="text-white">5.37 cm</strong> median absolute error (6.79 cm RMSE excluding 3 extreme co-dominant/flared specimens; 11.38 cm overall).</li>
          </ul>
        </div>

        <div class="p-6 rounded-2xl bg-surface border border-accent/40 space-y-3">
          <div class="text-xs font-mono text-accent font-bold uppercase tracking-wider">Campaign 3 &bull; Petersham, MA</div>
          <h3 class="text-lg font-bold text-white">Harvard Forest ForestGEO (HF253)</h3>
          <ul class="space-y-2 text-xs sm:text-sm text-text-muted leading-relaxed">
            <li><strong class="text-white">Trail benchmark:</strong> 17 walks, <strong class="text-white">3,264 m</strong> (65 min, 779M points, 4.39 ha); <strong class="text-white">87.0% recall / 93.1% precision</strong> on stems &ge;10 cm DBH (72.0% / 86.2% all stems).</li>
            <li><strong class="text-white">Size-dependent bias:</strong> <strong class="text-white">+0.2 cm</strong> (&ge;40 cm), +2.4 cm (20–40 cm), +4.8 cm (10–20 cm), +14.9 cm (1–10 cm saplings).</li>
            <li><strong class="text-white">Two-phase double sampling:</strong> 441 lidar cells + 40 reference cells recovered stand basal area at <strong class="text-white">45.98 [40.19, 52.30] m&sup2;/ha</strong> vs. <strong class="text-white">47.44 m&sup2;/ha</strong> census truth (correcting raw 74.34 m&sup2;/ha).</li>
          </ul>
        </div>
      </div>

      <!-- Verified Figures -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <figure class="rounded-2xl bg-surface border border-border overflow-hidden flex flex-col justify-between">
          <div class="p-3 bg-black/40">
            <img 
              src="/images/cutmap/fig_multi_stand_stem_maps.png" 
              alt="Top-down SLAM trajectories and breast-height stem slices across the three Burlington eastern white pine groves" 
              class="w-full h-auto rounded-lg object-contain"
              loading="lazy"
            />
          </div>
          <figcaption class="p-4 text-xs text-text-muted border-t border-border/60 leading-relaxed">
            <strong class="text-white font-mono">Burlington White Pine Groves 1–3:</strong> Top-down <code>FAST-LIO2</code> trajectories and gravity-levelled breast-height (<code>z = 1.37 m</code>) stem maps across 65 taped stems.
          </figcaption>
        </figure>

        <figure class="rounded-2xl bg-surface border border-border overflow-hidden flex flex-col justify-between">
          <div class="p-3 bg-black/40">
            <img 
              src="/images/cutmap/fig7_multi_stand_validation.png" 
              alt="Validation across 65 taped eastern white pine stems showing full-ring and partial-arc coverage dependence" 
              class="w-full h-auto rounded-lg object-contain"
              loading="lazy"
            />
          </div>
          <figcaption class="p-4 text-xs text-text-muted border-t border-border/60 leading-relaxed">
            <strong class="text-white font-mono">65-Stem Tape Validation:</strong> Full-ring stems (&ge;340&deg;, <code>n=42</code>) achieve <code>+2.84 &plusmn; 1.46 cm</code> (<code>R&sup2; = 0.9836</code>); all 65 stems achieve <code>+3.26 &plusmn; 2.53 cm</code> (<code>R&sup2; = 0.951</code>) with a <code>+2.79 cm / 100&deg;</code> partial-arc slope.
          </figcaption>
        </figure>
      </div>

    </div>
  </section>

  <!-- 5. BROAD CAPABILITIES, PHASE I LIMITS & PHASE II HORIZON -->
  <section id="capabilities-roadmap" class="py-16 bg-background border-b border-border">
    <div class="max-w-5xl mx-auto px-6 space-y-12">
      
      <div>
        <div class="mb-8 max-w-3xl">
          <div class="text-xs font-mono text-accent uppercase tracking-widest mb-1">Platform Versatility</div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            Capabilities Across Forestry &amp; Adjacent Sectors
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {sectorCapabilities.map(cap => (
            <div class="p-5 rounded-2xl bg-surface border border-border hover:border-accent/40 transition-all">
              <h3 class="text-sm sm:text-base font-bold text-white mb-2">{cap.title}</h3>
              <p class="text-xs text-text-muted leading-relaxed">{cap.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Honest Phase I Limits -->
        <div class="p-6 sm:p-8 rounded-2xl bg-surface border border-border space-y-4">
          <div class="text-xs font-mono text-amber-300 uppercase tracking-widest font-bold">
            Measured Phase I Limitations
          </div>
          <h3 class="text-xl font-bold text-white">Engineering Gaps Driving Phase II</h3>
          <ul class="space-y-3 text-xs sm:text-sm text-text-muted leading-relaxed">
            {phase1Limitations.map(lim => (
              <li>
                <strong class="text-white">{lim.label}:</strong> {lim.detail}
              </li>
            ))}
          </ul>
        </div>

        <!-- Phase II Horizon (Approved D5 Framing) -->
        <div class="p-6 sm:p-8 rounded-2xl bg-forest-950 border border-accent/50 flex flex-col justify-between space-y-5">
          <div class="space-y-4">
            <div class="text-xs font-mono text-accent uppercase tracking-widest font-bold">
              Phase II Development Horizon
            </div>
            <blockquote class="text-base sm:text-lg text-white font-medium leading-relaxed border-l-4 border-accent pl-4">
              "In Phase II, we are working toward near real-time mensuration and automated thinning prescriptions on embedded edge compute, and evaluating modular deployment configurations across backpack, ATV, and harvesting machinery."
            </blockquote>
            <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
              Spectral Sciences and Oregon State University are advancing toward a 4-camera hardware-synchronized optical array, an NDAA-compliant 3D lidar, and OSU MARS Lab heuristic tree-selection and <code>SEEM</code> growth-and-yield models across modular <strong class="text-white">backpack</strong>, <strong class="text-white">ATV</strong>, and <strong class="text-white">harvester cab/boom</strong> mounts sharing one quick-swap edge computer.
            </p>
          </div>
          <div class="text-[11px] font-mono text-text-dim pt-3 border-t border-border/60">
            Resolves small-stem (1–10 cm) correlation (&rho; &approx; 0.37 in HF253) via optical silhouette fusion
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 6. PRESENTATIONS, PUBLICATIONS & PHASE II TEAMING -->
  <section id="teaming" class="py-16 bg-forest-950">
    <div class="max-w-5xl mx-auto px-6 space-y-12">

      <!-- Publications & Presentations -->
      <div>
        <div class="mb-6">
          <div class="text-xs font-mono text-accent uppercase tracking-widest mb-1">Scholarly Output</div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Presentations &amp; Manuscripts</h2>
        </div>

        <div class="space-y-3">
          {publications.map(pub => (
            <div class="p-4 sm:p-5 rounded-xl bg-surface border border-border flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="space-y-1">
                <div class="text-xs font-mono text-text-muted">{pub.authors}</div>
                <div class="text-sm sm:text-base font-bold text-white">{pub.title}</div>
                <div class="text-xs italic text-text-dim">{pub.venue}</div>
              </div>
              <div class="flex items-center gap-3 shrink-0">
                <span class="text-xs font-mono px-2.5 py-1 rounded-full bg-forest-900 border border-border text-text-muted">
                  {pub.status}
                </span>
                {pub.doi && (
                  <a 
                    href={pub.doi} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="text-xs font-mono text-accent hover:underline"
                  >
                    Paper &rarr;
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Direct Teaming Contact Banner -->
      <div class="p-6 sm:p-8 rounded-2xl bg-surface border border-accent/40 shadow-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div class="space-y-1.5">
          <div class="text-xs font-mono text-accent uppercase tracking-wider font-bold">Phase II Partnerships &amp; Field Pilots</div>
          <h3 class="text-lg sm:text-xl font-bold text-white">Team With Spectral Sciences &amp; Oregon State University</h3>
          <p class="text-xs sm:text-sm text-text-muted max-w-xl">
            Open to timberland managers, forestry machinery OEMs, agricultural/urban mapping partners, and federal co-funding collaborators. Connect with Project Director Dr. Cory G. Garms and Co-PD Dr. Bogdan M. Strimbu.
          </p>
        </div>
        <a 
          href="mailto:cgarms@spectral.com?subject=CUTMAP%20Phase%20II%20Teaming%20Inquiry"
          class="px-6 py-3.5 rounded-xl bg-accent hover:bg-accent-light text-forest-950 font-bold text-xs sm:text-sm font-mono transition-all shadow-md whitespace-nowrap shrink-0 cursor-pointer"
        >
          cgarms@spectral.com &rarr;
        </a>
      </div>

      <!-- Footer -->
      <div class="text-center text-xs font-mono text-text-dim leading-relaxed pt-2 border-t border-border/60">
        Funded by <strong class="text-white">USDA-NIFA STTR Phase I Award No. 2025-70436-44908</strong> (Topic 8.1 <em>Forest and Related Resources</em>) &bull; Academic Partner: <a href="https://forestry.oregonstate.edu" target="_blank" rel="noopener noreferrer" class="text-white hover:text-orange-400 underline transition-colors">Oregon State University College of Forestry</a> &bull; &copy; 2026 <a href="https://www.spectral.com" target="_blank" rel="noopener noreferrer" class="text-white hover:text-accent underline transition-colors">Spectral Sciences, Inc.</a>
      </div>

    </div>
  </section>

</Layout>
