<script define:vars={{ figureGallery, pipelineStages }}>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Interactive Scientific Figure Explorer Controller
    const tabBtns = document.querySelectorAll('.fig-tab-btn');
    const figImg = document.getElementById('active-fig-img');
    const figTelemetry = document.getElementById('active-fig-telemetry');
    const figCaption = document.getElementById('active-fig-caption');
    const figBadge = document.getElementById('active-fig-badge');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-fig-index') || '0', 10);
        const data = figureGallery[idx];
        if (!data) return;

        // Reset tab styles
        tabBtns.forEach(b => {
          b.classList.remove('bg-accent/15', 'text-accent', 'border-accent/40', 'font-bold');
          b.classList.add('text-text-muted', 'border-transparent');
        });

        // Activate clicked tab
        btn.classList.add('bg-accent/15', 'text-accent', 'border-accent/40', 'font-bold');
        btn.classList.remove('text-text-muted', 'border-transparent');

        // Animate image switch
        if (figImg) {
          figImg.style.opacity = '0';
          setTimeout(() => {
            figImg.src = data.imgSrc;
            figImg.alt = data.alt;
            figImg.style.opacity = '1';
          }, 150);
        }

        if (figTelemetry) figTelemetry.textContent = data.telemetry;
        if (figCaption) figCaption.textContent = data.caption;
        if (figBadge) figBadge.textContent = data.badge;
      });
    });

    // 2. Interactive Pipeline Architecture Stepper
    const stageCards = document.querySelectorAll('.pipe-stage-card');
    const detailSensors = document.getElementById('pipe-detail-sensors');
    const detailSummary = document.getElementById('pipe-detail-summary');
    const detailMetric = document.getElementById('pipe-detail-metric');
    const detailLabel = document.getElementById('pipe-detail-label');

    stageCards.forEach(card => {
      card.addEventListener('click', () => {
        const idx = parseInt(card.getAttribute('data-stage-idx') || '0', 10);
        const stage = pipelineStages[idx];
        if (!stage) return;

        stageCards.forEach(c => {
          c.classList.remove('border-accent', 'shadow-lg', 'shadow-accent/5');
          c.classList.add('border-border');
        });

        card.classList.add('border-accent', 'shadow-lg', 'shadow-accent/5');
        card.classList.remove('border-border');

        if (detailSensors) detailSensors.textContent = stage.sensors;
        if (detailSummary) detailSummary.textContent = stage.summary;
        if (detailMetric) detailMetric.textContent = stage.outputMetric;
        if (detailLabel) detailLabel.textContent = stage.outputLabel;
      });
    });
  });
</script>
