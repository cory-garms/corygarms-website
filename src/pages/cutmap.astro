---
import Layout from "../layouts/Layout.astro";
import CutmapLidarViewer from "../components/CutmapLidarViewer.jsx";
import CutmapPipelineDiagram from "../components/CutmapPipelineDiagram.astro";

// Publication references with full BibTeX and DOIs
const publications = [
  {
    id: "cutmap-calibration-2026",
    authors: "Garms, C.G., Strimbu, B., et al. (2026)",
    title: "Calibrating a Low-SWaP-C Lidar–Stereo Platform: Staged Procedures, Failure Coupling, and Operational Validation",
    venue: "Target: Journal of Field Robotics (In Final Preparation)",
    tag: "Primary Methodological Paper",
    status: "In Final Preparation",
    takeaway: "Exposes how standard scale-invariant reprojection metrics (0.31 px RMS) remain blind to 2.5 mm target curvature, propagating into 140 mm phantom extrinsic shifts. Introduces three physical calibration gates that condition the weak axis and restore sub-millimeter precision.",
    bibtex: `@article{garms2026cutmap_calibration,
  title={Calibrating a Low-SWaP-C Lidar--Stereo Platform: Staged Procedures, Failure Coupling, and Operational Validation},
  author={Garms, Cory G. and Strimbu, Bogdan M. and others},
  journal={Journal of Field Robotics},
  year={2026},
  note={In Final Preparation}
}`
  },
  {
    id: "cutmap-nemo-2026",
    authors: "Garms, C.G., Strimbu, B., Zamora, D., et al. (2026)",
    title: "CUTMAP: A Low-SWaP-C Mobile Mapping Platform for Forest Mensuration: Calibration Integrity, Sensor Fusion, and Ground-Truth Prototyping",
    venue: "2026 Joint Meeting of the Northeastern Mensurationist Organization (NEMO) & Southern Mensurationists (SOMENS), Portland, ME",
    tag: "Conference Proceeding",
    status: "Accepted / Invited",
    takeaway: "Presents the field-deployed all-terrain push-cart, FAST-LIO2 understory loop trajectories, and empirical validation against 65 taped stems across white pine and hardwood groves in Burlington, MA.",
    bibtex: `@inproceedings{garms2026cutmap_nemo,
  title={CUTMAP: A Low-SWaP-C Mobile Mapping Platform for Forest Mensuration: Calibration Integrity, Sensor Fusion, and Ground-Truth Prototyping},
  author={Garms, Cory G. and Strimbu, Bogdan M. and Zamora, Diomy and others},
  booktitle={2026 Joint Meeting of the Northeastern Mensurationist Organization (NEMO) and Southern Mensurationists (SOMENS)},
  address={Portland, ME},
  year={2026}
}`
  },
  {
    id: "west-thinning-2021",
    authors: "West, T., Sessions, J., & Strimbu, B.M. (2021)",
    title: "Heuristic Optimization of Thinning Individual Douglas-Fir",
    venue: "Forests, 12(3), 280",
    tag: "Foundational Thinning Algorithm",
    status: "Published (Peer-Reviewed)",
    doi: "https://doi.org/10.3390/f12030280",
    takeaway: "Establishes the combinatorial 'Hero' and Monte Carlo heuristic optimization models integrated into CUTMAP Stage 3. Evaluates thinning interventions based on spatial competition indices, increasing Land Expectation Value (LEV) by +5.1% to 10.1%.",
    bibtex: `@article{west2021heuristic_thinning,
  title={Heuristic Optimization of Thinning Individual Douglas-Fir},
  author={West, Todd and Sessions, John and Strimbu, Bogdan M.},
  journal={Forests},
  volume={12},
  number={3},
  pages={280},
  year={2021},
  publisher={MDPI},
  doi={10.3390/f12030280}
}`
  },
  {
    id: "garms-stemlean-2021",
    authors: "Garms, C.G. & Strimbu, B. (2021)",
    title: "Impact of stem lean on estimation of Douglas-fir diameter and volume using mobile lidar scans",
    venue: "Canadian Journal of Forest Research, 51(8), 1184–1195",
    tag: "Foundational Lean Research",
    status: "Published (Peer-Reviewed)",
    doi: "https://doi.org/10.1139/cjfr-2020-0082",
    takeaway: "Formulates the 3D stem vectoring and non-destructive cylinder fitting models embedded in CUTMAP Stage 2. Demonstrates that accounting for 3D trunk lean and sweep eliminates systemic underestimation in merchantable volume calculations.",
    bibtex: `@article{garms2021stemlean,
  title={Impact of stem lean on estimation of Douglas-fir diameter and volume using mobile lidar scans},
  author={Garms, Cory G. and Strimbu, Bogdan M.},
  journal={Canadian Journal of Forest Research},
  volume={51},
  number={8},
  pages={1184--1195},
  year={2021},
  publisher={NRC Research Press},
  doi={10.1139/cjfr-2020-0082}
}`
  },
  {
    id: "garms-sensors-2020",
    authors: "Garms, C.G., et al. (2020)",
    title: "Assessing lean and positional error of individual mature Douglas-fir using active and passive sensors",
    venue: "Remote Sensing, 12(14), 2278",
    tag: "Foundational Sensor Fusion",
    status: "Published (Peer-Reviewed)",
    doi: "https://doi.org/10.3390/rs12142278",
    takeaway: "Compares active spatial LiDAR scans with high-resolution passive optical imagery, proving that multi-sensor triangulation isolates tree curvature and positional drift under dense canopy.",
    bibtex: `@article{garms2020lean_sensors,
  title={Assessing lean and positional error of individual mature Douglas-fir using active and passive sensors},
  author={Garms, Cory G. and others},
  journal={Remote Sensing},
  volume={12},
  number={14},
  pages={2278},
  year={2020},
  publisher={MDPI},
  doi={10.3390/rs12142278}
}`
  }
];

// KPI Metrics Grid
const kpis = [
  {
    value: "~$2,200",
    label: "Core Payload Cost",
    baseline: "≥ $50,000 commercial MLS",
    delta: "25× cost reduction",
    deltaColor: "text-accent"
  },
  {
    value: "65 Stems",
    label: "Field Ground Truth",
    baseline: "3 Wooded Groves (Burlington, MA)",
    delta: "Logger's-tape calibrated",
    deltaColor: "text-accent-light"
  },
  {
    value: "+2.83 cm",
    subVal: "± 1.45 cm",
    label: "360° Ring DBH Accuracy",
    baseline: "R² = 0.9833, RMSE 3.18 cm",
    delta: "Bark furrow envelope (n=43)",
    deltaColor: "text-topo"
  },
  {
    value: "+1.60 cm",
    subVal: "± 2.78 cm",
    label: "Single-View Camera DBH",
    baseline: "MAE = 2.58 cm (n=9 stations)",
    delta: "Zero walkaround required",
    deltaColor: "text-spectral"
  },
  {
    value: "1.0098",
    subVal: "± 0.0137",
    label: "SLAM Metric Scale Rigidity",
    baseline: "82–97 m understory loops",
    delta: "<1% scale dilation (No GPS)",
    deltaColor: "text-accent"
  },
  {
    value: "0.87 mm",
    label: "Extrinsic Vertical Precision",
    baseline: "One-sided pitch was 3.48 mm",
    delta: "2.7× weak-axis resolution",
    deltaColor: "text-accent-light"
  }
];

// Hardware Payload Specifications
const hardwareSpecs = [
  {
    component: "Livox Mid-360S LiDAR",
    spec: "Solid-state non-repetitive circular rosette, 200,000 pts/sec, 360° × 59° FOV",
    role: "Primary spatial geometry & understory traverse SLAM",
    cost: "~$700",
    powerWeight: "8.5 W • 265 g"
  },
  {
    component: "Dual FLIR Blackfly S",
    spec: "1.3 MP global shutter (1280 × 1024), 457.2 mm (18.0 in) calibrated baseline",
    role: "Optical silhouette segmentation & visual edge mensuration",
    cost: "~$1,100 (pair)",
    powerWeight: "6.0 W • 180 g (pair)"
  },
  {
    component: "Industrial 6-DOF IMU",
    spec: "200 Hz sampling rate, hardware-synchronized to LiDAR clock",
    role: "Inertial pre-integration for FAST-LIO2 state prediction",
    cost: "Embedded",
    powerWeight: "Integrated in Mid-360"
  },
  {
    component: "NVIDIA Jetson AGX Orin",
    spec: "32 GB 256-bit LPDDR5, 200 TOPS AI compute, native ROS 2 Humble",
    role: "Real-time SLAM odometry, camera logging & edge AI",
    cost: "Host Compute",
    powerWeight: "15–40 W • 650 g"
  },
  {
    component: "All-Terrain Chassis",
    spec: "High-clearance pneumatic wheels, rear-looking optics mount",
    role: "Pedestrian mobility traversing fallen logs and heavy duff",
    cost: "Chassis",
    powerWeight: "4.8 kg Total Payload"
  }
];
---

<Layout title="CUTMAP: Autonomous Forest Mensuration | Dr. Cory Glenn Garms">
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    
    <!-- Top Breadcrumbs / Navigation -->
    <nav aria-label="Breadcrumbs" class="mb-8 flex items-center justify-between">
      <a 
        href="/#portfolio" 
        class="inline-flex items-center gap-2 text-xs font-mono text-text-muted hover:text-accent transition-colors group"
      >
        <span class="group-hover:-translate-x-0.5 transition-transform">&larr;</span>
        <span>Back to Projects &amp; Portfolio</span>
      </a>
      <div class="flex items-center gap-2 text-[11px] font-mono text-text-dim">
        <span>PROJECT DOSSIER</span>
        <span>/</span>
        <span class="text-accent-light">CUTMAP</span>
      </div>
    </nav>

    <!-- SECTION: HERO & KPIS -->
    <section class="mb-16 md:mb-20">
      
      <!-- Eyebrow Tags & Metadata -->
      <div class="flex flex-wrap items-center gap-2.5 mb-5">
        <span class="px-2.5 py-1 rounded bg-forest-900 border border-accent/40 text-accent text-[11px] font-mono font-medium tracking-wide flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          USDA SBIR/STTR Phase I &amp; II
        </span>
        <span class="px-2.5 py-1 rounded bg-forest-900 border border-border text-text-muted text-[11px] font-mono">
          Proprietary Technology
        </span>
        <span class="px-2.5 py-1 rounded bg-forest-900 border border-border text-text-muted text-[11px] font-mono">
          Spectral Sciences, Inc.
        </span>
      </div>

      <!-- Main Heading & Subtitle -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.1] mb-5">
        CUTMAP: Autonomous Under-Canopy Forest Mensuration
      </h1>
      <p class="text-lg sm:text-xl md:text-2xl font-semibold text-accent-light max-w-4xl leading-snug mb-6">
        Sub-Centimeter Metric Precision from a $2,200 Mobile Sensor Payload
      </p>

      <!-- Institutional Attribution Bar -->
      <div class="p-4 rounded-xl bg-surface border border-border mb-8 grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-mono">
        <div>
          <span class="text-text-dim block uppercase text-[10px] tracking-wider mb-0.5">Principal Investigator &amp; Lead Scientist</span>
          <span class="text-text-main font-semibold">Dr. Cory Glenn Garms</span>
          <span class="text-text-muted block text-[11px]">Senior Scientist, Spectral Sciences, Inc.</span>
        </div>
        <div>
          <span class="text-text-dim block uppercase text-[10px] tracking-wider mb-0.5">Academic Co-Investigator</span>
          <span class="text-text-main font-semibold">Dr. Bogdan Strimbu</span>
          <span class="text-text-muted block text-[11px]">Associate Professor, Oregon State University</span>
        </div>
        <div>
          <span class="text-text-dim block uppercase text-[10px] tracking-wider mb-0.5">Agency Sponsor &amp; Program Director</span>
          <span class="text-text-main font-semibold">Dr. Diomy Zamora</span>
          <span class="text-text-muted block text-[11px]">USDA Forest Service</span>
        </div>
      </div>

      <!-- Executive Lead Narrative -->
      <div class="prose prose-invert max-w-none text-text-muted text-sm sm:text-base leading-relaxed mb-10">
        <p>
          Commercial mobile laser scanning (MLS) platforms for forestry applications routinely cost upwards of $50,000 to $100,000+, creating a prohibitive capital barrier that restricts operational adoption in silviculture, inventory mensuration, and ecological monitoring. <strong class="text-white">CUTMAP</strong> (<em>Continuous Under-Canopy Traverse and Mapping</em>) bridges the divide between low-cost robotics hardware and survey-grade forestry biometrics.
        </p>
        <p class="mt-3">
          Engineered by <strong class="text-white">Spectral Sciences, Inc.</strong> under USDA SBIR/STTR support, CUTMAP couples a low-cost solid-state LiDAR with calibrated global-shutter stereo cameras on a mobile push-cart. The system achieves automated individual-tree diameter at breast height (DBH) mensuration, enforces multi-sensor calibration integrity, and maintains metric SLAM scale rigidity without GPS in dense understory conditions.
        </p>
      </div>

      <!-- KPI Metric Counter Grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
        {kpis.map((kpi) => (
          <div class="p-4 rounded-xl bg-surface border border-border hover:border-accent/40 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <span class="text-[10px] font-mono text-text-dim uppercase tracking-wider block mb-1">
                {kpi.label}
              </span>
              <div class="text-xl sm:text-2xl font-bold font-mono text-white group-hover:text-accent transition-colors flex items-baseline gap-1">
                <span>{kpi.value}</span>
                {kpi.subVal && <span class="text-xs text-text-muted font-normal">{kpi.subVal}</span>}
              </div>
            </div>
            <div class="pt-3 mt-3 border-t border-border/60">
              <span class={`text-[10px] font-mono block font-medium ${kpi.deltaColor}`}>
                {kpi.delta}
              </span>
              <span class="text-[10px] font-mono text-text-dim block mt-0.5 truncate" title={kpi.baseline}>
                {kpi.baseline}
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 01: INTERACTIVE 3D UNDERSTORY LIDAR VIEWER -->
    <section class="mb-20 md:mb-28">
      <div class="flex items-center gap-3 mb-2">
        <span class="h-px flex-1 bg-border"></span>
        <span class="text-xs font-mono text-accent uppercase tracking-widest px-2">Interactive 3D Point Cloud</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <div class="text-center max-w-3xl mx-auto mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-2">
          Interactive Understory LiDAR Viewer
        </h2>
        <p class="text-xs sm:text-sm text-text-muted">
          Actual FAST-LIO2 SLAM forest survey data collected by the CUTMAP rig at 200,000 pts/sec. Rendered with custom elevation GLSL shaders.
        </p>
      </div>

      <!-- React Three Fiber Point Cloud Canvas -->
      <div class="mb-4">
        <CutmapLidarViewer client:load />
      </div>

      <!-- Interactive Stand Guide -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-mono">
        <div class="p-4 rounded-xl bg-surface border border-border">
          <div class="text-accent font-semibold mb-1 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            Stand 1: White Pine Grove
          </div>
          <p class="text-text-muted text-[11px] leading-relaxed">
            Towering mature <em>Pinus strobus</em> with high crown base. Clean ground-duff surface and vertical trunks ideal for circular RANSAC slice fitting.
          </p>
        </div>
        <div class="p-4 rounded-xl bg-surface border border-border">
          <div class="text-accent font-semibold mb-1 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            Stand 2: Deciduous Grove
          </div>
          <p class="text-text-muted text-[11px] leading-relaxed">
            Mixed northern hardwoods with lateral trunk lean and multi-stem forks. Tests the 3D stem vectoring and taper algorithms from Garms &amp; Strimbu (2021).
          </p>
        </div>
        <div class="p-4 rounded-xl bg-surface border border-border">
          <div class="text-accent font-semibold mb-1 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            Stand 3: Dense Understory Loop
          </div>
          <p class="text-text-muted text-[11px] leading-relaxed">
            High shrub and sapling occlusion. Demonstrates FAST-LIO2 metric scale rigidity (1.0098) through complex pedestrian obstacle avoidance maneuvers.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 02: HARDWARE PLATFORM & SWAP-C OPTIMIZATION -->
    <section class="mb-20 md:mb-28">
      <div class="flex items-center gap-3 mb-2">
        <span class="h-px flex-1 bg-border"></span>
        <span class="text-xs font-mono text-accent uppercase tracking-widest px-2">Section 01 // Hardware Rig</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      
      <div class="text-center max-w-3xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-2">
          Ruggedized Low-SWaP-C Sensor Architecture
        </h2>
        <p class="text-xs sm:text-sm text-text-muted">
          Optimizing Size, Weight, Power, and Cost (SWaP-C) for continuous pedestrian understory traverses.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-10">
        
        <!-- Left: Hardware Photo Showcase -->
        <div class="lg:col-span-5 space-y-4">
          <div class="rounded-2xl border border-border overflow-hidden bg-forest-950 p-2 shadow-2xl">
            <div 
              class="relative group cursor-pointer overflow-hidden rounded-xl lightbox-trigger" 
              data-src="/images/STTR_device.jpg" 
              data-caption="CUTMAP mobile sensor apparatus deployed during field validation in Burlington, MA. Integrates Livox Mid-360S LiDAR, dual FLIR Blackfly S stereo cameras, and Jetson Orin edge computing." 
              data-title="CUTMAP Field Mobile Sensor Apparatus"
            >
              <img 
                src="/images/STTR_device.jpg" 
                alt="CUTMAP Mobile Sensor Rig" 
                class="w-full h-auto object-cover rounded-lg group-hover:scale-[1.02] transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                <span class="px-3 py-1.5 rounded-md bg-forest-950/90 border border-accent/50 text-accent text-xs font-mono flex items-center gap-1.5 shadow-lg">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"></path></svg>
                  Click to Expand Field Rig
                </span>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-surface border border-border text-xs text-text-muted leading-relaxed font-mono">
            <span class="text-accent font-semibold block mb-1">Field Apparatus In Situ:</span>
            Deployed on an all-terrain cross-country wheeled push-cart. Dual cameras face rearward at a calibrated depression angle to observe mapped geometry without human operator occlusion or footstep artifacts.
          </div>
        </div>

        <!-- Right: Modular Hardware Specifications Cards -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <!-- Mid-360 LiDAR -->
          <div class="p-5 rounded-xl bg-surface border border-border hover:border-border-hover transition-colors">
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-mono uppercase tracking-wider text-accent bg-accent/10 px-2 py-0.5 rounded border border-accent/20">Active Ranging</span>
              <span class="text-xs font-mono text-text-dim">~$700</span>
            </div>
            <h3 class="text-base font-bold text-white mb-2">Livox Mid-360S LiDAR</h3>
            <ul class="text-xs text-text-muted space-y-2 leading-relaxed">
              <li>&bull; <strong class="text-text-main">Scanning Architecture:</strong> Solid-state non-repetitive circular rosette pattern at 200,000 pts/sec.</li>
              <li>&bull; <strong class="text-text-main">Field of View:</strong> 360° horizontal &times; 59° vertical coverage, providing dense canopy-to-ground photon coverage.</li>
              <li>&bull; <strong class="text-text-main">Embedded IMU:</strong> 200 Hz 6-DOF industrial inertial sensor tight-coupled to LiDAR clock.</li>
            </ul>
          </div>

          <!-- FLIR Blackfly S Stereo -->
          <div class="p-5 rounded-xl bg-surface border border-border hover:border-border-hover transition-colors">
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-mono uppercase tracking-wider text-spectral bg-spectral/10 px-2 py-0.5 rounded border border-spectral/20">Optical Stereo</span>
              <span class="text-xs font-mono text-text-dim">~$1,100 Pair</span>
            </div>
            <h3 class="text-base font-bold text-white mb-2">Dual FLIR Blackfly S</h3>
            <ul class="text-xs text-text-muted space-y-2 leading-relaxed">
              <li>&bull; <strong class="text-text-main">Sensors:</strong> Global-shutter machine vision cameras (1.3 MP, 1280 &times; 1024 px).</li>
              <li>&bull; <strong class="text-text-main">Rigid Baseline:</strong> 457.2 mm (18.0 in) precision aluminum crossbar providing high disparity resolution.</li>
              <li>&bull; <strong class="text-text-main">Global Shutter:</strong> Eliminates rolling-shutter spatial skew and motion blur during mobile traverses.</li>
            </ul>
          </div>

          <!-- NVIDIA Jetson AGX Orin -->
          <div class="p-5 rounded-xl bg-surface border border-border hover:border-border-hover transition-colors">
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-mono uppercase tracking-wider text-topo bg-topo/10 px-2 py-0.5 rounded border border-topo/20">Edge Compute</span>
              <span class="text-xs font-mono text-text-dim">Edge AI</span>
            </div>
            <h3 class="text-base font-bold text-white mb-2">NVIDIA Jetson AGX Orin</h3>
            <ul class="text-xs text-text-muted space-y-2 leading-relaxed">
              <li>&bull; <strong class="text-text-main">Middleware:</strong> Native ROS 2 Humble operating under real-time determinism.</li>
              <li>&bull; <strong class="text-text-main">Onboard SLAM:</strong> GPU-accelerated FAST-LIO2 LiDAR-inertial odometry executing in real time.</li>
              <li>&bull; <strong class="text-text-main">Data Logging:</strong> Multi-sensor synchronized Rosbag2 streaming directly to high-end NVMe.</li>
            </ul>
          </div>

          <!-- Cross-Country Wheeled Chassis -->
          <div class="p-5 rounded-xl bg-surface border border-border hover:border-border-hover transition-colors">
            <div class="flex items-center justify-between mb-3">
              <span class="text-[10px] font-mono uppercase tracking-wider text-accent-light bg-forest-900 px-2 py-0.5 rounded border border-border">Mobility Platform</span>
              <span class="text-xs font-mono text-text-dim">All-Terrain</span>
            </div>
            <h3 class="text-base font-bold text-white mb-2">Cross-Country Chassis</h3>
            <ul class="text-xs text-text-muted space-y-2 leading-relaxed">
              <li>&bull; <strong class="text-text-main">Low-Impact Design:</strong> High-clearance pneumatic wheels traversable over fallen logs and dense duff.</li>
              <li>&bull; <strong class="text-text-main">Rear-Looking Optics:</strong> Cameras aimed backwards at mapped scene to prevent operator obscuration.</li>
              <li>&bull; <strong class="text-text-main">Total Payload:</strong> ~$2,200 sensor core, achieving an order-of-magnitude reduction vs. $50k+ commercial rigs.</li>
            </ul>
          </div>

        </div>
      </div>

      <!-- Sensor Payload & SWaP-C Specification Table -->
      <div class="p-6 rounded-2xl bg-surface border border-border overflow-x-auto">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-base font-bold text-white">Sensor Payload &amp; SWaP-C Architecture Specifications</h3>
          <span class="text-xs font-mono text-accent">Total Payload: ~$2,200 &bull; 4.8 kg</span>
        </div>
        <table class="w-full text-left text-xs font-mono">
          <thead>
            <tr class="border-b border-border text-text-dim uppercase text-[10px] tracking-wider">
              <th class="pb-2">Subsystem</th>
              <th class="pb-2">Component / Model</th>
              <th class="pb-2">Technical Specification</th>
              <th class="pb-2">Power / Weight</th>
              <th class="pb-2 text-right">Cost</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border/60 text-text-muted">
            {hardwareSpecs.map(row => (
              <tr class="hover:bg-forest-900/40 transition-colors">
