    delta: "25× cost reduction",
    deltaColor: "text-accent"
  },
  {
    value: "65 Stems",
    label: "Field Ground Truth",
    baseline: "3 Wooded Groves (Burlington, MA)",
    delta: "Logger's-tape calibrated",
    deltaColor: "text-accent-light"
  },
  {
    value: "+2.83 cm",
    subVal: "± 1.45 cm",
    label: "360° Ring DBH Accuracy",
    baseline: "R² = 0.9833, RMSE 3.18 cm",
    delta: "Bark furrow envelope (n=43)",
    deltaColor: "text-topo"
  },
  {
    value: "+1.60 cm",
    subVal: "± 2.78 cm",
    label: "Single-View Camera DBH",
    baseline: "MAE = 2.58 cm (n=9 stations)",
    delta: "Zero walkaround required",
    deltaColor: "text-spectral"
  },
  {
    value: "1.0098",
    subVal: "± 0.0137",
    label: "SLAM Metric Scale Rigidity",
    baseline: "82–97 m understory loops",
    delta: "<1% scale dilation (No GPS)",
    deltaColor: "text-accent"
  },
  {
    value: "0.87 mm",
    label: "Extrinsic Vertical Precision",
    baseline: "One-sided pitch was 3.48 mm",
    delta: "2.7× weak-axis resolution",
    deltaColor: "text-accent-light"
  }
];

// Hardware Subsystem Specifications (Modular Commercial Architecture)
const hardwareSpecs = [
  {
    subsystem: "Active 3D Ranging",
    component: "Solid-State LiDAR Array",
    spec: "Non-repetitive circular rosette spatial scanning, 200,000 pts/sec, 360° × 59° FOV",
    role: "Spatial geometry & understory traverse SLAM",
    integration: "Commercial Off-The-Shelf",
    powerWeight: "8.5 W • 265 g"
  },
  {
    subsystem: "Optical Stereo",
    component: "Synchronized Optical Array",
    spec: "Dual high-speed global-shutter optical sensors with rigid baseline geometry",
    role: "Optical silhouette segmentation & visual edge mensuration",
    integration: "Integrated Subsystem",
    powerWeight: "6.0 W • 180 g (pair)"
  },
  {
    subsystem: "Inertial Odometry",
    component: "Industrial 6-DOF IMU",
    spec: "High-rate 200 Hz inertial odometry, hardware-synchronized to LiDAR clock",
    role: "Inertial pre-integration for FAST-LIO2 state prediction",
    integration: "Embedded Synchronous",
    powerWeight: "Integrated"
  },
  {
    subsystem: "Edge AI Compute",
    component: "Embedded Edge AI Engine",
    spec: "High-density LPDDR5, up to 200 TOPS AI compute, native ROS 2 Humble",
    role: "Real-time SLAM odometry, camera logging & edge AI",
    integration: "Edge Computing Engine",
    powerWeight: "15–40 W • 650 g"
  },
  {
    subsystem: "Chassis / Vehicle Mount",
    component: "Modular Integration Chassis",
    spec: "High-clearance mobility platform adaptable to vehicle cab/rack mounts or push-cart",
    role: "All-terrain traverse across forest understory, fallen logs & duff",
    integration: "Custom Mechanical IP",
    powerWeight: "4.8 kg Total Core"
  }
];
---

<Layout title="CUTMAP: Autonomous Forest Mensuration Platform | Phase II Commercialization Brief">
  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-10 md:py-14">
    
    <!-- SSI Corporate Header & Teaming Banner -->
    <header class="mb-8 p-4 sm:p-5 rounded-2xl bg-surface/90 border border-border hover:border-accent/40 backdrop-blur-md transition-all duration-300 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-4 w-full sm:w-auto">
        <a 
          href="https://www.spectral.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="shrink-0 group flex items-center justify-center px-3 py-1.5 rounded-xl bg-white hover:bg-neutral-100 shadow-md border border-neutral-200 transition-all"
          title="Visit Spectral Sciences, Inc. (www.spectral.com)"
        >
          <img 
            src="/images/SSI_LOGO-transparent.png" 
            alt="Spectral Sciences, Inc. Logo" 
            class="h-9 sm:h-11 w-auto object-contain group-hover:scale-105 transition-transform"
          />
        </a>
        <div class="border-l border-border/80 pl-3 sm:pl-4">
          <div class="flex items-center gap-2">
            <a 
              href="https://www.spectral.com" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-xs sm:text-sm font-bold text-white hover:text-accent transition-colors flex items-center gap-1 group"
            >
              <span>Spectral Sciences, Inc.</span>
              <svg class="w-3 h-3 text-text-dim group-hover:text-accent group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
            </a>
            <span class="text-[10px] font-mono text-text-dim hidden md:inline">|</span>
            <span class="text-[11px] font-mono text-text-dim hidden md:inline">Remote Sensing &amp; Autonomous Systems</span>
          </div>
          <p class="text-[11px] text-text-muted mt-0.5">
            Technology Commercialization &bull; USDA-NIFA SBIR/STTR Track
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2.5 w-full sm:w-auto justify-end">
        <a 
          href="#teaming-partnership" 
          class="w-full sm:w-auto text-center px-3.5 py-2 rounded-lg bg-accent/15 border border-accent/40 hover:bg-accent hover:text-forest-950 text-accent text-xs font-mono font-semibold transition-all shadow-sm flex items-center justify-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          <span>Phase II Teaming Opportunity</span>
        </a>
        <a 
          href="https://www.spectral.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="hidden lg:inline-flex items-center gap-1 px-3 py-2 rounded-lg bg-forest-900 border border-border hover:border-accent/40 text-xs font-mono text-text-muted hover:text-white transition-colors"
        >
          <span>www.spectral.com</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        </a>
      </div>
    </header>
    
    <!-- Top Breadcrumbs / Navigation -->
    <nav aria-label="Breadcrumbs" class="mb-8 flex items-center justify-between">
      <a 
        href="/#portfolio" 
        class="inline-flex items-center gap-2 text-xs font-mono text-text-muted hover:text-accent transition-colors group"
      >
        <span class="group-hover:-translate-x-0.5 transition-transform">&larr;</span>
        <span>Back to Projects &amp; Portfolio</span>
      </a>
      <div class="flex items-center gap-2 text-[11px] font-mono text-text-dim">
        <span>COMMERCIALIZATION DOSSIER</span>
        <span>/</span>
        <span class="text-accent-light">CUTMAP PHASE II</span>
      </div>
    </nav>

    <!-- SECTION: HERO & KPIS -->
    <section class="mb-16 md:mb-20">
      
      <!-- Eyebrow Tags & Metadata -->
      <div class="flex flex-wrap items-center gap-2.5 mb-5">
        <span class="px-2.5 py-1 rounded bg-forest-900 border border-accent/40 text-accent text-[11px] font-mono font-medium tracking-wide flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
          USDA-NIFA SBIR/STTR Commercialization Track
        </span>
        <span class="px-2.5 py-1 rounded bg-forest-900 border border-border text-text-muted text-[11px] font-mono">
          Phase II Teaming Opportunity
        </span>
        <span class="px-2.5 py-1 rounded bg-forest-900 border border-border text-text-muted text-[11px] font-mono">
          TRL 6 Proven Prototype
        </span>
      </div>

      <!-- Main Heading & Subtitle -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.1] mb-5">
        CUTMAP: Autonomous Under-Canopy Forest Mensuration
      </h1>
      <p class="text-lg sm:text-xl md:text-2xl font-semibold text-accent-light max-w-4xl leading-snug mb-6">
        Commercial-Grade Forest Inventory at 1/20th the Cost — De-Risked Autonomous Mensuration for Forestry &amp; Equipment Teaming Partners
      </p>

      <!-- Institutional Attribution Bar -->
      <div class="p-4 rounded-xl bg-surface border border-border mb-8 grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-mono">
        <div>
          <span class="text-text-dim block uppercase text-[10px] tracking-wider mb-0.5">Technology Developer &amp; Lead Architect</span>
          <a href="https://www.spectral.com" target="_blank" rel="noopener noreferrer" class="text-text-main font-semibold hover:text-accent transition-colors inline-flex items-center gap-1">
            <span>Spectral Sciences, Inc.</span>
            <svg class="w-3 h-3 text-text-dim" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
          </a>
          <span class="text-text-muted block text-[11px]">Dr. Cory Glenn Garms (PI &amp; Lead Scientist)</span>
        </div>
        <div>
          <span class="text-text-dim block uppercase text-[10px] tracking-wider mb-0.5">Academic Co-Investigator</span>
          <span class="text-text-main font-semibold">Oregon State University</span>
          <span class="text-text-muted block text-[11px]">Dr. Bogdan Strimbu (Associate Professor)</span>
        </div>
        <div>
          <span class="text-text-dim block uppercase text-[10px] tracking-wider mb-0.5">Federal Sponsoring Agency</span>
          <span class="text-text-main font-semibold">USDA-NIFA</span>
          <span class="text-text-muted block text-[11px]">SBIR/STTR Program</span>
        </div>
      </div>

      <!-- Executive Commercial Narrative -->
      <div class="prose prose-invert max-w-none text-text-muted text-sm sm:text-base leading-relaxed mb-8 space-y-3">
        <p>
          Forest timber inventory and carbon verification remain constrained by a costly dilemma: traditional manual timber cruising is slow, labor-intensive ($15–$30 per acre), and sparse, while commercial mobile laser scanners command <strong class="text-white">$50,000 to $100,000+</strong> in fragile hardware, requiring complex post-processing and specialized operators.
        </p>
        <p>
          <strong class="text-white">CUTMAP</strong> (<em>Comprehensive Utility for Thinning Mechanically via Automated Prescription</em>), engineered by <a href="https://www.spectral.com" target="_blank" rel="noopener noreferrer" class="text-white underline decoration-accent/60 hover:text-accent transition-colors">Spectral Sciences, Inc. (SSI)</a> under USDA-NIFA SBIR/STTR funding, delivers survey-grade precision on a compact <strong class="text-accent font-mono">~$2,200 hardware payload</strong>. Running GPU-accelerated SLAM, real-time stem vectoring, and AI-driven single-viewpoint mensuration entirely on edge compute, CUTMAP operates completely independent of GPS or cloud connectivity.
        </p>
        <p>
          With Phase I empirical validation complete across 65 taped stems (+2.83 cm DBH accuracy, R² = 0.983), <strong class="text-white">Spectral Sciences, Inc. is actively seeking a commercialization teaming partner for Phase II</strong>. We invite timberland operators (TIMOs), forestry equipment OEMs, and precision mapping providers to co-deploy this technology, adapt it to operational fleets, and capture market leadership in autonomous forest management.
        </p>
      </div>

      <!-- High-Impact Commercial Action Bar -->
      <div class="flex flex-wrap items-center gap-4 mb-10">
        <a 
          href="#teaming-partnership" 
          class="px-5 py-3 rounded-xl bg-accent text-forest-950 font-mono font-bold text-xs sm:text-sm hover:bg-accent-light transition-all shadow-lg hover:shadow-accent/20 flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          <span>Partner for Phase II Commercialization</span>
        </a>
        <a 
          href="#interactive-viewer" 
          class="px-4 py-3 rounded-xl bg-surface border border-border hover:border-accent/50 text-text-main hover:text-white font-mono text-xs sm:text-sm transition-all flex items-center gap-2"
        >
          <svg class="w-4 h-4 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" /></svg>
          <span>Explore Live 3D Data &amp; Evidence</span>
        </a>
        <a 
          href="https://www.spectral.com" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="px-4 py-3 rounded-xl bg-forest-900 border border-border hover:border-accent/40 text-text-muted hover:text-white font-mono text-xs sm:text-sm transition-all flex items-center gap-2.5"
        >
          <span class="w-6 h-6 rounded-md bg-white p-0.5 flex items-center justify-center shrink-0 shadow-sm">
            <img src="/images/SSI_LOGO-transparent.png" alt="SSI" class="w-full h-full object-contain" />
          </span>
          <span>Spectral Sciences (www.spectral.com)</span>
          <svg class="w-3.5 h-3.5 text-text-dim" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
        </a>
      </div>

      <!-- KPI Metric Counter Grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
        {kpis.map((kpi) => (
          <div class="p-4 rounded-xl bg-surface border border-border hover:border-accent/40 transition-all duration-300 flex flex-col justify-between group">
            <div>
              <span class="text-[10px] font-mono text-text-dim uppercase tracking-wider block mb-1">
                {kpi.label}
              </span>
              <div class="text-xl sm:text-2xl font-bold font-mono text-white group-hover:text-accent transition-colors flex items-baseline gap-1">
                <span>{kpi.value}</span>
                {kpi.subVal && <span class="text-xs text-text-muted font-normal">{kpi.subVal}</span>}
              </div>
            </div>
            <div class="pt-3 mt-3 border-t border-border/60">
              <span class={`text-[10px] font-mono block font-medium ${kpi.deltaColor}`}>
                {kpi.delta}
              </span>
              <span class="text-[10px] font-mono text-text-dim block mt-0.5 truncate" title={kpi.baseline}>
                {kpi.baseline}
              </span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SECTION 01: INTERACTIVE 3D UNDERSTORY LIDAR VIEWER -->
    <section class="mb-20 md:mb-28" id="interactive-viewer">
      <div class="flex items-center gap-3 mb-2">
        <span class="h-px flex-1 bg-border"></span>
        <span class="text-xs font-mono text-accent uppercase tracking-widest px-2">Interactive Technology Demonstration</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <div class="text-center max-w-3xl mx-auto mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight mb-2">
          Interactive Understory LiDAR Point Cloud
        </h2>
        <p class="text-xs sm:text-sm text-text-muted">
          Live inspection of 200,000 pts/sec understory point clouds collected in real time by the CUTMAP sensor cart.
        </p>
      </div>

      <!-- React Three Fiber Point Cloud Canvas -->
      <div class="mb-4">
        <CutmapLidarViewer client:load />
      </div>

      <!-- Interactive Stand Guide -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-mono">
        <div class="p-4 rounded-xl bg-surface border border-border">
          <div class="text-accent font-semibold mb-1 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            Stand 1: White Pine Grove
          </div>
          <p class="text-text-muted text-[11px] leading-relaxed">
            Towering mature <em>Pinus strobus</em> with high crown base. Clean ground-duff surface and vertical trunks ideal for circular RANSAC slice fitting.
          </p>
        </div>
        <div class="p-4 rounded-xl bg-surface border border-border">
          <div class="text-accent font-semibold mb-1 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            Stand 2: Deciduous Grove
          </div>
          <p class="text-text-muted text-[11px] leading-relaxed">
            Mixed northern hardwoods with lateral trunk lean and multi-stem forks. Tests the 3D stem vectoring and taper algorithms from Garms &amp; Strimbu (2021).
          </p>
        </div>
        <div class="p-4 rounded-xl bg-surface border border-border">
          <div class="text-accent font-semibold mb-1 flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            Stand 3: Dense Understory Loop
          </div>
          <p class="text-text-muted text-[11px] leading-relaxed">
            High shrub and sapling occlusion. Demonstrates FAST-LIO2 metric scale rigidity (1.0098) through complex pedestrian obstacle avoidance maneuvers.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 02: HARDWARE PLATFORM & UNIT ECONOMICS -->
    <section class="mb-20 md:mb-28">
      <div class="flex items-center gap-3 mb-2">
        <span class="h-px flex-1 bg-border"></span>
        <span class="text-xs font-mono text-accent uppercase tracking-widest px-2">Section 01 // Hardware Rig &amp; Unit Economics</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>
      
