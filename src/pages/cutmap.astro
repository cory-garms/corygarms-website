---
import Layout from "../layouts/Layout.astro";
import CutmapLidarViewer from "../components/CutmapLidarViewer.jsx";

// 1. Verified KPI Bubbles (click for full metric breakdown)
const kpis = [
  {
    id: "kpi-bom",
    value: "~$4,439",
    label: "Low-SWaP-C BOM",
    color: "text-accent",
    modalTitle: "Phase I Hardware & Compute BOM (~$4,439)",
    modalSubtitle: "Component List Price Breakdown",
    modalBullets: [
      "Sensors & battery: $2,440 (Livox Mid-360 solid-state 3D lidar + integrated 200 Hz IMU, two FLIR Blackfly BFLY-U3-13S2C global-shutter cameras, Garmin GLO 2 GNSS logger).",
      "Edge compute: $1,999 (NVIDIA Jetson AGX Orin Developer Kit, 12 cores, 32 GB RAM, 275 TOPS, running ROS 2 Humble in MAXN mode).",
      "Note: Replacement pricing as of November 2026 totals $6,297. Existing mobile laser scanners carry costs comparable to terrestrial laser scanners (Mattamala et al. 2025)."
    ]
  },
  {
    id: "kpi-closure",
    value: "0.010–0.037 m",
    label: "Loop Closure / 100 m",
    color: "text-emerald-400",
    modalTitle: "Marked-Loop Closure Error (No GPS)",
    modalSubtitle: "0.010–0.037 m per 100 m across 5 physical-mark runs",
    modalBullets: [
      "Mount Auburn Hazel Dell grate loop: 17.8 mm closure over 178 m (0.010 m per 100 m).",
      "Mount Auburn Halcyon Lake grate loop: 80.0 mm closure over 425 m (0.019 m per 100 m).",
      "Burlington outdoor loops (221–223 m): 0.029 and 0.013 m per 100 m; 76.4 m indoor loop: 0.037 m per 100 m.",
      "Stationary accelerometer gravity levelling flattened Grove A ground elevation spread from 0.52 m to 0.05 m."
    ]
  },
  {
    id: "kpi-fullring",
    value: "+2.84 ± 1.46 cm",
    label: "Full-Ring DBH (n=42)",
    color: "text-cyan-400",
    modalTitle: "Full-Ring Stem Mensuration (n = 42)",
    modalSubtitle: "Eastern white pine stems with ≥ 340° angular sweep",
    modalBullets: [
      "Diameter accuracy: +2.84 cm constant outer-bark offset ± 1.46 cm spread, RMSE 3.18 cm, R² = 0.9836.",
      "41 of 42 stems read slightly high because lidar pulses reflect from outer bark ridges and lichens rather than compressed tape diameter.",
      "Evaluated against physical logger's tape at breast height (z = 1.37 m) across three groves in Burlington, MA."
    ]
  },
  {
    id: "kpi-allview",
    value: "+3.26 ± 2.53 cm",
    label: "All-View DBH (n=65)",
    color: "text-amber-300",
    modalTitle: "All-View Stem Mensuration & Partial-Arc Effect (n = 65)",
    modalSubtitle: "All taped eastern white pine stems regardless of angular sweep",
    modalBullets: [
      "Overall agreement across all 65 taped stems: +3.26 ± 2.53 cm, RMSE 4.12 cm, R² = 0.951.",
      "Partial-arc sensitivity: −2.791 cm per 100° of angular coverage—meaning a stem viewed from one side reads +2.79 cm wider for every 100° of missing trunk arc (R² = 0.273, p = 8.2 × 10⁻⁶).",
      "Quantifying this angular-coverage law informs Phase II online correction for single-pass trail and vehicle traverses."
    ]
  },
  {
    id: "kpi-camera",
    value: "+1.92 ± 3.44 cm",
    label: "Camera DBH (n=52)",
    color: "text-emerald-300",
    modalTitle: "Lidar-Gated Single-View Camera DBH (n = 52)",
    modalSubtitle: "Pooled across both FLIR Blackfly global-shutter cameras",
    modalBullets: [
      "When lidar certifies an unobstructed line of sight, projected 3D trunk priors prompt SAM ViT-B to segment optical bark silhouettes.",
      "Single-viewpoint optical DBH achieves +1.92 ± 3.44 cm (n = 52, pooled across both cameras) using lidar range for metric scale.",
      "Bypasses single-view circle-fitting inflation without requiring a full walkaround ring."
    ]
  },
  {
    id: "kpi-forestgeo",
    value: "87.0% / 93.1%",
    label: "ForestGEO Recall / Prec.",
    color: "text-accent-light",
    modalTitle: "Harvard Forest ForestGEO (HF253) Detection Benchmark",
    modalSubtitle: "Sealed 12-cell evaluation across 3.26 km trail network",
    modalBullets: [
      "Merchantable stems (≥ 10 cm DBH): 87.0% recall and 93.1% precision.",
      "All stems (≥ 1 cm DBH): 72.0% recall and 86.2% precision across 779M lidar points (4.39 ha mapped within 15 m of 17 walks).",
      "Two-phase double sampling (441 lidar cells + 40 reference cells) recovered stand basal area at 45.98 [40.19, 52.30] m²/ha vs. 47.44 m²/ha census truth."
    ]
  }
];

// 2. Architecture Bubbles (compact on card, full detail on click)
const architectureCards = [
  {
    id: "arch-hardware",
    tag: "01 • Edge Payload",
    title: "~$4,439 Prototype",
    bullets: [
      "Livox Mid-360 lidar + 200 Hz IMU",
      "2× FLIR Blackfly cameras (457.2 mm baseline)",
      "Jetson AGX Orin (ROS 2 Humble, 28.96 MB/s)"
    ],
    modalTitle: "Low-SWaP-C Sensor & Compute Stack",
    modalSubtitle: "Phase I utility-cart prototype ($2,440 sensors/battery + $1,999 Jetson Dev Kit)",
    modalBullets: [
      "Lidar & IMU: Livox Mid-360 solid-state 3D lidar (200,000 pts/s non-repetitive circular scan) with integrated 200 Hz IMU.",
      "Optical Array: Two rear-facing FLIR Blackfly (BFLY-U3-13S2C) global-shutter color cameras on a 457.2 mm baseline, plus a Garmin GLO 2 GNSS logger.",
      "Edge Compute: NVIDIA Jetson AGX Orin Developer Kit (12 cores, 32 GB RAM, 275 TOPS, MAXN mode), logging 63 field bags at 28.96 MB/s (104 GB/h).",
      "Replacement pricing as of November 2026 is $6,297."
    ]
  },
  {
    id: "arch-odometry",
    tag: "02 • Odometry Pivot",
    title: "FAST-LIO2 + Levelling",
    bullets: [
      "Passive VO failed under foliage; pivoted to lidar",
      "Gravity levelling flattens terrain (0.52 → 0.05 m)",
      "0.010–0.037 m / 100 m marked-loop closure"
    ],
    modalTitle: "The Empirical Pivot to Lidar–Inertial Odometry",
    modalSubtitle: "Why sub-canopy lidar is essential (July 24, 2026 architecture pivot)",
    modalBullets: [
      "Spring 2026 passive trials: Pure stereo VO collapsed in dense foliage (0.00 m tracked, May 2026); monocular VO suffered 23–98% scale drift vs. GPS; 15-state EKF proved unstable (April 2026).",
      "Pivoted positioning to tightly coupled lidar-inertial odometry (FAST-LIO2), keeping cameras for bark/foliage segmentation and optical silhouette mensuration.",
      "Stationary Gravity Levelling: FAST-LIO2 initializes unlevelled (causing a 7.23 m vertical swing on a 220.9 m loop, cut to 2.6 m after levelling; Grove A ground spread collapsed from 0.52 m to 0.05 m)."
    ]
  },
  {
    id: "arch-calibration",
    tag: "03 • Calibration Gate",
    title: "Scale-Gate Integrity",
    bullets: [
      "Caught 2.50 mm target curl → ~140 mm shift",
      "Flat target restored 0.66% baseline agreement",
      "Laser scale gate + count² weighting (6.6 mm)"
    ],
    modalTitle: "Multi-Sensor Calibration & Failure Coupling",
    modalSubtitle: "External laser-rangefinder scale gate + rigid flat checkerboard",
    modalBullets: [
      "Failure coupling: A 2.50 mm peak-to-peak curl over 320 mm on a cardboard checkerboard biased focal length 4.6% low and forced a 133 mm lateral / ~140 mm fore-aft extrinsic shift while camera residuals stayed < 1 px.",
      "Flat target fix: Rigid flat backing restored stereo baseline concordance to 454.20 mm vs. 457.2 mm physical tape (0.66% agreement, 0.309 px stereo RMS).",
      "External scale gate & weighting: Lidar range slope 0.9964 (5 stations, 2–6 m); stereo scale slope 0.9836 (−1.64%, SE ~0.95%, 3 stations 2–4 m); count^2.0 plane weighting reduced lateral centering sum from 40.9 mm to 6.6 mm."
    ]
  }
];

// 3. Field Campaign Bubbles (compact on card, full detail on click)
const campaignCards = [
  {
    id: "camp-burlington",
    tag: "Burlington, MA",
    title: "65 Taped White Pines",
    accent: "text-cyan-400",
    bullets: [
      "Full rings (n=42): +2.84 ± 1.46 cm (R² = 0.984)",
      "Partial-arc slope: +2.79 cm / 100° missing arc",
      "Camera DBH (n=52): +1.92 ± 3.44 cm"
    ],
    modalTitle: "Field Campaign 1: 65 Taped White Pine Stems (Burlington, MA)",
    modalSubtitle: "Three eastern white pine groves taped at breast height (z = 1.37 m)",
    modalBullets: [
      "Full-ring sweeps (≥ 340°, n = 42): +2.84 cm outer-bark offset ± 1.46 cm spread, RMSE 3.18 cm, R² = 0.9836 (41/42 read slightly high due to outer bark ridges and lichens).",
      "All 65 stems regardless of coverage: +3.26 ± 2.53 cm, RMSE 4.12 cm, R² = 0.951.",
      "Partial-arc law: −2.791 cm per 100° of visible arc (+2.79 cm wider per 100° of missing arc, R² = 0.273, p = 8.2 × 10⁻⁶).",
      "Lidar-gated optical DBH (SAM ViT-B, n = 52 pooled across both cameras): +1.92 ± 3.44 cm on unobstructed stems."
    ]
  },
  {
    id: "camp-mtauburn",
    tag: "Cambridge, MA",
    title: "Mount Auburn Arboretum",
    accent: "text-emerald-400",
    bullets: [
      "2,638 m walked in 44.6 min (12.0 ha mapped)",
      "Grate closures: 17.8 mm/178 m & 80 mm/425 m",
      "60 held-out stems: 5.37 cm median error"
    ],
    modalTitle: "Field Campaign 2: Mount Auburn Cemetery & Arboretum (Sep 16, 2026)",
    modalSubtitle: "9 mobile scans across a 175-acre living tree collection",
    modalBullets: [
      "Coverage: 2,638 m walked (44.6 min) mapping 12.0 ha (29.7 acres) within 30 m of trajectories; observed 62% (308 of 493) of curated botanical records within 15 m (525 labeled trees).",
      "Marked-loop closures on physical cast-iron drainage grates: 17.8 mm over 178 m (0.010 m/100m, Hazel Dell) and 80.0 mm over 425 m (0.019 m/100m, Halcyon Lake).",
      "Held-out stem DBH (n = 60 scored once against institutional records): 5.37 cm median absolute error, +2.45 cm mean bias, 6.79 cm RMSE excluding 3 extreme co-dominant/flared ornamental specimens (11.38 cm overall)."
    ]
  },
  {
    id: "camp-hf253",
    tag: "Petersham, MA",
    title: "Harvard Forest (HF253)",
    accent: "text-accent",
    bullets: [
      "87.0% recall / 93.1% prec. (≥ 10 cm DBH)",
      "+0.2 cm bias on large sawtimber (≥ 40 cm)",
      "Double sampling: 45.98 vs. 47.44 m²/ha truth"
    ],
    modalTitle: "Field Campaign 3: Harvard Forest Smithsonian ForestGEO (HF253, Sep 24, 2026)",
    modalSubtitle: "3,264 m trail network across 17 walks (65 min, 779M points, 113 GB, 4.39 ha)",
    modalBullets: [
      "Sealed 12-cell detection benchmark: 87.0% recall / 93.1% precision on merchantable stems (≥ 10 cm DBH); 72.0% recall / 86.2% precision across all stems (≥ 1 cm).",
      "Size-dependent median diameter bias: +0.2 cm (≥ 40 cm, n=14), +2.4 cm (20–40 cm, n=32), +4.8 cm (10–20 cm, n=30), and +14.9 cm on 1–10 cm saplings (n=48).",
      "Two-phase double sampling (441 grid cells + 40 reference cells): removed raw map overestimation (74.34 m²/ha) to recover stand basal area at 45.98 [40.19, 52.30] m²/ha vs. 47.44 m²/ha census truth (held-out test: 45.71 [39.17, 53.35] vs. 47.32 m²/ha)."
    ]
  }
];

// 4. Broad Sector Capabilities (compact on card, full detail on click)
const sectorCards = [
  {
    id: "sec-silviculture",
    title: "Silviculture & Thinning",
    summary: "Single-tree stem maps & double sampling for thinning prescriptions.",
    modalTitle: "Commercial & Precommercial Silviculture",
    modalSubtitle: "Closing the gap between plot averages and tree-level harvest decisions",
    modalBullets: [
      "Forest thinning is decided one tree at a time; fixed-radius plots give stand averages but cannot tell a forester or harvester which stem to cut or leave.",
      "Pairs walk-speed lidar stem maps with classical two-phase double sampling to calibrate stand basal area and drive OSU MARS Lab heuristic thinning and SEEM growth-and-yield models."
    ]
  },
  {
    id: "sec-wildfire",
    title: "Wildfire Fuels & Corridors",
    summary: "Sub-canopy ladder-fuel density & right-of-way encroachment.",
    modalTitle: "Wildfire Fuel Reduction & Utility Corridors",
    modalSubtitle: "Mapping small-diameter ladder fuels and obstructed rights-of-way",
    modalBullets: [
      "Precommercial thinning requires mapping dense understory ladder fuels where aerial lidar is occluded by the upper canopy.",
      "Phase II optical silhouette fusion targets the 1–10 cm sapling size class (+14.9 cm lidar inflation in Phase I) to support fuel-treatment verification and corridor clearance."
    ]
  },
  {
    id: "sec-urban",
    title: "Urban & Agricultural",
    summary: "GPS-denied municipal inventories, arboretums & orchard phenotyping.",
    modalTitle: "Urban Forestry, Arboretums & High-Value Crops",
    modalSubtitle: "Validated across 12.0 ha at Mount Auburn Cemetery & Arboretum",
    modalBullets: [
      "Produces centimeter-closed local maps under dense ornamental canopies and urban canyons where GNSS multipathing degrades positioning.",
      "Achieved 5.37 cm median DBH error against curated botanical records and generalizes directly to orchard trunk/canopy geometry and specialty crop phenotyping."
    ]
  },
  {
    id: "sec-autonomy",
    title: "Modular Autonomy",
    summary: "Quick-swap edge payload across backpacks, ATVs & harvesters.",
    modalTitle: "Modular Multi-Platform Deployment (Phase II)",
    modalSubtitle: "Approved Phase II development horizon",
    modalBullets: [
      "In Phase II, we are working toward near real-time mensuration and automated thinning prescriptions on embedded edge compute, and evaluating modular deployment configurations across backpack, ATV, and harvesting machinery.",
      "Integrates a 4-camera hardware-synchronized optical array and an NDAA-compliant 3D lidar around a single quick-swap edge computer."
    ]
  }
];

// 5. Phase I Limitations Modal Data
const limitationsModalData = {
  id: "phase1-limits",
  modalTitle: "Measured Phase I Limitations Driving Phase II",
  modalSubtitle: "Engineering transparency from Burlington, Mount Auburn & Harvard Forest",
  modalBullets: [
    "Small-stem (1–10 cm) inflation (+14.9 cm) and under-detection (354 mapped/ha vs. 1,194 census/ha in HF253): currently limits cell-level basal-area correlation (ρ ≈ 0.37); targeted by Phase II camera silhouette fusion.",
    "Single-sided partial-arc bias (+2.79 cm per 100° missing trunk arc): requires online angular-coverage correction for single-pass trail and vehicle traverses.",
    "Camera-to-camera plane disagreement (13 mm RMS, up to 34.5 mm) and 3-station stereo scale gate (2–4 m): requires multi-station scale-gate expansion and <1 ms PTP hardware synchronization.",
    "Residual map-frame tilt (0.6–1.3° on 8/9 Mount Auburn runs; 1.9° on one): requires continuous gravity-constrained trajectory optimization beyond stationary initial levelling."
  ]
};

// 6. Publications & Presentations
const publications = [
  {
    authors: "Garms, C.G. & Strimbu, B.M. (2026)",
    title: "CUTMAP: A Low-SWaP-C Mobile Mapping Platform for Forest Mensuration",
    venue: "NEMO & SOMENS Joint Meeting (Nov 10, 2026)",
    status: "Presented"
  },
  {
    authors: "Garms, C.G., Strimbu, B.M., et al. (2026)",
    title: "Calibrating a Low-SWaP-C Lidar–Stereo Platform: Staged Procedures, Failure Coupling, and Operational Validation",
    venue: "Target: Journal of Field Robotics",
    status: "In Preparation"
  },
  {
    authors: "Garms, C.G. & Strimbu, B.M. (2021)",
    title: "Impact of stem lean on estimation of Douglas-fir diameter and volume using mobile lidar scans",
    venue: "Canadian Journal of Forest Research, 51(8), 1117–1130",
    status: "Published",
    doi: "https://doi.org/10.1139/cjfr-2020-0082"
  }
];

const allModalItems = [
  ...kpis,
  ...architectureCards,
  ...campaignCards,
  ...sectorCards,
  limitationsModalData
];
---

<Layout 
  title="CUTMAP | Low-SWaP-C Mobile Lidar–Stereo Mapping Platform"
  description="CUTMAP: A low-SWaP-C (~$4,439 BOM) mobile lidar-stereo platform for GPS-denied forest mensuration, thinning prescriptions, and outdoor mapping. USDA-NIFA STTR Phase I (#2025-70436-44908)."
  image="/images/cutmap_cover_photo.jpg"
>

  <!-- 1. HERO & CLICKABLE KPI BUBBLES -->
  <section class="relative pt-10 pb-14 overflow-hidden border-b border-border">
    <div class="absolute inset-0 bg-gradient-to-b from-forest-950 via-background to-background pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-6 relative z-10 space-y-8">

      <!-- Sponsor Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2.5">
          <a 
            href="https://www.spectral.com" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 bg-white hover:bg-slate-100 px-3.5 py-1.5 rounded-xl shadow border border-border/40 transition-all"
          >
            <img src="/images/SSI_LOGO-transparent.png" alt="Spectral Sciences, Inc." class="h-5 sm:h-6 w-auto object-contain" />
            <span class="text-xs font-mono text-slate-800 font-bold border-l border-slate-300 pl-2.5 hidden sm:inline">Spectral Sciences, Inc.</span>
          </a>
          <a 
            href="https://forestry.oregonstate.edu" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-surface hover:bg-forest-900 px-3 py-1.5 rounded-xl border border-border/60 hover:border-[#D73F09]/60 transition-all"
          >
            <span class="w-5 h-5 rounded bg-[#D73F09]/15 border border-[#D73F09]/40 flex items-center justify-center text-[#D73F09] font-black text-[10px] font-mono">OSU</span>
            <span class="text-xs font-semibold text-white">Oregon State University</span>
          </a>
        </div>

        <a 
          href="https://www.nifa.usda.gov/about-nifa/award-announcements/nifa-invests-20m-spur-small-business-led-innovation"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/50 text-[11px] font-mono text-emerald-300"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>USDA-NIFA STTR #2025-70436-44908</span>
        </a>
      </div>

      <!-- Concise Headline -->
      <div class="space-y-4 max-w-3xl">
        <div class="text-xs font-mono text-accent uppercase tracking-widest">
          CUTMAP &bull; Comprehensive Utility for Thinning Mechanically via Automated Prescription
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-[1.1]">
          Low-SWaP-C Mobile Lidar–Stereo Mapping for Forestry &amp; Beyond
        </h1>
        <p class="text-sm sm:text-lg text-text-muted leading-relaxed">
          Solid-state 3D lidar, 200 Hz inertial odometry, and calibrated stereo vision (~$4,439 Phase I BOM) for GPS-denied stem mapping, thinning prescriptions, and modular outdoor perception.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a href="#visual-showcase" class="px-5 py-2.5 rounded-xl bg-accent hover:bg-accent-light text-forest-950 font-bold text-xs font-mono transition-all">
            3D Scans &amp; Video
          </a>
          <a href="#field-campaigns" class="px-5 py-2.5 rounded-xl bg-surface hover:bg-forest-850 text-white border border-border text-xs font-mono transition-all">
            Field Benchmarks
          </a>
          <a href="#teaming" class="px-5 py-2.5 rounded-xl bg-forest-900/80 hover:bg-forest-800 text-text-muted hover:text-white border border-border text-xs font-mono transition-all">
            Phase II Teaming
          </a>
        </div>
      </div>

      <!-- 6 Compact KPI Bubbles (Click any bubble for full metrics) -->
      <div>
        <div class="flex items-center justify-between mb-2.5">
          <span class="text-[11px] font-mono uppercase tracking-wider text-text-dim">Verified Phase I Benchmarks</span>
          <span class="text-[11px] font-mono text-accent">Click any bubble for details +</span>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4">
          {kpis.map(kpi => (
            <button
              type="button"
              data-modal-id={kpi.id}
              aria-haspopup="dialog"
              class="bubble-trigger text-left p-4 sm:p-5 rounded-2xl bg-surface/90 border border-border hover:border-accent/60 hover:bg-forest-900/60 transition-all cursor-pointer group flex flex-col justify-between"
            >
              <div class="flex items-start justify-between gap-2 w-full">
                <div class={`text-xl sm:text-2xl font-black font-mono ${kpi.color} tracking-tight`}>
                  {kpi.value}
                </div>
                <span class="w-5 h-5 rounded-full bg-forest-900 border border-border group-hover:border-accent/60 text-text-dim group-hover:text-accent text-[11px] font-mono flex items-center justify-center shrink-0 transition-colors">+</span>
              </div>
              <div class="text-xs font-semibold text-white mt-1.5">{kpi.label}</div>
            </button>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- 2. VISUAL SHOWCASE: 3D POINT CLOUD + PROMO VIDEO -->
  <section id="visual-showcase" class="py-14 bg-surface/30 border-b border-border">
    <div class="max-w-5xl mx-auto px-6 space-y-10">

      <div>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-5">
          <div>
            <div class="text-xs font-mono text-emerald-300 uppercase tracking-widest mb-1">Live WebGL Scans</div>
            <h2 class="text-2xl font-extrabold text-white tracking-tight">Interactive 3D Understory Point Clouds</h2>
          </div>
          <p class="text-xs text-text-muted">Burlington, MA white pine groves &bull; Drag to orbit</p>
        </div>
        <CutmapLidarViewer client:load />
      </div>

      <div>
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-5">
          <div>
            <div class="text-xs font-mono text-emerald-400 uppercase tracking-widest mb-1">Phase I Overview</div>
            <h3 class="text-xl font-bold text-white tracking-tight">From Calibration Bench to Harvard Forest</h3>
          </div>
          <p class="text-xs text-text-muted">Hardware cart, calibration &amp; GPS-denied traverse</p>
        </div>
        <div class="rounded-2xl border border-border bg-black overflow-hidden shadow-xl">
          <div class="relative aspect-[16/9] bg-black">
            <video playsinline controls preload="metadata" poster="/images/cutmap/cutmap_promo_poster.jpg" class="w-full h-full object-cover">
              <source src="/videos/cutmap/cutmap_phase1_promo.mp4" type="video/mp4" />
              <p class="text-xs text-text-dim p-4">Your browser does not support HTML5 video.</p>
            </video>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. PLATFORM ARCHITECTURE (3 CLICKABLE BUBBLES) -->
  <section id="architecture" class="py-14 bg-background border-b border-border">
    <div class="max-w-5xl mx-auto px-6">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 mb-8">
        <div>
          <div class="text-xs font-mono text-accent uppercase tracking-widest mb-1">Platform Architecture</div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Hardware, Odometry &amp; Calibration</h2>
        </div>
        <span class="text-xs font-mono text-accent">Click any bubble for specs +</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {architectureCards.map(card => (
          <button
            type="button"
            data-modal-id={card.id}
            aria-haspopup="dialog"
            class="bubble-trigger text-left p-6 rounded-2xl bg-surface border border-border hover:border-accent/60 hover:bg-forest-900/50 transition-all cursor-pointer group flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-mono text-accent font-bold uppercase">{card.tag}</span>
                <span class="text-[11px] font-mono text-text-dim group-hover:text-accent transition-colors">Details +</span>
              </div>
              <h3 class="text-lg font-bold text-white mb-3">{card.title}</h3>
