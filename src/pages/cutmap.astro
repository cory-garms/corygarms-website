---
import Layout from "../layouts/Layout.astro";
import CutmapLidarViewer from "../components/CutmapLidarViewer.jsx";
import CutmapPipelineDiagram from "../components/CutmapPipelineDiagram.astro";

// Verified Key Performance Indicators (Section 3 of WEBSITE_UPDATE_GUIDE_20261109.md)
const kpis = [
  {
    value: "~$4,439",
    label: "Sensor & Compute BOM",
    detail: "Phase I list price (Livox Mid-360 + 2× Blackfly + Jetson AGX Orin; $6,297 at Nov 2026 replacement prices)",
    color: "text-accent"
  },
  {
    value: "0.010–0.037 m",
    label: "Marked-Loop Closure / 100 m",
    detail: "17.8 mm over 178 m & 80 mm over 425 m under arboretum canopy (no GPS)",
    color: "text-emerald-400"
  },
  {
    value: "+2.84 ± 1.46 cm",
    label: "Full-Ring DBH (n=42)",
    detail: "RMSE 3.18 cm, R² = 0.984 (1.46 cm spread around outer-bark offset on ≥340° white pine rings)",
    color: "text-cyan-400"
  },
  {
    value: "+3.26 ± 2.53 cm",
    label: "All-View DBH (n=65)",
    detail: "RMSE 4.12 cm, R² = 0.951; partial-arc slope +2.79 cm / 100° missing trunk arc",
    color: "text-amber-300"
  },
  {
    value: "+1.92 ± 3.44 cm",
    label: "Lidar-Gated Camera DBH",
    detail: "Single-view optical silhouette + lidar range (n=52, pooled across both cameras)",
    color: "text-emerald-300"
  },
  {
    value: "87.0% / 93.1%",
    label: "ForestGEO (≥ 10 cm DBH)",
    detail: "87.0% Recall / 93.1% Precision on sealed 12-cell benchmark across 3.26 km Harvard Forest trail network",
    color: "text-accent-light"
  }
];

// Measured Phase I Limitations (Section 4.7 / Slide 11)
const phase1Limitations = [
  {
    num: "01",
    title: "Small-Stem (1–10 cm) Inflation (+14.9 cm) & Under-Detection",
    detail: "354 mapped/ha vs. 1,194 census/ha on 1–10 cm saplings in HF253 (where 2–3 cm lidar beam divergence and range noise inflate small-ring fits). Must be resolved via camera silhouette fusion to support precommercial wildfire fuel thinning and double-sampling variance reduction."
  },
  {
    num: "02",
    title: "Single-Sided Partial-Arc Bias (+2.79 cm / 100° Missing Arc)",
    detail: "Across 65 taped white pine stems, diameter error varied with angular coverage at −2.791 cm per 100° of sweep (R² = 0.273, p = 8.2 × 10⁻⁶). Must be corrected online for single-pass trail and vehicle traverses."
  },
  {
    num: "03",
    title: "Camera-to-Camera Plane Disagreement & 3-Station Scale Gate",
    detail: "13 mm RMS (up to 34.5 mm) inter-camera plane disagreement and the 3-station stereo scale gate (2–4 m) require multi-station scale-gate expansion and hardware-synchronized cameras (<1 ms PTP timing)."
  },
  {
    num: "04",
    title: "Residual Map-Frame Tilt Across Long Traverses",
    detail: "0.6–1.3° residual tilt on 8 of 9 Mount Auburn runs (1.9° on one) requires continuous gravity-constrained trajectory optimization beyond stationary initial levelling."
  }
];

// 4 Partner Teaming Pathways
const teamingTracks = [
  {
    title: "Timberland Managers & Silviculturists",
    summary: "Co-design single-tree stem mapping and two-phase double-sampling workflows tailored for commercial sawtimber thinning and precommercial wildfire fuel reduction."
  },
  {
    title: "Machinery & Autonomous OEMs",
    summary: "Evaluate modular Phase II perception configurations across backpack, ATV, and harvester cab/boom deployments sharing one quick-swap edge computer."
  },
  {
    title: "Federal Co-Funding (Phase II STTR)",
    summary: "Partner with Spectral Sciences, Inc. and the Oregon State University College of Forestry on USDA-NIFA Phase II STTR field validation pilots."
  },
  {
    title: "Commercial Licensing & Research Integration",
    summary: "License multi-sensor calibration diagnostics, lidar-gated optical mensuration pipelines, and OSU MARS Lab heuristic thinning integration."
  }
];

// Presentations & Manuscripts (Section 4.8)
const publications = [
  {
    id: "cutmap-nemo-2026",
    authors: "Garms, C.G. & Strimbu, B.M. (2026)",
    title: "CUTMAP: A Low-SWaP-C Mobile Mapping Platform for Forest Mensuration",
    venue: "2026 Joint Meeting of the Northeastern Mensurationists Organization (NEMO) & Southern Mensurationists (SOMENS), November 10, 2026",
    tag: "Conference Presentation",
    status: "Presented Nov 10, 2026",
    takeaway: "Presents Phase I hardware architecture, calibration failure coupling, 65-stem white pine validation, Mount Auburn grate loop closures, and Harvard Forest (HF253) double-sampling results.",
    bibtex: `@inproceedings{garms2026cutmap_nemo,
  title={CUTMAP: A Low-SWaP-C Mobile Mapping Platform for Forest Mensuration},
  author={Garms, Cory G. and Strimbu, Bogdan M.},
