<script define:vars={{ allModalItems }}>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('bubble-modal');
    const titleEl = document.getElementById('modal-title');
    const subtitleEl = document.getElementById('modal-subtitle');
    const bulletsEl = document.getElementById('modal-bullets');
    const closeBtn = document.getElementById('modal-close');
    const triggers = document.querySelectorAll('.bubble-trigger');

    const itemMap = new Map(allModalItems.map(item => [item.id, item]));

    function openModal(id) {
      const item = itemMap.get(id);
      if (!item || !modal) return;
      titleEl.textContent = item.modalTitle;
      subtitleEl.textContent = item.modalSubtitle;
      bulletsEl.innerHTML = '';
      item.modalBullets.forEach(text => {
        const li = document.createElement('li');
        li.textContent = text;
        bulletsEl.appendChild(li);
      });
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      closeBtn?.focus();
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }

    triggers.forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-modal-id');
        if (id) openModal(id);
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>
