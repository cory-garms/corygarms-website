---
import Layout from "../layouts/Layout.astro";
import CutmapLidarViewer from "../components/CutmapLidarViewer.jsx";

// 6 Core Benchmarks: High-impact metric tiles
const kpiMetrics = [
  {
    value: "~$4,439",
    label: "Sensor & Compute BOM",
    subtext: "Livox Mid-360 + 2× Blackfly + Jetson Orin",
    color: "text-accent"
  },
  {
    value: "0.010–0.037 m",
    label: "Closure / 100 m Walked",
    subtext: "17.8 mm over 178 m & 80 mm over 425 m (no GPS)",
    color: "text-emerald-400"
  },
  {
    value: "+2.84 ± 1.46 cm",
    label: "Full-Ring DBH (n=42)",
    subtext: "R² = 0.984 on ≥340° eastern white pine stems",
    color: "text-cyan-400"
  },
  {
    value: "+3.26 ± 2.53 cm",
    label: "All-View DBH (n=65)",
    subtext: "R² = 0.951; +2.79 cm / 100° missing trunk arc",
    color: "text-amber-300"
  },
  {
    value: "+1.92 ± 3.44 cm",
    label: "Camera DBH (n=52)",
    subtext: "Single-view SAM ViT-B optical silhouette + lidar range",
    color: "text-emerald-300"
  },
  {
    value: "87.0% / 93.1%",
    label: "ForestGEO Recall / Prec.",
    subtext: "Sealed 12-cell benchmark on stems ≥ 10 cm DBH",
    color: "text-accent-light"
  }
];

// Interactive Figure Explorer items (Scientific figures with annotated telemetry)
const figureGallery = [
  {
    id: "fig-stem-maps",
    title: "Burlington 3-Stand Stem Maps",
    badge: "SLAM Trajectories",
    imgSrc: "/images/cutmap/fig_multi_stand_stem_maps.png",
    alt: "Top-down SLAM trajectories and breast-height stem slices across three forest stands in Burlington, MA",
    telemetry: "FAST-LIO2 Trajectory • z = 1.37 m Slice • 65 Taped Stems",
    caption: "Top-down understory SLAM trajectories and gravity-levelled breast-height stem slices across three native eastern white pine stands in Burlington, MA. Zero GPS dependency under closed canopy."
  },
  {
    id: "fig-cart-hardware",
    title: "Field Prototype Cart",
    badge: "Mobile Payload",
    imgSrc: "/images/cutmap_cover_photo.jpg",
    alt: "CUTMAP mobile lidar cart deployed in the forest understory",
    telemetry: "Livox Mid-360 • Dual Blackfly • Jetson AGX Orin • 28.96 MB/s",
    caption: "The CUTMAP mobile cart navigating dense undergrowth. The rigid sensor mast holds the solid-state 3D lidar, dual global-shutter cameras on a 457.2 mm baseline, and onboard edge compute."
  },
  {
    id: "fig-validation",
    title: "Trunk DBH & Partial-Arc Law",
    badge: "Logger's Tape Ground Truth",
    imgSrc: "/images/cutmap/fig7_multi_stand_validation.png",
    alt: "Scatter plots of mobile lidar diameter estimates against physical logger's tape measurements",
    telemetry: "Full Rings: RMSE 3.18 cm • All 65: RMSE 4.12 cm • Coverage Slope: +2.79 cm / 100°",
    caption: "Empirical validation against 65 taped white pine stems. Stems with complete walked rings achieve R² = 0.984 around an outer-bark offset; partial views follow a systematic +2.79 cm expansion per 100° of missing arc."
  },
  {
    id: "fig-sam-optical",
    title: "Optical Bark Segmentation",
    badge: "Lidar-Gated SAM ViT-B",
    imgSrc: "/images/cutmap/fig8_sam_camera_mensuration.png",
    alt: "Segment Anything Model prompt projections isolating trunk boundaries in camera frames",
    telemetry: "SAM ViT-B Prior Prompting • +1.92 ± 3.44 cm (n=52) • 2-Camera Pooled",
    caption: "Single-view optical mensuration bypassing partial-arc circle fitting. 3D lidar trunk priors prompt SAM ViT-B to extract sub-pixel bark silhouettes scaled by direct lidar range."
  },
  {
    id: "fig-corridor",
    title: "Corridor Registration",
    badge: "Loop Closure",
    imgSrc: "/images/cutmap/fig_corridor_registration_alignment.png",
    alt: "Corridor registration and multi-view alignment diagram",
    telemetry: "0.010–0.037 m / 100 m Error • Stationary Gravity Alignment",
    caption: "Multi-traverse point cloud alignment and loop closure. Brief stationary accelerometer alignment constrains coordinate tilt, locking ground elevation spread to 0.05 m over extended traverses."
  }
];

// Interactive 3-Stage Pipeline Architecture Data
const pipelineStages = [
  {
    step: "01",
    id: "pipe-perception",
    name: "Perception & Odometry",
    tag: "Sensor Fusion",
    summary: "Solid-state 3D lidar and 200 Hz IMU tightly coupled in FAST-LIO2, stabilized by stationary gravity levelling.",
    sensors: "Livox Mid-360 (200k pts/s) + 200 Hz IMU + Garmin GLO 2",
    outputMetric: "0.010–0.037 m / 100 m",
    outputLabel: "Marked Loop Closure"
  },
  {
    step: "02",
    id: "pipe-calibration",
    name: "Calibration & Scale Gate",
    tag: "Integrity Verification",
    summary: "External laser-rangefinder scale gate and rigid planar targets preventing focal-extrinsic error propagation.",
    sensors: "Dual FLIR Blackfly (457.2 mm baseline) + Laser Scale Gate",
    outputMetric: "6.6 mm Centering",
    outputLabel: "count² Plane Weighting"
  },
  {
    step: "03",
    id: "pipe-silviculture",
    name: "Silviculture & Prescriptions",
    tag: "Biometrics & Optimization",
    summary: "Extracts individual stem coordinates, DBH, and lean; calibrates stand basal area with two-phase double sampling.",
    sensors: "SAM ViT-B Silhouette Fusion + OSU MARS Heuristic Engine",
    outputMetric: "45.98 m²/ha",
    outputLabel: "Double-Sampled Basal Area"
  }
];

// 3 Field Campaign Cards (Zero lists: clean visual cards with stats)
const fieldCampaigns = [
  {
    name: "Burlington White Pines",
    location: "Burlington, MA",
    badge: "Managed Conifer Stands",
    highlightStat: "+2.84 ± 1.46 cm",
    statLabel: "Full-Ring DBH (n=42)",
    accentColor: "border-cyan-500/40 text-cyan-400",
    desc: "Survey of 65 eastern white pine stems taped at breast height across three native forest groves. Established the fundamental partial-arc coverage slope of +2.79 cm per 100° of missing trunk arc.",
    keyMetrics: [
      { label: "R² Fit", val: "0.984" },
      { label: "RMSE", val: "3.18 cm" },
      { label: "Camera DBH", val: "+1.92 cm" }
    ]
  },
  {
    name: "Mount Auburn Arboretum",
    location: "Cambridge, MA",
    badge: "175-Acre Living Collection",
    highlightStat: "17.8 mm / 178 m",
    statLabel: "Surveyed Grate Closure",
    accentColor: "border-emerald-500/40 text-emerald-400",
    desc: "Mapped 12.0 hectares (29.7 acres) across 9 mobile walks totaling 2,638 m in 44.6 minutes, observing 62% of curated living trees. Marked loops on iron grates closed to 0.010–0.019 m per 100 m.",
    keyMetrics: [
      { label: "Area Mapped", val: "12.0 ha" },
      { label: "425m Loop", val: "80 mm" },
      { label: "Median Error", val: "5.37 cm" }
    ]
  },
  {
    name: "Harvard Forest (HF253)",
    location: "Petersham, MA",
    badge: "Smithsonian ForestGEO",
    highlightStat: "87.0% / 93.1%",
    statLabel: "Recall / Precision (≥10 cm)",
    accentColor: "border-accent/50 text-accent",
    desc: "Traversed 3,264 m of forest trails (17 walks, 779M points, 4.39 ha). Sealed 12-cell benchmark validated two-phase double sampling, recovering stand basal area at 45.98 vs. 47.44 m²/ha census truth.",
    keyMetrics: [
      { label: "Trail Length", val: "3.26 km" },
      { label: "Large Sawtimber", val: "+0.2 cm" },
      { label: "Stand Truth", val: "47.44 m²/ha" }
    ]
  }
];

// Broad Sector Capabilities (Icon/Diagram cards, zero bullets)
const capabilities = [
  {
    title: "Precision Silviculture",
    role: "Single-Tree Thinning",
    summary: "Maps individual stems and competition geometry to drive automated single-tree cut/leave prescriptions for sawtimber yield.",
    badge: "Commercial Forestry"
  },
  {
    title: "Wildfire Fuel Mitigation",
    role: "Ladder Fuel Density",
    summary: "Quantifies understory ladder-fuel volume below dense canopy cover where airborne laser scanning cannot penetrate.",
    badge: "Precommercial Thinning"
  },
  {
    title: "Urban & Agricultural",
    role: "GNSS-Denied Audits",
    summary: "Provides centimeter-level walk-speed mapping under dense street tree canopies, botanical arboretums, and high-value fruit orchards.",
    badge: "Phenotyping & Inventories"
  },
  {
    title: "Modular Autonomy",
    role: "Multi-Platform Deployment",
    summary: "Engineered around a quick-swap edge compute core ready for backpack, ATV, forwarder, and harvester boom integration.",
    badge: "Robotic Perception"
  }
];

// Scholarly Output
const publications = [
  {
    title: "CUTMAP: A Low-SWaP-C Mobile Mapping Platform for Forest Mensuration",
    authors: "Garms, C.G. & Strimbu, B.M. (2026)",
    venue: "2026 Joint Meeting of NEMO & SOMENS (Presented Nov 10, 2026)",
    status: "Conference Presentation"
  },
  {
    title: "Calibrating a Low-SWaP-C Lidar–Stereo Platform: Staged Procedures, Failure Coupling, and Operational Validation",
    authors: "Garms, C.G., Strimbu, B.M., et al. (2026)",
    venue: "Target: Journal of Field Robotics",
    status: "In Preparation"
  },
  {
    title: "Impact of stem lean on estimation of Douglas-fir diameter and volume using mobile lidar scans",
    authors: "Garms, C.G. & Strimbu, B.M. (2021)",
    venue: "Canadian Journal of Forest Research, 51(8), 1117–1130",
    status: "Published",
    doi: "https://doi.org/10.1139/cjfr-2020-0082"
  }
];
---

<Layout 
  title="CUTMAP | Low-SWaP-C Mobile Lidar–Stereo Mapping Platform"
  description="CUTMAP: A low-SWaP-C (~$4,439 Phase I BOM) mobile lidar-stereo platform for GPS-denied forest mensuration, thinning prescriptions, and outdoor mapping. USDA-NIFA STTR Phase I (#2025-70436-44908)."
  image="/images/cutmap_cover_photo.jpg"
>

  <!-- 1. HERO SECTION & CORE VALUE HOOK -->
  <section class="relative pt-10 pb-12 overflow-hidden border-b border-border">
    <div class="absolute inset-0 bg-gradient-to-b from-forest-950 via-background to-background pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-6 relative z-10 space-y-8">

      <!-- Teaming & Award Ribbon -->
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-2.5">
          <a 
            href="https://www.spectral.com" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 bg-white hover:bg-slate-100 px-3.5 py-1.5 rounded-xl shadow border border-border/40 transition-all"
          >
            <img src="/images/SSI_LOGO-transparent.png" alt="Spectral Sciences, Inc." class="h-5 sm:h-6 w-auto object-contain" />
            <span class="text-xs font-mono text-slate-800 font-bold border-l border-slate-300 pl-2.5 hidden sm:inline">Spectral Sciences, Inc.</span>
          </a>
          <a 
            href="https://forestry.oregonstate.edu" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-surface hover:bg-forest-900 px-3 py-1.5 rounded-xl border border-border/60 hover:border-[#D73F09]/60 transition-all"
          >
            <span class="w-5 h-5 rounded bg-[#D73F09]/15 border border-[#D73F09]/40 flex items-center justify-center text-[#D73F09] font-black text-[10px] font-mono">OSU</span>
            <span class="text-xs font-semibold text-white">Oregon State University</span>
          </a>
        </div>

        <a 
          href="https://www.nifa.usda.gov/about-nifa/award-announcements/nifa-invests-20m-spur-small-business-led-innovation"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/50 text-[11px] font-mono text-emerald-300"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>USDA-NIFA STTR #2025-70436-44908</span>
        </a>
      </div>

      <!-- Main Headline & Narrative Thesis (Short, cohesive, zero bullets) -->
      <div class="space-y-4 max-w-4xl">
        <div class="text-xs font-mono text-accent uppercase tracking-widest font-semibold">
          CUTMAP &bull; Comprehensive Utility for Thinning Mechanically via Automated Prescription
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-[1.1]">
          Low-SWaP-C Mobile Lidar–Stereo Mapping for Forestry &amp; Beyond
        </h1>
        <p class="text-base sm:text-xl text-emerald-300 font-medium leading-relaxed">
          Tightly coupled solid-state 3D lidar, 200 Hz inertial odometry, and calibrated stereo vision (~$4,439 BOM) mapping understory stems at walking speed with zero satellite dependence.
        </p>
        <p class="text-sm sm:text-base text-text-muted leading-relaxed">
          Forest thinning decisions are made one tree at a time, but commercial laser scanners remain cost-prohibitive. Developed by Spectral Sciences, Inc. and Oregon State University, CUTMAP bridges low-cost edge sensors with automated silvicultural prescriptions—generalizing across timberland management, wildfire fuel mapping, urban tree inventories, and off-road robotics.
        </p>

        <!-- Action Pills -->
        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a href="#interactive-3d" class="px-5 py-2.5 rounded-xl bg-accent hover:bg-accent-light text-forest-950 font-bold text-xs font-mono transition-all">
            Interactive 3D Point Cloud
          </a>
          <a href="#figure-explorer" class="px-5 py-2.5 rounded-xl bg-surface hover:bg-forest-850 text-white border border-border text-xs font-mono transition-all">
            Scientific Data Explorer
          </a>
          <a href="#pipeline" class="px-5 py-2.5 rounded-xl bg-surface hover:bg-forest-850 text-white border border-border text-xs font-mono transition-all">
            System Architecture
          </a>
          <a href="#teaming" class="px-5 py-2.5 rounded-xl bg-forest-900/80 hover:bg-forest-800 text-text-muted hover:text-white border border-border text-xs font-mono transition-all">
            Phase II Teaming
          </a>
        </div>
      </div>

      <!-- 6 Key Performance Metric Tiles -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-3.5 sm:gap-4 pt-2">
        {kpiMetrics.map(kpi => (
          <div class="p-4 sm:p-5 rounded-2xl bg-surface/90 border border-border hover:border-accent/40 transition-all flex flex-col justify-between shadow-sm">
            <div>
              <div class={`text-xl sm:text-2xl font-black font-mono ${kpi.color} tracking-tight`}>
                {kpi.value}
              </div>
              <div class="text-xs font-bold text-white mt-1">
                {kpi.label}
              </div>
            </div>
            <div class="text-[11px] text-text-dim mt-2 pt-2 border-t border-border/50 leading-snug">
              {kpi.subtext}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 2. INTERACTIVE 3D POINT CLOUD TOOL -->
  <section id="interactive-3d" class="py-14 bg-surface/30 border-b border-border">
    <div class="max-w-5xl mx-auto px-6 space-y-6">

      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="text-xs font-mono text-emerald-300 uppercase tracking-widest mb-1">Interactive 3D WebGL Tool</div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Real-Time Understory Point Clouds</h2>
        </div>
        <p class="text-xs sm:text-sm text-text-muted max-w-sm">
          Drag to orbit the 3D conifer stands mapped with Livox Mid-360 lidar-inertial odometry. Use controls to switch stands or elevation shading.
        </p>
      </div>

      <!-- WebGL Interactive Viewer -->
      <CutmapLidarViewer client:load />

    </div>
  </section>

  <!-- 3. INTERACTIVE SCIENTIFIC FIGURE EXPLORER -->
  <section id="figure-explorer" class="py-14 bg-background border-b border-border">
    <div class="max-w-5xl mx-auto px-6 space-y-6">

      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="text-xs font-mono text-accent uppercase tracking-widest mb-1">Empirical Evidence</div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Interactive Scientific Data Explorer</h2>
        </div>
        <div class="text-xs font-mono text-text-dim">
          Click tabs below to inspect verified field data &amp; hardware figures
        </div>
      </div>

      <!-- Figure Viewer Container -->
      <div class="rounded-2xl border border-border bg-surface overflow-hidden shadow-2xl">
        
        <!-- Tab Navigation Bar -->
        <div class="flex flex-wrap items-center gap-1.5 p-2 bg-forest-950 border-b border-border/80 text-xs font-mono" id="figure-tabs">
          {figureGallery.map((fig, idx) => (
            <button
              type="button"
              data-fig-index={idx}
              class={`fig-tab-btn px-3 py-1.5 rounded-xl transition-all cursor-pointer flex items-center gap-2 ${
                idx === 0 
                  ? 'bg-accent/15 text-accent border border-accent/40 font-bold' 
                  : 'text-text-muted hover:text-white hover:bg-forest-900 border border-transparent'
              }`}
            >
              <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
              <span>{fig.title}</span>
            </button>
          ))}
        </div>

        <!-- Dynamic Image Display Canvas -->
        <div class="relative bg-black aspect-[16/9] sm:aspect-[21/9] flex items-center justify-center p-2 sm:p-4 overflow-hidden">
          <img 
            id="active-fig-img"
            src={figureGallery[0].imgSrc} 
            alt={figureGallery[0].alt}
            class="max-w-full max-h-full object-contain transition-all duration-300"
          />
          
          <!-- Floating Telemetry Overlay -->
          <div class="absolute bottom-3 left-3 right-3 sm:right-auto px-3.5 py-1.5 rounded-xl bg-forest-950/90 border border-border/80 backdrop-blur-md text-[11px] font-mono text-emerald-300 flex items-center gap-2 shadow-lg">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            <span id="active-fig-telemetry">{figureGallery[0].telemetry}</span>
          </div>
        </div>

        <!-- Descriptive Caption Bar -->
        <div class="p-4 sm:p-5 bg-surface border-t border-border flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
          <p id="active-fig-caption" class="text-text-muted leading-relaxed max-w-3xl">
            {figureGallery[0].caption}
          </p>
          <span id="active-fig-badge" class="px-2.5 py-1 rounded-lg bg-forest-900 border border-border text-[11px] font-mono text-accent whitespace-nowrap self-start sm:self-auto">
            {figureGallery[0].badge}
          </span>
        </div>

      </div>

    </div>
  </section>

  <!-- 4. VISUAL PIPELINE & SYSTEM ARCHITECTURE DIAGRAM -->
  <section id="pipeline" class="py-14 bg-surface/30 border-b border-border">
    <div class="max-w-5xl mx-auto px-6 space-y-8">

      <div class="max-w-3xl">
        <div class="text-xs font-mono text-accent uppercase tracking-widest mb-1">System Architecture</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Three-Stage Computational Flow
        </h2>
        <p class="text-xs sm:text-sm text-text-muted mt-2">
          From high-rate spatial photon returns to certified single-tree harvest prescriptions. Click any stage to inspect the pipeline flow.
        </p>
      </div>

      <!-- 3-Stage Interactive Stepper Diagram -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4" id="pipeline-stepper">
        {pipelineStages.map((stage, idx) => (
          <div 
            class={`pipe-stage-card p-5 rounded-2xl bg-surface border transition-all cursor-pointer flex flex-col justify-between ${
              idx === 0 ? 'border-accent shadow-lg shadow-accent/5' : 'border-border hover:border-accent/40'
            }`}
            data-stage-idx={idx}
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-mono text-accent font-bold">STAGE {stage.step}</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-forest-950 border border-border text-text-dim uppercase">
                  {stage.tag}
                </span>
              </div>
              <h3 class="text-base font-bold text-white mb-2">{stage.name}</h3>
              <p class="text-xs text-text-muted leading-relaxed">{stage.summary}</p>
            </div>

            <div class="mt-4 pt-3 border-t border-border/60 flex items-center justify-between text-xs font-mono">
              <span class="text-text-dim text-[11px]">{stage.outputLabel}:</span>
              <span class="text-accent font-bold">{stage.outputMetric}</span>
            </div>
          </div>
        ))}
      </div>

      <!-- Active Stage Schematic Panel -->
      <div class="p-6 rounded-2xl bg-forest-950 border border-border flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl">
        <div class="space-y-1.5">
          <div class="text-[11px] font-mono text-accent uppercase tracking-wider font-semibold">Active Hardware &amp; Algorithmic Path</div>
          <div id="pipe-detail-sensors" class="text-sm font-mono text-white font-bold">
            {pipelineStages[0].sensors}
          </div>
          <p id="pipe-detail-summary" class="text-xs text-text-muted max-w-2xl leading-relaxed">
            {pipelineStages[0].summary}
          </p>
        </div>
        <div class="px-4 py-2.5 rounded-xl bg-surface border border-accent/40 text-center shrink-0">
          <div id="pipe-detail-metric" class="text-lg font-mono font-black text-accent">{pipelineStages[0].outputMetric}</div>
          <div id="pipe-detail-label" class="text-[10px] font-mono text-text-dim uppercase">{pipelineStages[0].outputLabel}</div>
        </div>
      </div>

    </div>
  </section>

  <!-- 5. FIELD CAMPAIGN VALIDATION CARDS (Visual Cards, Zero Lists) -->
  <section id="campaigns" class="py-14 bg-background border-b border-border">
    <div class="max-w-5xl mx-auto px-6 space-y-8">

      <div class="max-w-3xl">
        <div class="text-xs font-mono text-accent uppercase tracking-widest mb-1">Operational Validation</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Three Field Campaigns
        </h2>
        <p class="text-xs sm:text-sm text-text-muted mt-2">
          Rigorous field evaluations spanning managed conifer groves, urban arboretums, and natural mixed-species research plots.
        </p>
      </div>

      <!-- 3 Rich Campaign Cards with Micro-Metrics -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {fieldCampaigns.map(camp => (
          <div class={`p-6 rounded-2xl bg-surface border ${camp.accentColor} flex flex-col justify-between shadow-lg`}>
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="text-xs font-mono font-bold uppercase">{camp.location}</span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-forest-950 border border-border text-text-dim">
                  {camp.badge}
                </span>
              </div>
              <h3 class="text-lg font-bold text-white mb-2">{camp.name}</h3>
              <p class="text-xs text-text-muted leading-relaxed mb-4">{camp.desc}</p>
            </div>

            <div class="space-y-3 pt-3 border-t border-border/60">
              <div class="flex items-center justify-between text-xs font-mono">
                <span class="text-text-dim text-[11px]">{camp.statLabel}:</span>
                <span class="text-white font-bold">{camp.highlightStat}</span>
              </div>
              <div class="grid grid-cols-3 gap-2 p-2 rounded-xl bg-forest-950 border border-border/70 text-center text-xs font-mono">
                {camp.keyMetrics.map(m => (
                  <div>
                    <div class="text-accent font-bold text-[11px]">{m.val}</div>
                    <div class="text-[10px] text-text-dim">{m.label}</div>
