---
import Layout from "../layouts/Layout.astro";
import CutmapLidarViewer from "../components/CutmapLidarViewer.jsx";

// Key Performance Numbers: Simple, bold, high-contrast
const kpis = [
  {
    value: "~$2,200",
    label: "Hardware Payload Cost",
    detail: "25× cheaper than $50k–$100k commercial MLS rigs",
    color: "text-accent"
  },
  {
    value: "80 mm",
    label: "Canopy Drift over 425 m",
    detail: "Zero GPS required under dense closed canopy",
    color: "text-emerald-400"
  },
  {
    value: "98.6%",
    label: "Field Tree Tally Recall",
    detail: "73 of 74 trees confirmed across 3 native stands",
    color: "text-cyan-400"
  },
  {
    value: "R² = 0.98",
    label: "Logger's Tape Accuracy",
    detail: "Validated against physical diameter tape (RMSE 3.1 cm)",
    color: "text-amber-300"
  },
  {
    value: "< 5 sec",
    label: "Stand Compute Turnaround",
    detail: "Instant real-time edge processing on Jetson AGX Orin",
    color: "text-emerald-300"
  },
  {
    value: "< $5 / acre",
    label: "Estimated Survey Cost",
    detail: "100% census vs. $25+/acre for 5% manual sampling",
    color: "text-accent-light"
  }
];

// 3 Simple How It Works Steps
const howItWorks = [
  {
    step: "01",
    title: "Traverse Without GPS",
    desc: "A forester, UTV, or robotic rover rolls the low-cost sensor cart through the stand. Real-time LiDAR-inertial SLAM maps the terrain with zero satellite dependency."
  },
  {
    step: "02",
    title: "Automatic Breast-Height Slicing",
    desc: "Onboard algorithms calculate ground elevation under the cart, isolating a thin LiDAR slice at exact 1.37 m breast height while ignoring low brush and ground clutter."
  },
  {
    step: "03",
    title: "Instant Digital Inventory",
    desc: "In under 5 seconds per stand, cylinders lock onto individual trees, outputting exact diameters, stem coordinates, and GIS-ready shapefiles for immediate analysis."
  }
];

// 4 Simple Partner Tracks
const teamingTracks = [
  {
    title: "Timberland Managers & TIMOs",
    summary: "Replace slow, expensive 5% manual cruise samples with continuous 100% stem census data (<$5/acre) ready for ArcGIS, Remsoft, and carbon registries."
  },
  {
    title: "Machinery & Autonomous OEMs",
    summary: "Integrate a compact, low-power (<40W) perception payload into harvester cabs, forwarders, tracked rovers, or quadruped scouts."
  },
  {
    title: "Federal Co-Funding (Phase II STTR)",
    summary: "Partner on upcoming USDA-NIFA Phase II STTR grants to co-develop customized sensor packaging and regional timberland validation at low financial risk."
  },
  {
    title: "Commercial Licensing & Exclusivity",
    summary: "Secure preferential commercial licensing terms and territory rights for Spectral Sciences' proprietary multi-sensor calibration and forest AI stack."
  }
];

// Publications & Academic Disclosures
const publications = [
  {
    id: "cutmap-calibration-2026",
    authors: "Garms, C.G., Strimbu, B., et al. (2026)",
    title: "Calibrating a Low-SWaP-C Lidar–Stereo Platform: Staged Procedures, Failure Coupling, and Operational Validation",
    venue: "Target: Journal of Field Robotics (In Final Preparation)",
    tag: "Primary Methodological Paper",
    status: "In Final Preparation",
    takeaway: "Demonstrates how multi-sensor calibration integrity achieves sub-millimeter precision from low-cost solid-state perception.",
    bibtex: `@article{garms2026cutmap_calibration,
  title={Calibrating a Low-SWaP-C Lidar--Stereo Platform: Staged Procedures, Failure Coupling, and Operational Validation},
  author={Garms, Cory G. and Strimbu, Bogdan M. and others},
  journal={Journal of Field Robotics},
  year={2026}
}`
  },
  {
    id: "cutmap-nemo-2026",
    authors: "Garms, C.G., Strimbu, B., et al. (2026)",
    title: "CUTMAP: A Low-SWaP-C Mobile Mapping Platform for Forest Mensuration: Calibration Integrity, Sensor Fusion, and Ground-Truth Prototyping",
    venue: "2026 Joint Meeting of the Northeastern Mensurationist Organization (NEMO) & Southern Mensurationists (SOMENS), Portland, ME",
    tag: "Conference Proceeding",
    status: "Accepted / Invited",
    takeaway: "Field validation against 65 logger's-tape stems across native forest stands in Burlington, MA.",
    bibtex: `@inproceedings{garms2026cutmap_nemo,
  title={CUTMAP: A Low-SWaP-C Mobile Mapping Platform for Forest Mensuration: Calibration Integrity, Sensor Fusion, and Ground-Truth Prototyping},
  author={Garms, Cory G. and Strimbu, Bogdan M. and others},
  booktitle={2026 Joint Meeting of NEMO & SOMENS},
  year={2026}
}`
  },
  {
    id: "garms-stemlean-2021",
    authors: "Garms, C.G. & Strimbu, B. (2021)",
    title: "Impact of stem lean on estimation of Douglas-fir diameter and volume using mobile lidar scans",
    venue: "Canadian Journal of Forest Research, 51(8), 1184–1195",
    tag: "Foundational Lean Research",
    status: "Published",
    doi: "https://doi.org/10.1139/cjfr-2020-0082",
    takeaway: "Formulates non-destructive 3D cylinder fitting to eliminate systemic bias in merchantable volume calculations.",
    bibtex: `@article{garms2021stemlean,
  title={Impact of stem lean on estimation of Douglas-fir diameter and volume using mobile lidar scans},
  author={Garms, Cory G. and Strimbu, Bogdan M.},
  journal={Canadian Journal of Forest Research},
  volume={51},
  number={8},
  pages={1184--1195},
  year={2021}
}`
  }
];
---

<Layout 
  title="CUTMAP: Autonomous Forest Mensuration | Cory Glenn Garms, Ph.D."
  description="CUTMAP: a low-SWaP-C ($2,200) autonomous under-canopy perception payload delivering sub-centimeter forest biometrics, zero-GPS canopy navigation, and real-time edge processing."
>

  <!-- SECTION 1: HERO -->
  <section class="relative pt-12 pb-16 overflow-hidden border-b border-border">
    <div class="absolute inset-0 bg-gradient-to-b from-forest-950 via-background to-background pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-6 relative z-10">

      <!-- Sponsor & Company Bar -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <a 
          href="https://www.spectral.com" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-white hover:bg-slate-100 px-4 py-2 rounded-xl shadow-md border border-border/40 transition-all group"
          title="Visit Spectral Sciences, Inc. Official Website"
        >
          <img 
            src="/images/SSI_LOGO-transparent.png" 
            alt="Spectral Sciences, Inc. Logo" 
            class="h-6 sm:h-7 w-auto object-contain" 
          />
          <span class="text-xs font-mono text-slate-800 font-bold tracking-tight border-l border-slate-300 pl-3 hidden sm:inline">
            Spectral Sciences, Inc.
          </span>
        </a>

        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-forest-900 border border-emerald-500/40 text-xs font-mono text-emerald-300 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>USDA-NIFA SBIR/STTR Phase II Opportunity</span>
        </div>
      </div>

      <!-- Main Headline & Value Proposition -->
      <div class="space-y-6">
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-white tracking-tight leading-[1.1]">
          Real-Time Forest Inventory from a $2,200 Sensor Payload
        </h1>

        <p class="text-lg sm:text-xl text-emerald-300 font-medium leading-relaxed max-w-3xl">
          Replacing $100,000 LiDAR rigs with an automated mobile perception cart that maps 100% of trees under dense canopy with zero GPS.
        </p>

        <p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-3xl">
          Traditional forest inventory relies on slow manual calipers or expensive laser scanners. <strong class="text-white">CUTMAP</strong> pairs a solid-state LiDAR and stereo cameras with edge AI on an NVIDIA Jetson—measuring tree diameters with sub-centimeter accuracy in seconds.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <a 
            href="#teaming-partnership" 
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-accent hover:bg-accent-light text-forest-950 font-bold text-sm font-mono transition-all shadow-lg hover:shadow-emerald-500/20 cursor-pointer"
          >
            <span>Partner With Us on Phase II</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a 
            href="#interactive-3d-viewer" 
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-surface hover:bg-forest-850 text-white border border-border hover:border-accent/40 font-semibold text-sm font-mono transition-all cursor-pointer"
          >
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            <span>Interactive 3D Point Cloud</span>
          </a>

          <a 
            href="#video-demo" 
            class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl bg-forest-900/80 hover:bg-forest-800 text-text-muted hover:text-white border border-border text-sm font-mono transition-all"
          >
            <span>Watch Live Video Demo</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- SECTION 2: INTERACTIVE 3D LIDAR STAND VIEWER (FRONT & CENTER VISUAL HOOK) -->
  <section id="interactive-3d-viewer" class="py-16 bg-surface/30 border-b border-border">
    <div class="max-w-5xl mx-auto px-6">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
        <div>
          <div class="text-xs font-mono text-emerald-300 uppercase tracking-widest mb-1">Live WebGL Visualization</div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Interactive 3D Understory Scans</h2>
        </div>
        <p class="text-xs sm:text-sm text-text-muted max-w-md">
          Drag to spin the 3D trees. Use the top buttons to switch between stands or toggle the elevation height colormap.
        </p>
      </div>

      <!-- Clean Embedded 3D Viewer -->
      <CutmapLidarViewer client:load />

    </div>
  </section>

  <!-- SECTION 3: 6 KEY NUMBERS (BIG, BOLD, SCANNABLE) -->
  <section class="py-16 bg-background border-b border-border">
    <div class="max-w-5xl mx-auto px-6">
      
      <div class="text-center max-w-2xl mx-auto mb-10">
        <div class="text-xs font-mono text-accent uppercase tracking-widest mb-1">Operational Benchmarks</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">The Numbers at a Glance</h2>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6">
        {kpis.map(kpi => (
          <div class="p-5 sm:p-6 rounded-2xl bg-surface border border-border hover:border-accent/40 transition-all flex flex-col justify-between">
            <div>
              <div class={`text-2xl sm:text-4xl font-black font-mono ${kpi.color} mb-2 tracking-tight`}>
                {kpi.value}
              </div>
              <div class="text-xs sm:text-sm font-bold text-white mb-1">
                {kpi.label}
              </div>
            </div>
            <div class="text-[11px] sm:text-xs text-text-muted mt-2 pt-2 border-t border-border/60 leading-snug">
              {kpi.detail}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- SECTION 4: HOW IT WORKS (SIMPLE & CLEAR 3-STEP CONCEPT) -->
  <section class="py-16 bg-surface/30 border-b border-border">
    <div class="max-w-5xl mx-auto px-6">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="text-xs font-mono text-accent uppercase tracking-widest mb-1">Simple Concept</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">How CUTMAP Works in the Field</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {howItWorks.map(item => (
          <div class="p-6 rounded-2xl bg-surface border border-border flex flex-col justify-between hover:border-accent/40 transition-all">
            <div>
              <div class="text-2xl font-mono font-black text-accent mb-3">{item.step}</div>
              <h3 class="text-lg font-bold text-white mb-2">{item.title}</h3>
              <p class="text-xs sm:text-sm text-text-muted leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- SECTION 5: LIVE VIDEO DEMO (CLEAN PLAYER, NO SCATTER PLOTS) -->
  <section id="video-demo" class="py-16 bg-background border-b border-border">
    <div class="max-w-5xl mx-auto px-6">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
        <div>
          <div class="text-xs font-mono text-cyan-300 uppercase tracking-widest mb-1">Operational Proof of Concept</div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Real-Time Edge Perception in Action</h2>
        </div>
        <p class="text-xs sm:text-sm text-text-muted max-w-md">
          Direct screen capture from the onboard NVIDIA Jetson AGX Orin. Watch 17 tree cylinders lock in 3.9 seconds as the cart traverses a native pine stand.
        </p>
      </div>

      <!-- Clean Video Player Container (NO matplotlib poster) -->
      <div class="rounded-3xl border border-border bg-black overflow-hidden shadow-2xl">
        <div class="relative aspect-[16/9] bg-black">
          <video 
            playsinline 
            autoplay 
            muted 
            loop 
            controls
            preload="auto"
            poster="/images/cutmap/rapid_mensuration_poster.jpg"
            class="w-full h-full object-cover"
          >
            <source src="/videos/cutmap/rapid_mensuration_live_demo.mp4" type="video/mp4" />
            <source src="/videos/cutmap/rapid_mensuration_live_demo.webm" type="video/webm" />
            <p class="text-xs text-text-dim p-4">Your browser does not support HTML5 video.</p>
          </video>
        </div>

        <div class="p-5 bg-forest-950 flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-text-muted">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent"></span>
            <span class="text-white font-semibold">Native Pine Stand Traverse:</span>
            <span>3.94s stand turnaround &bull; 95.4% point volume reduction &bull; ±2.0 cm accuracy target: PASS</span>
          </div>
          <a 
            href="#teaming-partnership" 
            class="text-accent hover:text-accent-light transition-colors font-bold"
          >
            Explore Teaming Options &rarr;
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- SECTION 6: 4 PARTNER TEAMING PATHWAYS -->
  <section id="teaming-partnership" class="py-16 bg-forest-950 border-b border-border">
    <div class="max-w-5xl mx-auto px-6">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <div class="text-xs font-mono text-accent uppercase tracking-widest mb-1">Commercialization Hub</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Four Ways to Team With Us</h2>
        <p class="text-xs sm:text-sm text-text-muted mt-2">
          Spectral Sciences, Inc. is actively structuring Phase II teaming agreements for joint field pilots and commercial licensing.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
        {teamingTracks.map((track, idx) => (
          <div class="p-6 rounded-2xl bg-surface border border-border hover:border-accent/40 transition-all flex flex-col justify-between shadow-lg">
            <div>
              <div class="text-xs font-mono text-accent font-bold mb-2">Track 0{idx + 1}</div>
              <h3 class="text-lg sm:text-xl font-bold text-white mb-2">{track.title}</h3>
              <p class="text-xs sm:text-sm text-text-muted leading-relaxed">{track.summary}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Direct Teaming Email Banner -->
      <div class="p-6 sm:p-8 rounded-2xl bg-surface border border-accent/40 shadow-xl flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h3 class="text-lg font-bold text-white mb-1">Discuss a Phase II Field Pilot</h3>
          <p class="text-xs sm:text-sm text-text-muted">Connect directly with Principal Investigator Dr. Cory Glenn Garms.</p>
        </div>
        <a 
          href="mailto:cgarms@spectral.com?subject=CUTMAP%20Phase%20II%20Commercialization%20Teaming%20Inquiry"
          class="px-6 py-3 rounded-xl bg-accent hover:bg-accent-light text-forest-950 font-bold text-xs sm:text-sm font-mono transition-all shadow-md whitespace-nowrap cursor-pointer"
        >
          Email: cgarms@spectral.com &rarr;
        </a>
      </div>

    </div>
  </section>

  <!-- SECTION 7: PUBLICATIONS -->
  <section class="py-16 bg-surface/30 border-b border-border">
    <div class="max-w-5xl mx-auto px-6">
      
      <div class="mb-8">
        <div class="text-xs font-mono text-accent uppercase tracking-widest mb-1">Scientific Backing</div>
        <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">Peer-Reviewed Publications</h2>
      </div>

      <div class="space-y-4">
        {publications.map(pub => (
          <div class="p-5 rounded-xl bg-surface border border-border hover:border-accent/40 transition-all">
            <div class="flex items-center justify-between gap-2 mb-1">
              <span class="text-xs font-mono text-accent font-semibold">{pub.tag}</span>
              <span class="text-xs font-mono text-text-dim">{pub.status}</span>
            </div>
            <h3 class="text-sm sm:text-base font-bold text-white mb-1">{pub.title}</h3>
            <div class="text-xs text-text-muted mb-2 font-mono">
              {pub.authors} &bull; <span class="italic text-text-main">{pub.venue}</span>
            </div>
            <p class="text-xs text-text-muted leading-relaxed mb-2">{pub.takeaway}</p>
            {pub.doi && (
              <a 
                href={pub.doi} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-xs font-mono text-accent hover:underline inline-flex items-center gap-1"
              >
                <span>Read paper &rarr;</span>
              </a>
            )}
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- SECTION 8: EXECUTIVE CONTACT & FOOTER -->
  <section class="py-16 bg-forest-950">
    <div class="max-w-5xl mx-auto px-6">
      <div class="p-8 rounded-2xl bg-surface border border-border flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="space-y-1">
          <div class="text-white font-bold text-base">Dr. Cory Glenn Garms</div>
          <div class="text-xs font-mono text-accent">Senior Scientist & CUTMAP Principal Investigator</div>
          <div class="text-xs text-text-dim">Spectral Sciences, Inc. &bull; Burlington, MA</div>
        </div>

        <div class="flex items-center gap-4">
          <a 
            href="mailto:cgarms@spectral.com?subject=CUTMAP%20Phase%20II%20Commercialization%20Teaming%20Inquiry"
            class="px-5 py-2.5 rounded-xl bg-accent hover:bg-accent-light text-forest-950 font-bold text-xs font-mono transition-all shadow-md"
          >
            cgarms@spectral.com
          </a>
          <a 
            href="https://www.spectral.com" 
            target="_blank" 
            rel="noopener noreferrer"
            class="text-xs font-mono text-text-dim hover:text-white transition-colors"
          >
            spectral.com &rarr;
          </a>
        </div>
      </div>

      <div class="mt-6 text-center text-xs font-mono text-text-dim">
        Sponsored by <strong class="text-white">USDA-NIFA</strong> under the SBIR/STTR Program. Proprietary Technology &copy; 2026 Spectral Sciences, Inc.
      </div>
    </div>
  </section>

</Layout>
