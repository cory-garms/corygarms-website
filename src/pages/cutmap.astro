---
import Layout from "../layouts/Layout.astro";
import CutmapLidarViewer from "../components/CutmapLidarViewer.jsx";
import CutmapPipelineDiagram from "../components/CutmapPipelineDiagram.astro";

// Publication references with full BibTeX and DOIs
const publications = [
  {
    id: "cutmap-calibration-2026",
    authors: "Garms, C.G., Strimbu, B., et al. (2026)",
    title: "Calibrating a Low-SWaP-C Lidar–Stereo Platform: Staged Procedures, Failure Coupling, and Operational Validation",
    venue: "Target: Journal of Field Robotics (In Final Preparation)",
    tag: "Primary Methodological Paper",
    status: "In Final Preparation",
    takeaway: "Exposes how standard scale-invariant reprojection metrics (0.31 px RMS) remain blind to 2.5 mm target curvature, propagating into 140 mm phantom extrinsic shifts. Introduces three physical calibration gates that condition the weak axis and restore sub-millimeter precision.",
    bibtex: `@article{garms2026cutmap_calibration,
  title={Calibrating a Low-SWaP-C Lidar--Stereo Platform: Staged Procedures, Failure Coupling, and Operational Validation},
  author={Garms, Cory G. and Strimbu, Bogdan M. and others},
  journal={Journal of Field Robotics},
  year={2026},
  note={In Final Preparation}
}`
  },
  {
    id: "cutmap-nemo-2026",
    authors: "Garms, C.G., Strimbu, B., et al. (2026)",
    title: "CUTMAP: A Low-SWaP-C Mobile Mapping Platform for Forest Mensuration: Calibration Integrity, Sensor Fusion, and Ground-Truth Prototyping",
    venue: "2026 Joint Meeting of the Northeastern Mensurationist Organization (NEMO) & Southern Mensurationists (SOMENS), Portland, ME",
    tag: "Conference Proceeding",
    status: "Accepted / Invited",
    takeaway: "Presents the field-deployed all-terrain push-cart, FAST-LIO2 understory loop trajectories, and empirical validation against 65 taped stems across white pine and hardwood groves in Burlington, MA.",
    bibtex: `@inproceedings{garms2026cutmap_nemo,
  title={CUTMAP: A Low-SWaP-C Mobile Mapping Platform for Forest Mensuration: Calibration Integrity, Sensor Fusion, and Ground-Truth Prototyping},
  author={Garms, Cory G. and Strimbu, Bogdan M. and others},
  booktitle={2026 Joint Meeting of the Northeastern Mensurationist Organization (NEMO) and Southern Mensurationists (SOMENS)},
  address={Portland, ME},
  year={2026}
}`
  },
  {
    id: "west-thinning-2021",
    authors: "West, T., Sessions, J., & Strimbu, B.M. (2021)",
    title: "Heuristic Optimization of Thinning Individual Douglas-Fir",
    venue: "Forests, 12(3), 280",
    tag: "Foundational Thinning Algorithm",
    status: "Published (Peer-Reviewed)",
    doi: "https://doi.org/10.3390/f12030280",
    takeaway: "Establishes the combinatorial 'Hero' and Monte Carlo heuristic optimization models integrated into CUTMAP Stage 3. Evaluates thinning interventions based on spatial competition indices, increasing Land Expectation Value (LEV) by +5.1% to 10.1%.",
    bibtex: `@article{west2021heuristic_thinning,
  title={Heuristic Optimization of Thinning Individual Douglas-Fir},
  author={West, Todd and Sessions, John and Strimbu, Bogdan M.},
  journal={Forests},
  volume={12},
  number={3},
  pages={280},
  year={2021},
  publisher={MDPI},
  doi={10.3390/f12030280}
}`
  },
  {
    id: "garms-stemlean-2021",
    authors: "Garms, C.G. & Strimbu, B. (2021)",
    title: "Impact of stem lean on estimation of Douglas-fir diameter and volume using mobile lidar scans",
    venue: "Canadian Journal of Forest Research, 51(8), 1184–1195",
    tag: "Foundational Lean Research",
    status: "Published (Peer-Reviewed)",
    doi: "https://doi.org/10.1139/cjfr-2020-0082",
    takeaway: "Formulates the 3D stem vectoring and non-destructive cylinder fitting models embedded in CUTMAP Stage 2. Demonstrates that accounting for 3D trunk lean and sweep eliminates systemic underestimation in merchantable volume calculations.",
    bibtex: `@article{garms2021stemlean,
  title={Impact of stem lean on estimation of Douglas-fir diameter and volume using mobile lidar scans},
  author={Garms, Cory G. and Strimbu, Bogdan M.},
  journal={Canadian Journal of Forest Research},
  volume={51},
  number={8},
  pages={1184--1195},
  year={2021},
  publisher={NRC Research Press},
  doi={10.1139/cjfr-2020-0082}
}`
  },
  {
    id: "garms-sensors-2020",
    authors: "Garms, C.G., et al. (2020)",
    title: "Assessing lean and positional error of individual mature Douglas-fir using active and passive sensors",
    venue: "Remote Sensing, 12(14), 2278",
    tag: "Foundational Sensor Fusion",
    status: "Published (Peer-Reviewed)",
    doi: "https://doi.org/10.3390/rs12142278",
    takeaway: "Compares active spatial LiDAR scans with high-resolution passive optical imagery, proving that multi-sensor triangulation isolates tree curvature and positional drift under dense canopy.",
    bibtex: `@article{garms2020lean_sensors,
  title={Assessing lean and positional error of individual mature Douglas-fir using active and passive sensors},
  author={Garms, Cory G. and others},
  journal={Remote Sensing},
  volume={12},
  number={14},
  pages={2278},
  year={2020},
  publisher={MDPI},
  doi={10.3390/rs12142278}
}`
  }
];

// KPI Metrics Grid
const kpis = [
  {
    value: "~$2,200",
