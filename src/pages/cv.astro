---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Curriculum Vitae">
  <div class="max-w-4xl mx-auto px-6 py-16">
    
    <!-- Top CV Action Bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-8 mb-8 border-b border-border">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="w-2 h-2 rounded-sm bg-accent"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-accent-light">Academic Dossier</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
          Cory Glenn Garms, Ph.D.
        </h1>
        <p class="text-sm font-mono text-text-muted mt-1">
          Senior Scientist &bull; Spectral Sciences, Inc. &bull; Burlington, MA
        </p>
      </div>

      <div class="flex items-center gap-3">
        <button 
          onclick="window.print()" 
          class="px-4 py-2 bg-surface hover:bg-forest-800 text-white rounded-lg text-xs font-mono border border-border hover:border-accent/40 transition-all flex items-center gap-2 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          <span>Print / Save PDF</span>
        </button>
      </div>
    </div>

    <div class="space-y-12 text-text-main">
      
      <!-- Section: Appointments -->
      <section>
        <h2 class="text-xs font-mono uppercase tracking-widest text-accent-light mb-6 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          Professional Appointments
        </h2>

        <div class="space-y-6">
          <div class="p-6 bg-surface/70 rounded-xl border border-border">
            <div class="flex flex-wrap justify-between items-baseline gap-2 mb-1">
              <h3 class="text-lg font-bold text-white">Senior Scientist</h3>
              <span class="text-xs font-mono text-accent">2021 – Present</span>
            </div>
            <div class="text-xs font-mono text-text-muted mb-3">Spectral Sciences, Inc. &bull; Burlington, MA</div>
            <ul class="list-disc list-outside ml-4 space-y-1.5 text-xs text-text-muted leading-relaxed">
              <li>Lead Scientist and algorithm architect on USDA Small Business Technology Transfer (STTR) projects focused on automated 3D forest canopy modeling and mobile Lidar point cloud processing.</li>
              <li>Engineered containerized Python pipelines for ground classification, canopy height model (CHM) generation, and volumetric biomass calculations.</li>
              <li>Conducted research in hyperspectral and multispectral vicarious sensor calibration, airborne electro-optical target verification, and radiometric ground truth evaluation.</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Section: Education -->
      <section>
        <h2 class="text-xs font-mono uppercase tracking-widest text-accent-light mb-6 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          Education
        </h2>

        <div class="space-y-4">
          <div class="p-5 bg-surface/50 rounded-xl border border-border">
            <div class="flex flex-wrap justify-between items-baseline gap-2">
              <h3 class="text-base font-semibold text-white">Doctor of Philosophy (Ph.D.)</h3>
              <span class="text-xs font-mono text-text-dim">Completed</span>
            </div>
            <div class="text-xs font-mono text-text-muted mt-1">Focus: Remote Sensing, Lidar Point Clouds & Forestry Computer Vision</div>
            <p class="text-xs text-text-muted mt-2 leading-relaxed">
              Dissertation research examining geometric bias and stem lean modeling of individual mature conifers using multi-platform terrestrial and aerial lidar systems.
            </p>
          </div>

          <div class="p-5 bg-surface/50 rounded-xl border border-border">
            <div class="flex flex-wrap justify-between items-baseline gap-2">
              <h3 class="text-base font-semibold text-white">Bachelor of Science (B.S.)</h3>
              <span class="text-xs font-mono text-text-dim">Completed</span>
            </div>
            <div class="text-xs font-mono text-text-muted mt-1">Natural Resource Ecology & Geospatial Sciences</div>
          </div>
        </div>
      </section>

      <!-- Section: Computational Skills -->
      <section>
        <h2 class="text-xs font-mono uppercase tracking-widest text-accent-light mb-6 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          Computational & Engineering Arsenal
        </h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div class="p-4 bg-surface/50 rounded-xl border border-border">
            <div class="text-white font-semibold mb-1">Languages & Core Math</div>
            <div class="text-text-muted font-mono leading-relaxed">Python (laspy, rasterio, NumPy, SciPy, Open3D, Pandas), C++, GLSL, TypeScript</div>
          </div>
          <div class="p-4 bg-surface/50 rounded-xl border border-border">
            <div class="text-white font-semibold mb-1">Point Clouds & Spatial</div>
            <div class="text-text-muted font-mono leading-relaxed">PDAL, CloudCompare, GDAL/OGR, QGIS, Agisoft Metashape, Potree, Three.js</div>
          </div>
          <div class="p-4 bg-surface/50 rounded-xl border border-border">
            <div class="text-white font-semibold mb-1">Containers & DevOps</div>
            <div class="text-text-muted font-mono leading-relaxed">Docker, Podman, Linux/Bash, Git CI/CD, Reproducible Science Environments</div>
          </div>
          <div class="p-4 bg-surface/50 rounded-xl border border-border">
            <div class="text-white font-semibold mb-1">Computer Vision & AI</div>
            <div class="text-text-muted font-mono leading-relaxed">YOLOv8, 3D Point Segmentation, RANSAC Cylinder Fitting, Canopy Modeling</div>
          </div>
        </div>
      </section>

      <!-- Section: Publications Summary -->
      <section>
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xs font-mono uppercase tracking-widest text-accent-light flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            Peer-Reviewed Publications
          </h2>
          <a href="/research" class="text-xs font-mono text-accent hover:text-accent-light transition-colors">
            View All Publications &rarr;
          </a>
        </div>

        <div class="p-5 bg-surface/40 rounded-xl border border-border space-y-3 text-xs leading-relaxed text-text-muted">
          <div>
            <span class="text-white font-medium">Strauss, S.H., Garms, A.L., Garms, C.G., et al. (2026).</span> Robust Growth, Leaf Coloration, and Adaptation of a Transgenic Purple-leaved Poplar. <em>HortScience</em>, 61(9), 1925–1934.
          </div>
          <div>
            <span class="text-white font-medium">Garms, C.G. et al. (2021).</span> Assessing lean and positional error of individual mature Douglas-fir using active and passive sensors. <em>Remote Sensing</em>.
          </div>
          <div>
            <span class="text-white font-medium">Garms, C.G. et al. (2022).</span> Augmenting size models for Pinus strobiformis seedlings using dimensional estimates from UAS. <em>Ecological Informatics</em>.
          </div>
          <div>
            <span class="text-white font-medium">Garms, C.G. et al. (2020).</span> Impact of stem lean on estimation of Douglas-fir diameter and volume using mobile lidar scans. <em>Canadian Journal of Forest Research</em>.
          </div>
          <div>
            <span class="text-white font-medium">Garms, C.G. et al. (2023).</span> Spectral-spatial ground targets for measurement of airborne electro-optical imaging system performance. <em>SPIE Defense + Commercial Sensing</em>.
          </div>
          <div>
            <span class="text-white font-medium">Garms, C.G. et al. (2022).</span> Calibration of Earth observing spectral imagers vicariously and with controlled ground array. <em>SPIE Remote Sensing</em>.
          </div>
        </div>
      </section>

      <!-- Section: Community & Leadership -->
      <section>
        <h2 class="text-xs font-mono uppercase tracking-widest text-accent-light mb-6 flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
          Leadership & Community Service
        </h2>

        <div class="p-5 bg-surface/50 rounded-xl border border-border">
          <div class="flex flex-wrap justify-between items-baseline gap-2">
            <h3 class="text-sm font-semibold text-white">Medford Malden Elks Lodge #915</h3>
            <span class="text-xs font-mono text-topo">Chaplain & Member</span>
          </div>
          <p class="text-xs text-text-muted mt-2 leading-relaxed">
            Proudly serving as Chaplain, supporting community charitable initiatives, youth programs, and veterans outreach in greater Boston.
          </p>
        </div>
      </section>

    </div>
  </div>
</Layout>
