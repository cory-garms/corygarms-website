---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Alert from '../../components/mdx/Alert.astro';
import CodeSnippet from '../../components/mdx/CodeSnippet.astro';

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const notesEntries = await getCollection('notes');
  return notesEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

// 2. For your template, you can get the entry directly from the prop
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} | Cory Garms`}>
  <main class="pt-28 pb-16 px-6 sm:px-12 md:px-24 bg-background min-h-screen">
    <div class="max-w-3xl mx-auto">
        <a href="/#notes" class="text-accent hover:text-accent-light transition-colors mb-8 inline-flex items-center gap-1.5 font-mono text-xs">
            &larr; Back to Technical Notes
        </a>
        
        <header class="mb-12 border-b border-border pb-8">
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-4 tracking-tight">
                {entry.data.title}
            </h1>
            <div class="flex items-center gap-4 text-text-muted font-mono text-xs">
                <time datetime={entry.data.publishDate.toISOString()}>
                    {entry.data.publishDate.toLocaleDateString('en-US', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                    })}
                </time>
                <div class="flex gap-2">
                    {entry.data.tags.map((tag) => (
                        <span class="px-2.5 py-0.5 bg-forest-900 border border-border rounded text-accent-light text-[11px]">
                            #{tag}
                        </span>
                    ))}
                </div>
            </div>
        </header>

        <article class="prose prose-invert prose-primary max-w-none">
            <Content components={{ Alert, CodeSnippet }} />
        </article>
    </div>
  </main>
</Layout>
