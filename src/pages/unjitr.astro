<script>
  // Script handlers for code tab switcher and BibTeX copy
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Code tab switcher
    const tabBtnCli = document.getElementById('tab-btn-cli');
    const tabBtnPython = document.getElementById('tab-btn-python');
    const codePanelCli = document.getElementById('code-panel-cli');
    const codePanelPython = document.getElementById('code-panel-python');
    const codeCopyBtn = document.getElementById('code-copy-btn');
    const codeCopyText = document.getElementById('code-copy-text');

    let currentTab = 'cli';

    const cliCodeText = `pip install unjitr\nunjitr process 00097137145 --dt 0.15 --slab-half 1.0 --mask-agn-radius 350 --batch --output-dir ./restored_fits/\nunjitr verify ./restored_fits/sw00097137145_cor.fits`;
    
    const pythonCodeText = `from unjitr.core.tracker import track_sliding_2d_events\nfrom unjitr.io.fits_handler import load_event_stream, write_restored_events\n\nevents = load_event_stream("sw00097137145uu_uf.evt.gz")\nt_bins, dx, dy = track_sliding_2d_events(\n    t_ev=events['TIME'], x_ev=events['X'], y_ev=events['Y'],\n    gti_start=events.gti_start, gti_stop=events.gti_stop,\n    dt=0.15, slab_half=1.0, poly_order=2, poly_window=15\n)\nrestored = events.apply_trajectory(t_bins, dx, dy, null_gate_px=0.8)\nwrite_restored_events(restored, "sw00097137145_restored.evt")`;

    tabBtnCli?.addEventListener('click', () => {
      currentTab = 'cli';
      tabBtnCli.className = 'px-3 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-cyan-500/20 text-cyan-300 border border-cyan-500/40';
      if (tabBtnPython) {
        tabBtnPython.className = 'px-3 py-1.5 rounded-lg text-xs font-mono font-medium transition-all text-text-muted hover:text-white border border-transparent';
      }
      codePanelCli?.classList.remove('hidden');
      codePanelPython?.classList.add('hidden');
    });

    tabBtnPython?.addEventListener('click', () => {
      currentTab = 'python';
      tabBtnPython.className = 'px-3 py-1.5 rounded-lg text-xs font-mono font-medium transition-all bg-cyan-500/20 text-cyan-300 border border-cyan-500/40';
      if (tabBtnCli) {
        tabBtnCli.className = 'px-3 py-1.5 rounded-lg text-xs font-mono font-medium transition-all text-text-muted hover:text-white border border-transparent';
      }
      codePanelPython?.classList.remove('hidden');
      codePanelCli?.classList.add('hidden');
    });

    codeCopyBtn?.addEventListener('click', async () => {
      const textToCopy = currentTab === 'cli' ? cliCodeText : pythonCodeText;
      try {
        await navigator.clipboard.writeText(textToCopy);
        if (codeCopyText) {
          codeCopyText.textContent = 'Copied!';
          setTimeout(() => {
            codeCopyText.textContent = 'Copy Code';
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy code: ', err);
      }
    });

    // 2. BibTeX copy handlers
    document.querySelectorAll('.bibtex-copy-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const bibtex = btn.getAttribute('data-bibtex');
        const textSpan = btn.querySelector('.btn-text');
        if (!bibtex || !textSpan) return;

        try {
          await navigator.clipboard.writeText(bibtex);
          const originalText = textSpan.textContent;
          textSpan.textContent = "Copied to Clipboard!";
          btn.classList.add("text-cyan-300", "border-cyan-500/60");
          setTimeout(() => {
            textSpan.textContent = originalText;
            btn.classList.remove("text-cyan-300", "border-cyan-500/60");
          }, 2500);
        } catch (err) {
          console.error("Failed to copy BibTeX: ", err);
        }
      });
    });
  });
</script>
