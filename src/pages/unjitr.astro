<span class="text-purple-400">from</span> unjitr.io.fits_handler <span class="text-purple-400">import</span> load_event_stream, write_restored_events

<span class="text-text-dim"># Load raw photon event arrivals directly from FITS binary table</span>
events = load_event_stream(<span class="text-emerald-300">"sw00097137145uu_uf.evt.gz"</span>)

<span class="text-text-dim"># Solve 2D spacecraft attitude jitter trajectory at 6.7 Hz</span>
t_bins, dx, dy = track_sliding_2d_events(
    t_ev=events[<span class="text-emerald-300">'TIME'</span>],
    x_ev=events[<span class="text-emerald-300">'X'</span>],
