    slab_half=<span class="text-amber-300">1.0</span>,       <span class="text-text-dim"># 1.0s window captures 15s turnarounds</span>
    poly_order=<span class="text-amber-300">2</span>,        <span class="text-text-dim"># Savitzky-Golay inertia filter</span>
    poly_window=<span class="text-amber-300">15</span>
)

<span class="text-text-dim"># Apply coordinate shift with Do-No-Harm contract validation</span>
restored = events.apply_trajectory(t_bins, dx, dy, null_gate_px=<span class="text-amber-300">0.8</span>)
write_restored_events(restored, <span class="text-emerald-300">"sw00097137145_restored.evt"</span>)</code></pre>
