---
import Layout from "../layouts/Layout.astro";

const categories = [
  {
    name: "I. Philosophy & Resilience",
    books: [
      {
        title: "Man’s Search for Meaning",
        author: "Viktor Frankl",
        summary: "A psychiatrist's reflection on finding purpose and human dignity through his survival in Nazi concentration camps."
      },
      {
        title: "Night",
        author: "Elie Wiesel",
        summary: "A firsthand account of surviving the Holocaust and the endurance of the human spirit."
      },
      {
        title: "An Unquiet Mind",
        author: "Kay Redfield Jamison",
        summary: "A clinical psychologist's memoir on living with and treating manic-depressive illness."
      },
      {
        title: "The Stranger",
        author: "Albert Camus",
        summary: "An existential novel examining detachment, morality, and the absurdity of life through a senseless crime."
      },
      {
        title: "Meditations",
        author: "Marcus Aurelius",
        summary: "Private Stoic reflections from the Roman Emperor on duty, self-discipline, and emotional balance."
      },
      {
        title: "The Myth of Sisyphus",
        author: "Albert Camus",
        summary: "A philosophical essay on confronting the absurd and choosing to find purpose regardless."
      },
      {
        title: "The Art of Exceptional Living",
        author: "Jim Rohn",
        summary: "Practical reflections on personal discipline, philosophy, and building productive habits."
      }
    ]
  },
  {
    name: "II. The American West & History",
    books: [
      {
        title: "Empire of the Summer Moon",
        author: "S. C. Gwynne",
        summary: "The history of the 40-year conflict between the Comanche Nation and settlers in the American West."
      },
      {
        title: "Blood Meridian",
        author: "Cormac McCarthy",
        summary: "A brutal Western following an outlaw gang along the Texas-Mexico border in the 1840s."
      },
      {
        title: "Lonesome Dove",
        author: "Larry McMurtry",
        summary: "An epic novel of two retired Texas Rangers driving a cattle herd from the Rio Grande to Montana."
      },
      {
        title: "No Country for Old Men",
        author: "Cormac McCarthy",
        summary: "A tense thriller on crime, aging, and changing morality in West Texas."
      },
      {
        title: "Misery",
        author: "Stephen King",
        summary: "A psychological suspense novel about a writer held captive in an isolated cabin by an obsessed fan."
      },
      {
        title: "Undaunted Courage",
        author: "Stephen Ambrose",
        summary: "The story of the Lewis and Clark expedition and their journey across the uncharted American continent."
      }
    ]
  },
  {
    name: "III. Nature & Science",
    books: [
      {
        title: "Silent Spring",
        author: "Rachel Carson",
        summary: "The landmark book exposing the ecological damage caused by synthetic pesticides like DDT."
      },
      {
        title: "Walden",
        author: "Henry David Thoreau",
        summary: "Thoreau's reflection on simple living, self-reliance, and nature during two years by Walden Pond."
      },
      {
        title: "Desert Solitaire",
        author: "Edward Abbey",
        summary: "Essays celebrating the rugged wilderness of the American Southwest and the need to preserve wild spaces."
      },
      {
        title: "Lab Girl",
        author: "Hope Jahren",
        summary: "A geobiologist's memoir blending stories of scientific research, field trials, and plant life."
      },
      {
        title: "A Sand County Almanac",
        author: "Aldo Leopold",
        summary: "A classic work in conservation establishing the 'land ethic'—treating nature as a community rather than a commodity."
      },
      {
        title: "The Hidden Life of Trees",
        author: "Peter Wohlleben",
        summary: "An exploration of how trees communicate, share nutrients, and protect one another in forest ecosystems."
      },
      {
        title: "What a Plant Knows",
        author: "Daniel Chamovitz",
        summary: "An accessible look at plant sensory biology—how plants sense light, touch, temperature, and chemicals."
      }
    ]
  },
  {
    name: "IV. Technology & Speculative Fiction",
    books: [
      {
        title: "The Soul of a New Machine",
        author: "Tracy Kidder",
        summary: "A classic account of an engineering team racing to build a next-generation computer under tight deadlines."
      },
      {
        title: "Project Hail Mary",
        author: "Andy Weir",
        summary: "A lone astronaut uses scientific problem-solving to survive an interstellar mission and save Earth."
      },
      {
        title: "Slaughterhouse-Five",
        author: "Kurt Vonnegut",
        summary: "A satiric anti-war novel centering on the firebombing of Dresden, framed through non-linear time."
      },
      {
        title: "1984",
        author: "George Orwell",
        summary: "A dystopian classic about state surveillance, censorship, and the manipulation of truth."
      },
      {
        title: "Brave New World",
        author: "Aldous Huxley",
        summary: "A vision of an engineered future where comfort and stability are traded for human individuality."
      },
      {
        title: "Fahrenheit 451",
        author: "Ray Bradbury",
        summary: "A story set in a society where books are outlawed and firemen burn any literature that remains."
      },
      {
        title: "The Martian",
        author: "Andy Weir",
        summary: "An astronaut stranded on Mars relies on engineering ingenuity and botany to survive."
      },
      {
        title: "Children of Time",
        author: "Adrian Tchaikovsky",
        summary: "A space epic spanning generations as humanity searches for a home and encounters an evolved civilization."
      }
    ]
  }
];
---

<Layout title="Reading List | Cory Glenn Garms">
  <main class="pt-28 pb-24 bg-background relative overflow-hidden min-h-screen">
    <div class="max-w-7xl mx-auto px-6 relative z-10">
      <div class="mb-14 reveal">
        <a href="/" class="inline-flex items-center text-accent hover:text-accent-light transition-colors font-mono text-xs mb-6 group">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Overview
        </a>
        <div class="flex items-center gap-2 mb-3">
          <span class="w-2 h-2 rounded-full bg-topo"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-topo">Curated Bibliography</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4 tracking-tight">
          The Library: <span class="text-accent">Personal Favorites</span>
        </h1>
        <p class="text-text-muted max-w-2xl text-sm leading-relaxed">
          A collection of 22 books that shaped my thinking across science, philosophy, history, and fiction.
        </p>
      </div>

      <div class="space-y-16">
        {categories.map((category, catIdx) => (
          <section class="reveal" style={`transition-delay: ${catIdx * 80}ms;`}>
            <div class="flex items-center gap-3 mb-6">
              <span class="w-2 h-2 rounded-sm bg-accent"></span>
              <h2 class="text-xl font-bold text-white tracking-tight">
                {category.name}
              </h2>
              <div class="h-px bg-border flex-grow ml-4"></div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {category.books.map((book) => (
                <div class="bg-surface p-6 rounded-2xl border border-border hover:border-accent/60 transition-all duration-300 group hover:shadow-lg flex flex-col">
                  <h3 class="text-base font-bold text-white mb-1.5 group-hover:text-accent transition-colors">
                    {book.title}
                  </h3>
                  <div class="text-accent-light text-xs font-mono mb-3">{book.author}</div>
                  <p class="text-text-muted text-xs leading-relaxed flex-grow">
                    {book.summary}
                  </p>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </main>
</Layout>
