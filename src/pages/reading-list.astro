---

<Layout 
  title="The Bookshelf: Personal Favorites"
  description="An interactive digital bookshelf of 40 hardcover volumes that shaped my thinking across science, history, philosophy, and speculative fiction."
>
  <main class="pt-28 pb-24 bg-background relative overflow-x-clip min-h-screen">
    
    <!-- Ambient Topographic Glow Background -->
    <div class="absolute inset-0 pointer-events-none opacity-40">
      <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-gradient-to-b from-forest-900/30 via-emerald-950/20 to-transparent blur-[120px] rounded-full"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 relative z-10">
      
      <!-- Page Navigation & Breadcrumb -->
      <div class="mb-10 reveal">
        <a href="/" class="inline-flex items-center text-accent hover:text-accent-light transition-colors font-mono text-xs mb-6 group">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Overview
        </a>
        
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <div class="flex items-center gap-2 mb-2">
              <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
              <span class="text-xs font-mono uppercase tracking-widest text-accent-light">Interactive Library &bull; {totalBooks} Hardcover Volumes</span>
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
              The Bookshelf: <span class="text-accent">Personal Favorites</span>
            </h1>
            <p class="text-text-muted max-w-2xl text-xs sm:text-sm leading-relaxed mt-2">
              Hover over any book spine (or tap on mobile) to pull the hardcover forward and reveal its scientific and personal takeaway.
            </p>
          </div>

          <!-- View Mode Switcher -->
          <div class="flex items-center gap-1.5 p-1 rounded-xl bg-surface/90 border border-border text-xs font-mono">
            <button 
              id="view-shelf-btn"
              type="button"
              class="px-3 py-1.5 rounded-lg bg-forest-800 text-white border border-accent/40 shadow-sm transition-all flex items-center gap-1.5 cursor-pointer"
            >
              <span>📚 Bookshelf</span>
            </button>
            <button 
              id="view-grid-btn"
              type="button"
              class="px-3 py-1.5 rounded-lg text-text-muted hover:text-white hover:bg-surface transition-all flex items-center gap-1.5 cursor-pointer"
            >
              <span>🗂 Grid View</span>
            </button>
          </div>
        </div>
      </div>

      <!-- 3D Interactive Bookshelf View (Default) -->
      <div id="bookshelf-view" class="space-y-6 reveal">
        {categories.map((category, idx) => (
          <BookshelfRow 
            categoryName={category.name} 
            books={category.books} 
            shelfNumber={idx + 1} 
          />
        ))}
      </div>

      <!-- Flat Catalog Grid View (Alternative Accessible View) -->
      <div id="grid-view" class="hidden space-y-16 reveal">
        {categories.map((category, catIdx) => (
          <section class="space-y-6">
            <div class="flex items-center gap-3">
              <span class="w-2 h-2 rounded-sm bg-accent"></span>
              <h2 class="text-xl font-bold text-white tracking-tight">
                {category.name}
              </h2>
              <div class="h-px bg-border flex-grow ml-4"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              {category.books.map((book) => (
                <div class="p-6 bg-surface/60 rounded-2xl border border-border hover:border-accent/40 transition-all flex flex-col justify-between group">
                  <div>
                    <div class="flex items-center justify-between text-[11px] font-mono text-text-dim mb-2">
                      <span class="text-accent">{book.year}</span>
                      <span>{book.pages} pages</span>
                    </div>
                    <h3 class={`text-lg font-bold text-white mb-1 group-hover:text-accent-light transition-colors ${book.fontFamily}`}>
                      {book.title}
                    </h3>
                    <p class="text-xs font-mono text-text-muted mb-4">
                      {book.author}
                    </p>
                    <p class="text-xs text-text-muted leading-relaxed">
                      {book.summary}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </section>
        ))}
      </div>

    </div>
  </main>

  <script>
    // View Switcher (Bookshelf vs Grid)
    const shelfBtn = document.getElementById('view-shelf-btn');
    const gridBtn = document.getElementById('view-grid-btn');
    const shelfView = document.getElementById('bookshelf-view');
    const gridView = document.getElementById('grid-view');

    if (shelfBtn && gridBtn && shelfView && gridView) {
      shelfBtn.addEventListener('click', () => {
        shelfView.classList.remove('hidden');
        gridView.classList.add('hidden');
        shelfBtn.className = "px-3 py-1.5 rounded-lg bg-forest-800 text-white border border-accent/40 shadow-sm transition-all flex items-center gap-1.5 cursor-pointer";
        gridBtn.className = "px-3 py-1.5 rounded-lg text-text-muted hover:text-white hover:bg-surface transition-all flex items-center gap-1.5 cursor-pointer";
      });

      gridBtn.addEventListener('click', () => {
        shelfView.classList.add('hidden');
        gridView.classList.remove('hidden');
        gridBtn.className = "px-3 py-1.5 rounded-lg bg-forest-800 text-white border border-accent/40 shadow-sm transition-all flex items-center gap-1.5 cursor-pointer";
        shelfBtn.className = "px-3 py-1.5 rounded-lg text-text-muted hover:text-white hover:bg-surface transition-all flex items-center gap-1.5 cursor-pointer";
      });
    }

    // Touch / Click Support for Mobile devices on Book Spines
    document.querySelectorAll('.book-spine-wrapper').forEach(wrapper => {
      wrapper.addEventListener('click', (e) => {
        // Toggle active lift state on touch devices
        const isHovered = wrapper.classList.contains('active-touch');
        document.querySelectorAll('.book-spine-wrapper').forEach(w => w.classList.remove('active-touch'));
        if (!isHovered) {
          wrapper.classList.add('active-touch');
        }
      });
    });

    // Close any active mobile popover when tapping outside
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (!target.closest('.book-spine-wrapper')) {
        document.querySelectorAll('.book-spine-wrapper').forEach(w => w.classList.remove('active-touch'));
      }
    });
  </script>

  <style>
    /* Mobile active touch styling */
    .book-spine-wrapper.active-touch .book-spine {
      transform: translateY(-24px) scale(1.03) rotate(-1.5deg);
    }
    .book-spine-wrapper.active-touch .book-popover {
      opacity: 1 !important;
      transform: translateY(0) !important;
      pointer-events: auto !important;
    }
  </style>
</Layout>
