---
import Layout from "../layouts/Layout.astro";
import PointCloudHero from "../components/PointCloudHero.jsx";
import PortfolioGrid from "../components/PortfolioGrid.astro";
import NotesList from "../components/NotesList.astro";
import ContactSection from "../components/ContactSection.astro";
---

<Layout 
  title="Home"
  description="Dr. Cory Glenn Garms: Senior Scientist at Spectral Sciences, Inc. specializing in remote sensing, 3D LiDAR point cloud processing, and computer vision."
  image="/images/profile.jpg"
>
  <h1 class="sr-only">Cory Glenn Garms, Ph.D. — Senior Scientist in Remote Sensing & Lidar</h1>

  <!-- Hero Section with Integrated 3D Remote Sensing View -->
  <section
    id="hero"
    class="relative w-full h-[75vh] sm:h-[88vh] min-h-[460px] sm:min-h-[600px] flex items-center overflow-hidden bg-background"
  >
    <!-- 3D Canvas Background -->
    <div class="absolute inset-0 z-0">
      <PointCloudHero client:load />
    </div>

    <!-- Floating Hero Identity Overlay (Passing the 5-Second Test) with Collapse/Expand Toggle -->
    <div id="hero-identity-container" class="absolute bottom-6 sm:bottom-10 left-4 sm:left-8 max-w-xl z-20 pointer-events-none reveal">
      
      <!-- Expanded Card -->
      <div id="hero-identity-card" class="p-5 sm:p-6 rounded-2xl bg-surface/85 backdrop-blur-xl border border-border/80 shadow-2xl pointer-events-auto space-y-3 transition-all duration-300">
        <div class="flex items-center justify-between gap-4">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
            <span class="text-xs font-mono uppercase tracking-widest text-accent-light">Senior Scientist &bull; Spectral Sciences, Inc.</span>
          </div>
          <button 
            id="hero-collapse-btn" 
            type="button"
            aria-label="Minimize identity card"
            class="bg-orange-500 hover:bg-orange-400 text-black font-bold px-2.5 py-1 rounded-lg border border-orange-400 shadow-md shadow-orange-500/20 hover:shadow-orange-500/40 transition-all flex items-center gap-1.5 text-[11px] font-mono cursor-pointer"
            title="Minimize overlay"
          >
            <span>Minimize</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>
        </div>
        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-tight">
          Cory Glenn Garms, <span class="text-accent">Ph.D.</span>
        </h1>
        <p class="text-xs sm:text-sm text-text-muted leading-relaxed font-sans">
          Bridging biology, software development, and active/passive sensing to measure forests, sharpen satellite imagery, and more.
        </p>
        <div class="flex flex-wrap items-center gap-2.5 pt-1 text-xs font-mono">
          <a href="#about" class="px-3.5 py-1.5 rounded-lg bg-forest-800 hover:bg-forest-700 text-white border border-border hover:border-accent/50 transition-all">
            Research Bio &darr;
          </a>
          <a href="/research" class="px-3.5 py-1.5 rounded-lg bg-forest-900 hover:bg-forest-800 text-accent-light border border-border hover:border-accent/50 transition-all">
            Publications &rarr;
          </a>
          <a href="/cv" class="px-3.5 py-1.5 rounded-lg bg-forest-900 hover:bg-forest-800 text-white border border-border hover:border-accent/50 transition-all font-medium">
            CV
          </a>
        </div>
      </div>

      <!-- Collapsed State Pill -->
      <button 
        id="hero-expand-btn"
        type="button"
        aria-label="Show identity card"
        class="hidden pointer-events-auto px-3.5 py-2 rounded-full bg-surface/90 backdrop-blur-xl border border-orange-500/60 hover:border-orange-400 hover:bg-forest-900 text-orange-400 hover:text-white shadow-xl transition-all duration-200 flex items-center gap-1.5 text-xs font-mono font-semibold cursor-pointer"
      >
        <span>Show Info &uarr;</span>
      </button>

    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="scroll-mt-14 py-20 bg-background relative overflow-hidden border-t border-border-subtle">
    <div class="max-w-7xl mx-auto px-6">
      
      <!-- Section Header -->
      <div class="flex items-center gap-3 mb-12 reveal">
        <span class="w-2 h-2 rounded-sm bg-accent"></span>
        <h2 class="text-xs font-mono uppercase tracking-widest text-accent-light">About</h2>
        <div class="h-px bg-border flex-grow ml-4"></div>
      </div>

      <div class="flex flex-col lg:flex-row gap-12 items-start">
        
        <!-- Portraits & Quick Links Column -->
        <div class="w-full lg:w-4/12 flex flex-col gap-4 reveal reveal-left">
          
          <!-- Primary Portrait -->
          <div class="relative bg-surface rounded-2xl border border-border overflow-hidden shadow-md">
            <div class="aspect-[4/5] w-full relative">
              <img
                src="/images/profile.jpg"
                alt="Cory Glenn Garms, Ph.D."
                class="w-full h-full object-cover object-center"
              />
            </div>
          </div>

          <!-- Amanda & Family -->
          <div class="flex items-center gap-4 bg-surface/80 rounded-2xl border border-border hover:border-border-hover p-4 shadow-sm transition-all">
            <img
              src="/images/amanda.jpg"
              alt="Cory and Amanda"
              class="w-24 h-24 sm:w-28 sm:h-28 rounded-xl object-cover border border-border flex-shrink-0 shadow-sm"
            />
            <div class="flex flex-col justify-center">
              <span class="text-base sm:text-lg font-bold text-white tracking-tight">Cory &amp; Amanda</span>
              <span class="text-xs font-mono text-accent-light mt-0.5">Married August 2020</span>
              <p class="text-xs sm:text-sm text-text-muted leading-relaxed mt-1.5">
                Grateful for our life, travels, and adventures together.
              </p>
            </div>
          </div>

          <!-- Quick Navigation Links -->
          <div class="grid grid-cols-2 gap-3">
            <a 
              href="https://photos.app.goo.gl/7yoaVpVCb5m7QZxs6" 
              target="_blank" 
              rel="noopener noreferrer"
              class="p-3 bg-surface/60 hover:bg-surface border border-border hover:border-accent/40 rounded-xl text-xs text-text-muted hover:text-white transition-all flex flex-col justify-between"
            >
              <span class="font-semibold text-white">Flower Photos</span>
              <span class="text-[11px] text-text-dim mt-1">Field catalog &rarr;</span>
            </a>

            <a 
              href="/reading-list" 
              class="p-3 bg-surface/60 hover:bg-surface border border-border hover:border-accent/40 rounded-xl text-xs text-text-muted hover:text-white transition-all flex flex-col justify-between"
            >
              <span class="font-semibold text-white">Bookshelf</span>
              <span class="text-[11px] text-text-dim mt-1">40 volumes &rarr;</span>
            </a>
          </div>
        </div>

        <!-- Narrative Column with 3-Tier Bio Structure -->
        <div class="w-full lg:w-8/12 reveal reveal-right" style="transition-delay: 150ms;">
          <div class="space-y-4 text-text-muted text-sm sm:text-base leading-relaxed mb-8">
            <p>
              I am a Senior Scientist at <strong class="text-white">Spectral Sciences, Inc.</strong> in Burlington, MA, with a Ph.D. in Sustainable Forest Management from Oregon State University. My research focuses on physical optics, 3D LiDAR, and computer vision—building algorithmic pipelines that translate complex spatial return signals into actionable physical models.
            </p>
            <p>
              In applied research, I lead algorithm development for <a href="/cutmap" class="text-accent hover:underline font-medium">CUTMAP</a> (a USDA-NIFA STTR mobile LiDAR cart measuring tree metrics under dense canopy in real time) and contribute to <a href="/unjitr" class="text-cyan-300 hover:underline font-medium">UNJITR</a> (restoring sub-pixel photon event streams on NASA's Swift UVOT space telescope).
            </p>
            <p>
              Outside the lab, I develop the <a href="https://dirtywater.corygarms.com" target="_blank" rel="noopener noreferrer" class="text-white hover:text-accent underline decoration-accent/40 underline-offset-2 transition-colors">Dirty Water</a> Red Sox Statcast analytics suite, enjoy kayak fishing and hiking, and serve the community as Esteemed Lecturing Knight for <strong class="text-white">Medford Malden Elks Lodge #915</strong>.
            </p>
          </div>

          <!-- Academic & Research Links -->
          <div class="flex flex-wrap gap-3">
            <a 
              href="/unjitr"
              class="inline-flex items-center gap-2 text-xs font-mono text-cyan-300 hover:text-cyan-200 px-4 py-2.5 rounded-lg bg-cyan-950/70 border border-cyan-500/40 hover:border-cyan-400/80 transition-all shadow-sm group"
            >
              <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
              <span class="font-semibold">UNJITR</span>
              <span class="text-cyan-400/80 font-normal hidden sm:inline">&bull; NASA SWIFT Sharpening</span>
            </a>
            <a 
              href="/cutmap"
              class="inline-flex items-center gap-2 text-xs font-mono text-emerald-300 hover:text-emerald-200 px-4 py-2.5 rounded-lg bg-emerald-950/70 border border-emerald-500/40 hover:border-emerald-400/80 transition-all shadow-sm group"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="font-semibold">CUTMAP</span>
              <span class="text-emerald-400/80 font-normal hidden sm:inline">&bull; Mobile Understory LiDAR</span>
            </a>
            <a 
              href="/research"
              class="inline-flex items-center gap-2 text-xs font-mono text-accent hover:text-accent-light px-4 py-2.5 rounded-lg bg-forest-900 border border-border hover:border-accent/40 transition-all"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/>
              </svg>
              <span>Publications</span>
            </a>
            <a 
              href="/cv"
              class="inline-flex items-center gap-2 text-xs font-mono text-text-muted hover:text-white px-4 py-2.5 rounded-lg bg-surface border border-border hover:border-border-hover transition-all"
            >
              <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>CV</span>
            </a>
            <a 
              href="https://github.com/cory-garms" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-xs font-mono text-text-muted hover:text-white px-4 py-2.5 rounded-lg bg-surface border border-border hover:border-border-hover transition-all"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
              </svg>
              <span>GitHub</span>
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- Research Preview Section -->
  <section id="research-preview" class="py-16 bg-surface/30 border-t border-border">
    <div class="max-w-7xl mx-auto px-6 reveal">
      <div class="flex items-center justify-between mb-8">
        <div class="flex items-center gap-3 flex-grow mr-6">
          <span class="w-2 h-2 rounded-sm bg-accent"></span>
          <h2 class="text-xs font-mono uppercase tracking-widest text-accent-light">Research & Publications</h2>
          <div class="h-px bg-border flex-grow ml-4"></div>
        </div>
        <a href="/research" class="text-xs font-mono text-accent hover:text-accent-light transition-colors shrink-0">
          <span>All Papers &rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 bg-surface rounded-2xl border border-cyan-500/30 hover:border-cyan-400/70 flex flex-col justify-between transition-all group">
          <div>
            <div class="flex items-center gap-1.5 text-[11px] font-mono text-cyan-300 mb-2">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
              <span>NASA Swift UVOT &bull; 2026</span>
            </div>
            <h3 class="text-lg font-bold text-white mb-2 group-hover:text-cyan-200 transition-colors">UNJITR: Spacecraft Attitude Jitter Recovery</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-4">
              Restores blurred NASA Swift space telescope images corrupted by spacecraft jitter back into sharp, science-ready stars.
            </p>
          </div>
          <a href="/unjitr" class="text-xs font-mono text-cyan-300 hover:text-cyan-200 transition-colors flex items-center gap-1">
            <span>View mission benchmarks &rarr;</span>
          </a>
        </div>

        <div class="p-6 bg-surface rounded-2xl border border-border flex flex-col justify-between hover:border-accent/40 transition-all">
          <div>
            <div class="text-[11px] font-mono text-accent mb-2">3D Lidar & Forestry &bull; 2021</div>
            <h3 class="text-lg font-bold text-white mb-2">Assessing lean and positional error of individual mature Douglas-fir</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-4">
              Measures tree lean and trunk curvature to improve the accuracy of airborne laser forest inventories.
            </p>
          </div>
          <a href="/research#douglas-fir-lean" class="text-xs font-mono text-text-main hover:text-accent transition-colors flex items-center gap-1">
            <span>View publication & summary &rarr;</span>
          </a>
        </div>

        <div class="p-6 bg-surface rounded-2xl border border-border flex flex-col justify-between hover:border-accent/40 transition-all">
          <div>
            <div class="text-[11px] font-mono text-topo mb-2">Hyperspectral Calibration &bull; SPIE 2023</div>
            <h3 class="text-lg font-bold text-white mb-2">Spectral-spatial ground targets for airborne imaging performance</h3>
            <p class="text-xs text-text-muted leading-relaxed mb-4">
              Deploys custom ground targets to test camera sharpness and color accuracy during airborne survey flights.
            </p>
          </div>
          <a href="/research#spie-spectral-spatial-targets" class="text-xs font-mono text-text-main hover:text-accent transition-colors flex items-center gap-1">
            <span>View publication & summary &rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio Section -->
  <PortfolioGrid />

  <!-- Notes Section -->
  <NotesList />

  <!-- Contact Section -->
  <ContactSection />

  <script>
    // Hero Identity Overlay Collapse / Expand Logic
    const card = document.getElementById('hero-identity-card');
    const collapseBtn = document.getElementById('hero-collapse-btn');
    const expandBtn = document.getElementById('hero-expand-btn');

    if (card && collapseBtn && expandBtn) {
      collapseBtn.addEventListener('click', () => {
        card.classList.add('hidden');
        expandBtn.classList.remove('hidden');
      });

      expandBtn.addEventListener('click', () => {
        expandBtn.classList.add('hidden');
        card.classList.remove('hidden');
      });
    }
  </script>
</Layout>
