    venue: "Target: Journal of Open Source Software (JOSS)",
    year: 2026,
    categoryLabel: "Scientific Software & Tools",
    typeBadge: "In Preparation",
    badgeColor: "bg-cyan-950/80 text-cyan-300 border-cyan-500/40",
    topics: ["Astronomy", "Remote Sensing"],
    takeaway: "Details the forthcoming UNJITR open-source Python toolkit, implementing hoisted 2D FFT cross-correlation, sub-pixel parabolic vertex fitting, automated Do-No-Harm quality gates, and high-throughput batch FITS event processing.",
    codeLink: "/unjitr",
    codeLabel: "Toolkit Architecture &rarr;",
    bibtex: `@article{gelbord2026unjitr_joss,
  title={UNJITR: A Python Toolkit for Sub-Pixel Photon-Event Jitter Correction and Astrometric Sharpening},
  author={Gelbord, Jonathan and Garms, Cory G. and others},
  journal={Journal of Open Source Software},
  year={2026},
  note={In Preparation}
}`
  },
  {
    id: "cutmap-calibration",
    title: "Calibrating a Low-SWaP-C Lidar–Stereo Platform: Staged Procedures, Failure Coupling, and Operational Validation",
    authors: "Cory G. Garms, Bogdan Strimbu, et al.",
    venue: "Target: Journal of Field Robotics",
    year: 2026,
    categoryLabel: "3D Lidar & Field Robotics",
    typeBadge: "In Preparation",
    badgeColor: "bg-amber-950/80 text-amber-300 border-amber-500/40",
    topics: ["Forestry", "Remote Sensing"],
    takeaway: "Analyzes error propagation across multimodal LiDAR-stereo extrinsics under dense forest canopy, introducing staged target placement diagnostics to guarantee sub-centimeter mobile mapping precision.",
    codeLink: "/cutmap",
    codeLabel: "CUTMAP System &rarr;",
    bibtex: `@article{garms2026cutmap_calibration,
  title={Calibrating a Low-SWaP-C Lidar--Stereo Platform: Staged Procedures, Failure Coupling, and Operational Validation},
  author={Garms, Cory G. and Strimbu, Bogdan M. and others},
  journal={Journal of Field Robotics},
  year={2026},
  note={In Preparation}
}`
  },
  {
    id: "purple-leaved-poplar",
    title: "Robust Growth, Leaf Coloration, and Adaptation of a Transgenic Purple-leaved Poplar",
    authors: "Steven H. Strauss, Amanda L. Garms, Cory G. Garms, Chaney M. Hart, Cathleen Ma, Zachary Heinhold, Greg Goralogia, Megan McEldowney, Parker Wheeler, Laurence Schimleck, Ximin An",
    venue: "HortScience (ASHS), 61(9), 1925–1934",
    year: 2026,
    categoryLabel: "Genetics & Spectral Phenomics",
    typeBadge: "Peer-Reviewed Journal",
    badgeColor: "bg-emerald-950/80 text-emerald-300 border-emerald-500/40",
    topics: ["Forestry", "Remote Sensing"],
    takeaway: "Multi-year field trial assessing morphological growth, anthocyanin leaf coloration stability, and canopy spectral reflectance across genetically modified purple poplar lines.",
    doi: "https://doi.org/10.21273/HORTSCI19524-26",
    bibtex: `@article{strauss2026purplepoplar,
  title={Robust Growth, Leaf Coloration, and Adaptation of a Transgenic Purple-leaved Poplar},
  author={Strauss, Steven H. and Garms, Amanda L. and Garms, Cory G. and Hart, Chaney M. and Ma, Cathleen and Heinhold, Zachary and Goralogia, Greg and McEldowney, Megan and Wheeler, Parker and Schimleck, Laurence and An, Ximin},
  journal={HortScience},
  volume={61},
  number={9},
  pages={1925--1934},
  year={2026},
  publisher={American Society for Horticultural Science},
  doi={10.21273/HORTSCI19524-26}
}`
  },

  // 2023
  {
    id: "spie-spectral-spatial-targets",
    title: "Spectral-spatial ground targets for measurement of airborne electro-optical imaging system performance",
    authors: "Cory G. Garms, et al. (Spectral Sciences, Inc.)",
    venue: "Proc. SPIE Defense + Commercial Sensing, 1254308",
    year: 2023,
    categoryLabel: "Hyperspectral & Optics",
    typeBadge: "Conference Proceeding",
    badgeColor: "bg-blue-950/80 text-blue-300 border-blue-500/40",
