    doi: "https://doi.org/10.1117/12.2663812",
    bibtex: `@inproceedings{garms2023targets,
  title={Spectral-spatial ground targets for measurement of airborne electro-optical imaging system performance},
  author={Garms, Cory G. and others},
  booktitle={Proc. SPIE Defense + Commercial Sensing},
  volume={12543},
  pages={1254308},
  year={2023},
  doi={10.1117/12.2663812}
}`
  },

  // 2022
  {
    id: "spie-vicarious-calibration",
    title: "Calibration of Earth observing spectral imagers vicariously and with controlled ground array",
    authors: "Cory G. Garms, et al. (Spectral Sciences, Inc.)",
    venue: "Proc. SPIE Remote Sensing, 1226806",
    year: 2022,
    categoryLabel: "Hyperspectral & Optics",
    typeBadge: "Conference Proceeding",
    badgeColor: "bg-blue-950/80 text-blue-300 border-blue-500/40",
    topics: ["Remote Sensing"],
    takeaway: "Methods for vicarious calibration of satellite and airborne imaging spectrometers using ground reference arrays to maintain radiometric fidelity across repeated observations.",
    doi: "https://doi.org/10.1117/12.2635901",
    bibtex: `@inproceedings{garms2022calibration,
  title={Calibration of Earth observing spectral imagers vicariously and with controlled ground array},
  author={Garms, Cory G. and others},
  booktitle={Proc. SPIE Remote Sensing},
  volume={12268},
  pages={1226806},
  year={2022},
  doi={10.1117/12.2635901}
}`
  },

  // 2021
  {
    id: "moler-warming-seeds-2021",
    title: "A method for experimental warming of developing tree seeds with a common garden demonstration of seedling responses",
    authors: "Ehren R. V. Moler, Gerald F. M. Page, Lluvia Flores-Rentería, Cory G. Garms, Julia B. Hull, H. F. Cooper, J. Swenson, S. Perks, Kristen M. Waring, Amy V. Whipple",
    venue: "Plant Methods, 17(1), 1–13",
    year: 2021,
    categoryLabel: "Forest Ecology & Seed Physiology",
    typeBadge: "Peer-Reviewed Journal",
    badgeColor: "bg-emerald-950/80 text-emerald-300 border-emerald-500/40",
    topics: ["Forestry"],
    takeaway: "Presents an in situ thermal manipulation methodology for developing conifer cones and assesses subsequent phenotypic seedling growth in common garden environments.",
    doi: "https://doi.org/10.1186/s13007-020-00700-7",
    bibtex: `@article{moler2021warming,
  title={A method for experimental warming of developing tree seeds with a common garden demonstration of seedling responses},
  author={Moler, Ehren R. V. and Page, Gerald F. M. and Flores-Renter{\'i}a, Lluvia and Garms, Cory G. and Hull, Julia B. and Cooper, H. F. and Swenson, J. and Perks, S. and Waring, Kristen M. and Whipple, Amy V.},
  journal={Plant Methods},
  volume={17},
  number={1},
  pages={1--13},
  year={2021},
  doi={10.1186/s13007-020-00700-7}
}`
  },
  {
    id: "douglas-fir-lean",
    title: "Assessing lean and positional error of individual mature Douglas-fir using active and passive sensors",
    authors: "Cory G. Garms, Christopher Simpson, Christopher Parrish, Michael G. Wing, Bogdan Strimbu",
    venue: "Remote Sensing, 12(14), 2278",
    year: 2021,
    categoryLabel: "3D Lidar & Forestry",
    typeBadge: "Peer-Reviewed Journal",
    badgeColor: "bg-emerald-950/80 text-emerald-300 border-emerald-500/40",
    topics: ["Forestry", "Remote Sensing"],
    takeaway: "Multi-platform comparison of UAV SfM, airborne LiDAR, and mobile ground LiDAR for tree stem detection, positional accuracy, and lean angle estimation in mature Douglas-fir.",
    doi: "https://doi.org/10.3390/rs12142278",
    codeLink: "https://github.com/cory-garms/lidar-canopy-extractor",
    codeLabel: "Canopy Extractor Code &rarr;",
    bibtex: `@article{garms2021lean,
  title={Assessing lean and positional error of individual mature Douglas-fir using active and passive sensors},
  author={Garms, Cory G. and Simpson, Christopher and Parrish, Christopher and Wing, Michael G. and Strimbu, Bogdan M.},
  journal={Remote Sensing},
  volume={12},
  number={14},
  pages={2278},
  year={2021},
  doi={10.3390/rs12142278}
}`
  },

  // 2020
  {
    id: "uas-pinus-strobiformis",
    title: "Augmenting Size Models for Pinus strobiformis Seedlings Using Dimensional Estimates from Unmanned Aircraft Systems",
    authors: "Cory Garms, Lluvia Flores-Rentería, Kristen Waring, Amy Whipple, Michael G. Wing, Bogdan Strimbu",
    venue: "Canadian Journal of Forest Research, 50(7), 643–652",
    year: 2020,
    categoryLabel: "UAS & Nursery Phenotyping",
    typeBadge: "Peer-Reviewed Journal",
    badgeColor: "bg-emerald-950/80 text-emerald-300 border-emerald-500/40",
    topics: ["Forestry", "Remote Sensing"],
    takeaway: "Replaced destructive manual caliper measurements with multispectral UAS SfM 3D reconstructions to estimate conifer seedling growth models and detect early nursery mortality.",
    doi: "https://doi.org/10.1139/cjfr-2019-0325",
    bibtex: `@article{garms2020seedlings,
  title={Augmenting Size Models for Pinus strobiformis Seedlings Using Dimensional Estimates from Unmanned Aircraft Systems},
  author={Garms, Cory and Flores-Renter{\'i}a, Lluvia and Waring, Kristen and Whipple, Amy and Wing, Michael G. and Strimbu, Bogdan},
  journal={Canadian Journal of Forest Research},
  volume={50},
  number={7},
  pages={643--652},
  year={2020},
  doi={10.1139/cjfr-2019-0325}
}`
  },
  {
    id: "mobile-lidar-volume",
    title: "Impact of stem lean on estimation of Douglas-fir diameter and volume using mobile lidar scans",
    authors: "Cory G. Garms, Bogdan Strimbu",
    venue: "Canadian Journal of Forest Research, 50(9), 882–892",
    year: 2020,
    categoryLabel: "3D Lidar & Stem Modeling",
    typeBadge: "Peer-Reviewed Journal",
    badgeColor: "bg-emerald-950/80 text-emerald-300 border-emerald-500/40",
    topics: ["Forestry", "Remote Sensing"],
    takeaway: "Quantifies how stem lean introduces systematic error in conventional taper and volume calculations, and develops non-linear compensation models using vehicle-mounted mobile LiDAR.",
    doi: "https://doi.org/10.1139/cjfr-2020-0082",
    bibtex: `@article{garms2020stemlean,
  title={Impact of stem lean on estimation of Douglas-fir diameter and volume using mobile lidar scans},
  author={Garms, Cory G. and Strimbu, Bogdan M.},
  journal={Canadian Journal of Forest Research},
  volume={50},
  number={9},
  pages={882--892},
  year={2020},
  doi={10.1139/cjfr-2020-0082}
}`
  },
  {
    id: "osu-phd-dissertation",
    title: "Using Point Clouds for Single Tree Forest Inventory at the Beginning and End of the Rotation",
    authors: "Cory G. Garms (Advisor: Dr. Bogdan Strimbu)",
    venue: "Ph.D. Dissertation, Oregon State University",
    year: 2020,
    categoryLabel: "Ph.D. Dissertation",
    typeBadge: "Ph.D. Dissertation",
    badgeColor: "bg-amber-950/80 text-amber-300 border-amber-500/40",
    topics: ["Academic", "Forestry", "Remote Sensing"],
    takeaway: "Comprehensive doctoral dissertation examining the operational integration of UAS structure-from-motion (SfM) photogrammetry and mobile/airborne laser scanning (MLS/ALS) across stand life cycle stages—from common garden seedling trials to harvest-ready mature timber.",
    bibtex: `@phdthesis{garms2020dissertation,
  title={Using Point Clouds for Single Tree Forest Inventory at the Beginning and End of the Rotation},
  author={Garms, Cory G.},
  school={Oregon State University},
  year={2020},
  type={Doctor of Philosophy Dissertation},
  note={Department of Forest Engineering, Resources, and Management}
}`
  },

  // 2019
  {
    id: "garms-dean-forestry-2019",
    title: "Relative resistance to breaking of Pinus taeda and Pinus palustris",
    authors: "Cory Garms, Thomas J. Dean",
    venue: "Forestry: An International Journal of Forest Research, 92(4), 417–424",
    year: 2019,
    categoryLabel: "Tree Biomechanics & Windfirmness",
    typeBadge: "Peer-Reviewed Journal",
    badgeColor: "bg-emerald-950/80 text-emerald-300 border-emerald-500/40",
    topics: ["Forestry"],
    takeaway: "Applied static winching in situ with multi-accelerometer tilt sensing to test windfirmness, Young's modulus of elasticity (MoE), and modulus of rupture (MOR) in loblolly and longleaf pine following hurricane exposure.",
    doi: "https://doi.org/10.1093/forestry/cpy038",
    bibtex: `@article{garms2019relative,
  title={Relative resistance to breaking of Pinus taeda and Pinus palustris},
  author={Garms, Cory and Dean, Thomas J.},
  journal={Forestry: An International Journal of Forest Research},
  volume={92},
  number={4},
  pages={417--424},
  year={2019},
  doi={10.1093/forestry/cpy038}
}`
  },

  // 2016
  {
    id: "lsu-ms-thesis-2016",
    title: "Relative Resistance to Breaking of Pinus taeda L. and Pinus palustris",
    authors: "Cory Glenn Garms (Advisor: Dr. Thomas J. Dean)",
    venue: "M.S. Thesis, Louisiana State University",
    year: 2016,
    categoryLabel: "M.S. Thesis",
    typeBadge: "Master's Thesis",
    badgeColor: "bg-amber-950/80 text-amber-300 border-amber-500/40",
    topics: ["Academic", "Forestry"],
    takeaway: "Investigated hurricane windfirmness mechanisms in living loblolly and longleaf pine stands using in situ static winching, dynamometer load cells, and multi-accelerometer tilt sensing to measure stem bending moments (Mmax), Young's modulus of elasticity (MOE), and modulus of rupture (MOR).",
    doi: "https://repository.lsu.edu/gradschool_theses/3008",
    bibtex: `@mastersthesis{garms2016thesis,
  title={Relative Resistance to Breaking of Pinus taeda L. and Pinus palustris},
  author={Garms, Cory Glenn},
  school={Louisiana State University},
  year={2016},
  type={Master of Science Thesis},
  note={Department of Renewable Natural Resources},
  url={https://repository.lsu.edu/gradschool_theses/3008}
}`
  }
];

// Topic Counts
const forestryCount = publications.filter(p => p.topics.includes("Forestry")).length;
const remoteSensingCount = publications.filter(p => p.topics.includes("Remote Sensing")).length;
const astronomyCount = publications.filter(p => p.topics.includes("Astronomy")).length;
const academicCount = publications.filter(p => p.topics.includes("Academic")).length;
---

<Layout 
  title="Research & Publications"
  description="Peer-reviewed papers, doctoral dissertation, master's thesis, and technical algorithms in forest LiDAR, space instrumentation, and sensor calibration by Cory Glenn Garms, Ph.D."
>
  <div class="max-w-5xl mx-auto px-6 py-16">
    
    <!-- Page Header -->
    <div class="mb-10">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-2 h-2 rounded-sm bg-accent"></span>
        <span class="text-xs font-mono uppercase tracking-widest text-accent-light">Scholarly Output</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight mb-4">
        Publications & Science
      </h1>
      <p class="text-base text-text-muted max-w-2xl leading-relaxed">
        Peer-reviewed papers, graduate theses, and technical algorithms spanning forest LiDAR, space instrumentation jitter correction, and optical sensor calibration.
      </p>

      <div class="mt-6 flex flex-wrap gap-4 items-center text-xs font-mono">
        <a 
          href="https://scholar.google.com/citations?user=pL1DI_AAAAAJ&hl=en" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-accent hover:text-accent-light px-3 py-1.5 rounded-lg bg-forest-900 border border-border transition-all"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/>
          </svg>
          <span>Google Scholar Profile</span>
        </a>
        <span class="text-text-dim">&bull;</span>
        <span class="text-text-muted">Senior Scientist at Spectral Sciences, Inc.</span>
      </div>
    </div>

    <!-- Topic Filter Bar -->
    <div class="mb-10 p-2 sm:p-2.5 rounded-2xl bg-surface/80 border border-border flex flex-wrap items-center justify-between gap-3 shadow-sm">
      <div class="flex flex-wrap items-center gap-1.5 sm:gap-2" id="filter-pills-container">
        <button
          type="button"
          class="topic-filter-btn active px-3.5 py-1.5 rounded-xl text-xs font-mono transition-all cursor-pointer flex items-center gap-1.5 bg-forest-800 text-white border border-accent/50 shadow-sm"
          data-topic="all"
        >
          <span>All</span>
          <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-accent/20 text-accent font-semibold">{publications.length}</span>
        </button>

        <button
          type="button"
          class="topic-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-mono transition-all cursor-pointer flex items-center gap-1.5 text-text-muted hover:text-white hover:bg-forest-900/60 border border-transparent"
          data-topic="Forestry"
        >
          <span>Forestry</span>
          <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-surface text-text-dim font-semibold">{forestryCount}</span>
        </button>

        <button
          type="button"
          class="topic-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-mono transition-all cursor-pointer flex items-center gap-1.5 text-text-muted hover:text-white hover:bg-forest-900/60 border border-transparent"
          data-topic="Remote Sensing"
        >
          <span>Remote Sensing</span>
          <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-surface text-text-dim font-semibold">{remoteSensingCount}</span>
        </button>

        <button
          type="button"
          class="topic-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-mono transition-all cursor-pointer flex items-center gap-1.5 text-text-muted hover:text-white hover:bg-forest-900/60 border border-transparent"
          data-topic="Astronomy"
        >
          <span>Astronomy</span>
          <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-surface text-text-dim font-semibold">{astronomyCount}</span>
        </button>

        <button
          type="button"
          class="topic-filter-btn px-3.5 py-1.5 rounded-xl text-xs font-mono transition-all cursor-pointer flex items-center gap-1.5 text-text-muted hover:text-white hover:bg-forest-900/60 border border-transparent"
          data-topic="Academic"
        >
          <span>Academic</span>
          <span class="px-1.5 py-0.2 rounded-full text-[10px] bg-surface text-text-dim font-semibold">{academicCount}</span>
        </button>
      </div>

      <div class="text-xs font-mono text-text-dim px-2 hidden sm:block">
        <span id="results-count" class="text-white font-semibold">{publications.length}</span> publications shown
      </div>
    </div>

    <!-- Chronological Publications List -->
    <div class="space-y-8" id="publications-list">
      {publications.map((pub) => (
        <article 
          class="publication-card p-6 sm:p-8 bg-surface rounded-2xl border border-border hover:border-accent/40 transition-all duration-300 shadow-sm"
          id={pub.id}
          data-topics={pub.topics.join(",")}
        >
          <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="text-[11px] font-mono px-2.5 py-0.5 rounded bg-forest-900 text-accent border border-border">
                {pub.categoryLabel}
              </span>
              <span class={`text-[11px] font-mono px-2.5 py-0.5 rounded border ${pub.badgeColor}`}>
                {pub.typeBadge}
              </span>
              {pub.topics.map((t) => (
                <span class="text-[10px] font-mono px-2 py-0.2 rounded bg-surface/80 text-text-dim border border-border/60">
                  {t}
                </span>
              ))}
            </div>
            <span class="text-xs font-mono text-text-dim font-bold">
              {pub.year}
            </span>
          </div>

          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight mb-2 leading-snug">
            {pub.title}
          </h2>

          <p class="text-xs font-mono text-text-muted mb-4">
            {pub.authors} &bull; <span class="italic text-text-main">{pub.venue}</span>
          </p>

          <!-- Plain-Language SciComm Takeaway Box -->
          <div class="my-5 p-4 rounded-xl bg-forest-950/70 border-l-2 border-accent text-xs leading-relaxed text-text-muted">
            <p>{pub.takeaway}</p>
          </div>

          <!-- Action Buttons: DOI, Code/Showcase, BibTeX -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            {pub.doi && (
              <a 
                href={pub.doi} 
                target="_blank" 
                rel="noopener noreferrer"
                class="px-3 py-1.5 bg-forest-800 hover:bg-forest-750 text-white rounded-lg text-xs font-mono border border-border hover:border-accent/50 transition-all inline-flex items-center gap-1.5"
              >
                <span>{pub.typeBadge.includes("Thesis") || pub.typeBadge.includes("Dissertation") ? "Read Repository &rarr;" : "Read Paper / DOI &rarr;"}</span>
              </a>
            )}

            {pub.codeLink && (
              <a 
                href={pub.codeLink} 
                target={pub.codeLink.startsWith('http') ? "_blank" : "_self"} 
                rel={pub.codeLink.startsWith('http') ? "noopener noreferrer" : undefined}
                class="px-3 py-1.5 bg-forest-900 hover:bg-forest-800 text-accent-light rounded-lg text-xs font-mono border border-border hover:border-accent/50 transition-all inline-flex items-center gap-1.5"
              >
                <span set:html={pub.codeLabel || "Pipeline Code &rarr;"} />
              </a>
            )}

            <button 
              type="button"
              class="bibtex-btn px-3 py-1.5 bg-surface hover:bg-forest-850 text-text-muted hover:text-white rounded-lg text-xs font-mono border border-border transition-all cursor-pointer"
              data-bibtex={pub.bibtex}
            >
              Copy BibTeX
            </button>
          </div>
        </article>
      ))}
    </div>

  </div>

  <script>
    // Copy BibTeX handler
    document.querySelectorAll('.bibtex-btn').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const bibtex = target.getAttribute('data-bibtex');
        if (bibtex) {
          await navigator.clipboard.writeText(bibtex);
          const originalText = target.innerText;
          target.innerText = 'Copied!';
          target.classList.add('text-accent');
          setTimeout(() => {
            target.innerText = originalText;
            target.classList.remove('text-accent');
          }, 2000);
        }
      });
    });

    // Topic Filter Pills handler
    const filterButtons = document.querySelectorAll('.topic-filter-btn');
    const articles = document.querySelectorAll('.publication-card');
    const resultsCountEl = document.getElementById('results-count');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const topic = btn.getAttribute('data-topic');
        
        // Reset all buttons to inactive
        filterButtons.forEach(b => {
          b.classList.remove('bg-forest-800', 'text-white', 'border-accent/50', 'shadow-sm', 'active');
          b.classList.add('text-text-muted', 'border-transparent');
          const badge = b.querySelector('span:last-child');
          if (badge) {
            badge.classList.remove('bg-accent/20', 'text-accent');
            badge.classList.add('bg-surface', 'text-text-dim');
          }
        });

        // Set clicked button to active
        btn.classList.add('bg-forest-800', 'text-white', 'border-accent/50', 'shadow-sm', 'active');
        btn.classList.remove('text-text-muted', 'border-transparent');
        const activeBadge = btn.querySelector('span:last-child');
        if (activeBadge) {
          activeBadge.classList.add('bg-accent/20', 'text-accent');
          activeBadge.classList.remove('bg-surface', 'text-text-dim');
        }

        // Filter articles
        let visibleCount = 0;
        articles.forEach(art => {
          const artTopics = art.getAttribute('data-topics')?.split(',') || [];
          if (topic === 'all' || artTopics.includes(topic!)) {
            (art as HTMLElement).style.display = 'block';
            visibleCount++;
          } else {
            (art as HTMLElement).style.display = 'none';
          }
        });

        if (resultsCountEl) {
          resultsCountEl.textContent = String(visibleCount);
        }
      });
    });
  </script>
</Layout>
