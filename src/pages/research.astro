---
import Layout from "../layouts/Layout.astro";

type Topic = "Forestry" | "Remote Sensing" | "Astronomy" | "Academic";

interface Publication {
  id: string;
  title: string;
  authors: string;
  venue: string;
  year: number;
  categoryLabel: string;
  typeBadge: "In Preparation" | "Peer-Reviewed Journal" | "Conference Proceeding" | "Ph.D. Dissertation" | "Master's Thesis";
  badgeColor: string;
  topics: Topic[];
  takeaway: string;
  doi?: string;
  bibtex: string;
  codeLink?: string;
  codeLabel?: string;
}

const publications: Publication[] = [
  // 2026: Forthcoming / In Preparation
  {
    id: "gelbord-unjitr-pasp-2026",
    title: "Blind Sub-Pixel Photon-Event Jitter Restoration and Astrometric Alignment for Space Observatories: UNJITR Algorithm, Spacecraft Dynamics, and Swift UVOT Archive Recovery",
    authors: "Jonathan Gelbord, Cory G. Garms, et al.",
    venue: "Target: Publications of the Astronomical Society of the Pacific (PASP)",
    year: 2026,
    categoryLabel: "Space Instrumentation & Astrophysics",
    typeBadge: "In Preparation",
    badgeColor: "bg-cyan-950/80 text-cyan-300 border-cyan-500/40",
