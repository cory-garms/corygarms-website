---
const { title, lang } = Astro.props;
---

<div class="my-6 rounded-lg overflow-hidden border border-border shadow-lg group">
  {title && (
    <div class="bg-surface px-4 py-2 border-b border-border flex justify-between items-center text-xs font-mono text-text-muted">
      <span>{title}</span>
      {lang && <span class="uppercase text-accent-light">{lang}</span>}
    </div>
  )}
  <pre class="p-4 bg-forest-950 overflow-x-auto text-[0.85rem] font-mono relative leading-relaxed whitespace-pre text-emerald-100/90"><code><slot /></code></pre>
</div>
