---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	image?: string;
	article?: boolean;
	publishDate?: Date;
}

const { 
	title, 
	description = "Senior Scientist at Spectral Sciences, Inc. specializing in Remote Sensing, Lidar, and 3D Computer Vision.",
	image = "/images/profile.jpg",
	article = false,
	publishDate
} = Astro.props;

// Prevent duplicate names in document title
const siteName = "Cory Glenn Garms, Ph.D.";
const pageTitle = title.includes("Cory") ? title : `${title} | ${siteName}`;

// Absolute canonical URL and OpenGraph image
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://corygarms.com");
const ogImageURL = image.startsWith("http") ? image : new URL(image, canonicalURL).href;

// Active route detection for desktop and mobile navigation
const currentPath = Astro.url.pathname;
const isResearch = currentPath.startsWith('/research');
const isProjects = currentPath.startsWith('/cutmap') || currentPath.startsWith('/unjitr') || currentPath.startsWith('/astro-jitter') || currentPath.startsWith('/uvot-jitter');
const isCv = currentPath.startsWith('/cv');
const isNotes = currentPath.startsWith('/notes');
const isLibrary = currentPath.startsWith('/reading-list');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="canonical" href={canonicalURL.href} />
        
        <!-- OpenGraph Meta Tags for Social Media & Link Previews -->
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={article ? "article" : "website"} />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:site_name" content="Cory Glenn Garms, Ph.D." />
        {article && publishDate && (
          <meta property="article:published_time" content={publishDate.toISOString()} />
        )}
        {article && (
          <meta property="article:author" content="Cory Glenn Garms, Ph.D." />
        )}

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:site" content="@cory_garms" />
        <meta name="twitter:creator" content="@cory_garms" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageURL} />

		<title>{pageTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	</head>
	<body class="min-h-screen flex flex-col antialiased bg-background text-text-main selection:bg-accent/30 selection:text-white">
		<header class="w-full border-b border-border bg-surface/90 backdrop-blur-md sticky top-0 z-50 transition-colors">
			<div class="max-w-7xl mx-auto px-6 py-3.5 flex justify-between items-center">
				<a href="/" class="group flex items-center gap-2.5 text-base font-bold tracking-tight text-white hover:text-accent transition-colors">
					<span class="relative flex h-2.5 w-2.5">
						<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
						<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-accent"></span>
					</span>
					<span>Cory Glenn Garms</span>
				</a>

				<!-- Desktop Navigation with Active Indicators -->
				<nav id="desktop-nav" class="hidden md:flex items-center gap-6 text-xs font-mono tracking-wider">
					<a 
						href="/#about" 
						data-nav="about"
						class="nav-link group relative py-1 transition-colors text-text-muted hover:text-white"
					>
						<span>ABOUT</span>
						<span class="nav-indicator absolute -bottom-[15px] inset-x-0 h-[2px] bg-accent rounded-full shadow-[0_0_8px_rgba(16,185,129,0.8)] transition-all duration-200 opacity-0 scale-x-0 group-hover:opacity-40 group-hover:scale-x-75 pointer-events-none"></span>
					</a>
					<a 
						href="/research" 
						data-nav="research"
						class={`nav-link group relative py-1 transition-colors ${isResearch ? 'text-accent font-bold' : 'text-text-muted hover:text-white'}`}
					>
						<span>RESEARCH</span>
						<span class={`nav-indicator absolute -bottom-[15px] inset-x-0 h-[2px] bg-accent rounded-full shadow-[0_0_8px_rgba(16,185,129,0.8)] transition-all duration-200 pointer-events-none ${isResearch ? 'opacity-100 scale-x-100' : 'opacity-0 scale-x-0 group-hover:opacity-40 group-hover:scale-x-75'}`}></span>
					</a>
					<a 
						href="/#portfolio" 
						data-nav="portfolio"
						class={`nav-link group relative py-1 transition-colors ${isProjects ? 'text-accent font-bold' : 'text-text-muted hover:text-white'}`}
					>
						<span>PROJECTS</span>
						<span class={`nav-indicator absolute -bottom-[15px] inset-x-0 h-[2px] bg-accent rounded-full shadow-[0_0_8px_rgba(16,185,129,0.8)] transition-all duration-200 pointer-events-none ${isProjects ? 'opacity-100 scale-x-100' : 'opacity-0 scale-x-0 group-hover:opacity-40 group-hover:scale-x-75'}`}></span>
					</a>
					<a 
						href="/cv" 
						data-nav="cv"
						class={`nav-link group relative py-1 transition-colors ${isCv ? 'text-accent font-bold' : 'text-text-muted hover:text-white'}`}
					>
						<span>CV</span>
						<span class={`nav-indicator absolute -bottom-[15px] inset-x-0 h-[2px] bg-accent rounded-full shadow-[0_0_8px_rgba(16,185,129,0.8)] transition-all duration-200 pointer-events-none ${isCv ? 'opacity-100 scale-x-100' : 'opacity-0 scale-x-0 group-hover:opacity-40 group-hover:scale-x-75'}`}></span>
					</a>
					<a 
						href="/notes" 
						data-nav="notes"
						class={`nav-link group relative py-1 transition-colors ${isNotes ? 'text-accent font-bold' : 'text-text-muted hover:text-white'}`}
					>
						<span>NOTES</span>
						<span class={`nav-indicator absolute -bottom-[15px] inset-x-0 h-[2px] bg-accent rounded-full shadow-[0_0_8px_rgba(16,185,129,0.8)] transition-all duration-200 pointer-events-none ${isNotes ? 'opacity-100 scale-x-100' : 'opacity-0 scale-x-0 group-hover:opacity-40 group-hover:scale-x-75'}`}></span>
					</a>
					<a 
						href="/reading-list" 
						data-nav="library"
						class={`nav-link group relative py-1 transition-colors ${isLibrary ? 'text-accent font-bold' : 'text-text-muted hover:text-white'}`}
					>
						<span>BOOKSHELF</span>
						<span class={`nav-indicator absolute -bottom-[15px] inset-x-0 h-[2px] bg-accent rounded-full shadow-[0_0_8px_rgba(16,185,129,0.8)] transition-all duration-200 pointer-events-none ${isLibrary ? 'opacity-100 scale-x-100' : 'opacity-0 scale-x-0 group-hover:opacity-40 group-hover:scale-x-75'}`}></span>
					</a>
					<a 
						href="/#contact" 
						data-nav="contact"
						class="px-3.5 py-1.5 rounded bg-forest-800 hover:bg-forest-700 text-accent hover:text-white border border-border hover:border-accent/50 transition-all font-mono"
					>
						CONTACT
					</a>
				</nav>

				<!-- Mobile Hamburger Button -->
				<button 
					type="button" 
					id="mobile-menu-btn"
					class="md:hidden p-2 rounded-lg text-text-muted hover:text-white hover:bg-forest-900 border border-transparent hover:border-border transition-all cursor-pointer"
					aria-label="Toggle Navigation Menu"
					aria-expanded="false"
				>
					<svg id="hamburger-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
					<svg id="close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>

			<!-- Mobile Navigation Drawer -->
			<div class="max-w-7xl mx-auto px-6">
				<nav id="mobile-nav-tray" class="hidden md:hidden pt-2 pb-4 border-t border-border mt-1 space-y-1 text-xs font-mono">
					<a 
						href="/#about" 
						data-mobile-nav="about" 
						class="mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg text-text-muted hover:text-white hover:bg-forest-900 border border-transparent transition-all"
					>
						<span>ABOUT</span>
						<span class="mobile-indicator w-1.5 h-1.5 rounded-full bg-accent animate-pulse hidden"></span>
					</a>
					<a 
						href="/research" 
						data-mobile-nav="research" 
						class={`mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg transition-all ${isResearch ? 'text-accent font-semibold bg-forest-900/90 border border-accent/40 shadow-sm' : 'text-text-muted hover:text-white hover:bg-forest-900 border border-transparent'}`}
					>
						<span>RESEARCH</span>
						<span class={`mobile-indicator w-1.5 h-1.5 rounded-full bg-accent animate-pulse ${isResearch ? '' : 'hidden'}`}></span>
					</a>
					<a 
						href="/#portfolio" 
						data-mobile-nav="portfolio" 
						class={`mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg transition-all ${isProjects ? 'text-accent font-semibold bg-forest-900/90 border border-accent/40 shadow-sm' : 'text-text-muted hover:text-white hover:bg-forest-900 border border-transparent'}`}
					>
						<span>PROJECTS</span>
						<span class={`mobile-indicator w-1.5 h-1.5 rounded-full bg-accent animate-pulse ${isProjects ? '' : 'hidden'}`}></span>
					</a>
					<a 
						href="/cv" 
						data-mobile-nav="cv" 
						class={`mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg transition-all ${isCv ? 'text-accent font-semibold bg-forest-900/90 border border-accent/40 shadow-sm' : 'text-text-muted hover:text-white hover:bg-forest-900 border border-transparent'}`}
					>
						<span>CV</span>
						<span class={`mobile-indicator w-1.5 h-1.5 rounded-full bg-accent animate-pulse ${isCv ? '' : 'hidden'}`}></span>
					</a>
					<a 
						href="/notes" 
						data-mobile-nav="notes" 
						class={`mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg transition-all ${isNotes ? 'text-accent font-semibold bg-forest-900/90 border border-accent/40 shadow-sm' : 'text-text-muted hover:text-white hover:bg-forest-900 border border-transparent'}`}
					>
						<span>NOTES</span>
						<span class={`mobile-indicator w-1.5 h-1.5 rounded-full bg-accent animate-pulse ${isNotes ? '' : 'hidden'}`}></span>
					</a>
					<a 
						href="/reading-list" 
						data-mobile-nav="library" 
						class={`mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg transition-all ${isLibrary ? 'text-accent font-semibold bg-forest-900/90 border border-accent/40 shadow-sm' : 'text-text-muted hover:text-white hover:bg-forest-900 border border-transparent'}`}
					>
						<span>BOOKSHELF</span>
						<span class={`mobile-indicator w-1.5 h-1.5 rounded-full bg-accent animate-pulse ${isLibrary ? '' : 'hidden'}`}></span>
					</a>
					<a 
						href="/#contact" 
						data-mobile-nav="contact" 
						class="mobile-nav-link block px-3 py-2 rounded-lg text-accent font-semibold bg-forest-900/60 border border-border mt-2"
					>
						<span>CONTACT &rarr;</span>
					</a>
				</nav>
			</div>
		</header>

		<main class="flex-grow">
			<slot />
		</main>

		<footer class="w-full border-t border-border bg-surface mt-24">
			<div class="max-w-7xl mx-auto px-6 py-12 flex flex-col md:flex-row justify-between items-center gap-6">
				<div class="flex flex-col gap-1 text-center md:text-left">
					<div class="text-text-muted text-xs font-mono">
						<span>&copy; {new Date().getFullYear()} Cory Glenn Garms, Ph.D. All rights reserved.</span>
					</div>
					<div class="text-[11px] font-mono text-text-dim">
						Burlington, MA &bull; Spectral Sciences, Inc. &bull; Remote Sensing &bull; Lidar &bull; Computer Vision
					</div>
				</div>
				<div class="flex gap-6 flex-wrap justify-center text-xs font-mono">
					<a href="https://scholar.google.com/citations?user=pL1DI_AAAAAJ&hl=en" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-accent transition-colors">Google Scholar</a>
					<a href="https://github.com/cory-garms" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-accent transition-colors">GitHub</a>
					<a href="https://www.linkedin.com/in/cory-g-garms-5a29a7139/" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-accent transition-colors">LinkedIn</a>
					<a href="https://x.com/cory_garms" target="_blank" rel="noopener noreferrer" class="text-text-muted hover:text-accent transition-colors">𝕏 (Twitter)</a>
				</div>
			</div>
		</footer>

		<script>
			// Performance-optimized Intersection Observer for scroll-reveal micro-animations
			document.addEventListener('DOMContentLoaded', () => {
				const observerOptions = {
					root: null,
					rootMargin: '0px',
					threshold: 0.12 // Trigger when 12% of the element is visible
				};

				const observer = new IntersectionObserver((entries, observer) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('reveal-visible');
							observer.unobserve(entry.target); // Only animate once
						}
					});
				}, observerOptions);

				document.querySelectorAll('.reveal').forEach((element) => {
					observer.observe(element);
				});

				// Mobile navigation drawer toggle
				const menuBtn = document.getElementById('mobile-menu-btn');
				const navTray = document.getElementById('mobile-nav-tray');
				const hamburgerIcon = document.getElementById('hamburger-icon');
				const closeIcon = document.getElementById('close-icon');

				if (menuBtn && navTray) {
					menuBtn.addEventListener('click', () => {
						const isHidden = navTray.classList.contains('hidden');
						navTray.classList.toggle('hidden', !isHidden);
						hamburgerIcon?.classList.toggle('hidden', isHidden);
						closeIcon?.classList.toggle('hidden', !isHidden);
						menuBtn.setAttribute('aria-expanded', String(isHidden));
					});

					// Auto-close menu when tapping any mobile link
					document.querySelectorAll('.mobile-nav-link').forEach(link => {
						link.addEventListener('click', () => {
							navTray.classList.add('hidden');
							hamburgerIcon?.classList.remove('hidden');
							closeIcon?.classList.add('hidden');
							menuBtn.setAttribute('aria-expanded', 'false');
						});
					});
				}

				// Homepage Scroll-Spy for In-Page Anchor Links (#about, #portfolio)
				if (window.location.pathname === '/' || window.location.pathname === '') {
					const spySections = [
						{ id: 'portfolio', key: 'portfolio' },
						{ id: 'about', key: 'about' }
					];

					const navItems: Record<string, {
						desktop: HTMLElement | null;
						desktopIndicator: HTMLElement | null;
						mobile: HTMLElement | null;
						mobileIndicator: HTMLElement | null;
					}> = {
						about: {
							desktop: document.querySelector('#desktop-nav [data-nav="about"]'),
							desktopIndicator: document.querySelector('#desktop-nav [data-nav="about"] .nav-indicator'),
							mobile: document.querySelector('#mobile-nav-tray [data-mobile-nav="about"]'),
							mobileIndicator: document.querySelector('#mobile-nav-tray [data-mobile-nav="about"] .mobile-indicator')
						},
						portfolio: {
							desktop: document.querySelector('#desktop-nav [data-nav="portfolio"]'),
							desktopIndicator: document.querySelector('#desktop-nav [data-nav="portfolio"] .nav-indicator'),
							mobile: document.querySelector('#mobile-nav-tray [data-mobile-nav="portfolio"]'),
							mobileIndicator: document.querySelector('#mobile-nav-tray [data-mobile-nav="portfolio"] .mobile-indicator')
						}
					};

					let activeSection: string | null = null;

					function updateScrollSpy() {
						const scrollPos = window.scrollY;
						let current: string | null = null;

						if (scrollPos > 120) {
							for (const s of spySections) {
								const el = document.getElementById(s.id);
								if (el) {
									const rect = el.getBoundingClientRect();
									// Target section is currently in active viewing band
									if (rect.top <= 240 && rect.bottom >= 120) {
										current = s.key;
										break;
									}
								}
							}
						}

						if (current !== activeSection) {
							activeSection = current;
							Object.entries(navItems).forEach(([key, item]) => {
								const isActive = key === activeSection;
								if (item.desktop) {
									if (isActive) {
										item.desktop.classList.add('text-accent', 'font-bold');
										item.desktop.classList.remove('text-text-muted');
									} else {
										item.desktop.classList.remove('text-accent', 'font-bold');
										item.desktop.classList.add('text-text-muted');
									}
								}
								if (item.desktopIndicator) {
									if (isActive) {
										item.desktopIndicator.classList.remove('opacity-0', 'scale-x-0');
										item.desktopIndicator.classList.add('opacity-100', 'scale-x-100');
									} else {
										item.desktopIndicator.classList.add('opacity-0', 'scale-x-0');
										item.desktopIndicator.classList.remove('opacity-100', 'scale-x-100');
									}
								}
								if (item.mobile) {
									if (isActive) {
										item.mobile.classList.add('text-accent', 'font-semibold', 'bg-forest-900/90', 'border-accent/40', 'shadow-sm');
										item.mobile.classList.remove('text-text-muted', 'border-transparent');
									} else {
										item.mobile.classList.remove('text-accent', 'font-semibold', 'bg-forest-900/90', 'border-accent/40', 'shadow-sm');
										item.mobile.classList.add('text-text-muted', 'border-transparent');
									}
								}
								if (item.mobileIndicator) {
									if (isActive) {
										item.mobileIndicator.classList.remove('hidden');
									} else {
										item.mobileIndicator.classList.add('hidden');
									}
								}
							});
						}
					}

					let ticking = false;
					window.addEventListener('scroll', () => {
						if (!ticking) {
							window.requestAnimationFrame(() => {
								updateScrollSpy();
								ticking = false;
							});
							ticking = true;
						}
					}, { passive: true });

					// Initial evaluation
					updateScrollSpy();
				}
			});
		</script>
	</body>
</html>
